<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Embed Builder | <%= guild.name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <div class="brand">🎁 LoofaryBot</div>
    <a class="btn secondary" href="/dashboard/<%= guild.id %>">← <%= guild.name %></a>
  </nav>
  <div class="container" style="display:grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
    <div>
      <h1>Embed Builder</h1>
      <p class="muted">Type <code>@</code>, <code>#</code>, or <code>:</code> in any text field for live autocomplete of members, channels, and emoji.</p>

      <label for="channel">Send To Channel</label>
      <select id="channel">
        <option value="">— Select a channel —</option>
        <% channels.forEach(c => { %>
          <option value="<%= c.id %>">#<%= c.name %></option>
        <% }) %>
      </select>

      <label for="title">Title</label>
      <div class="autocomplete-wrapper">
        <input id="title" maxlength="256" placeholder="Embed title">
        <div class="autocomplete-dropdown" id="ac-title"></div>
      </div>

      <label for="description">Description</label>
      <div class="autocomplete-wrapper">
        <textarea id="description" maxlength="4096" placeholder="Embed description... supports **markdown**"></textarea>
        <div class="autocomplete-dropdown" id="ac-description"></div>
      </div>

      <label for="color">Color</label>
      <input id="color" type="color" value="#5865f2">

      <label for="imageUrl">Image URL</label>
      <input id="imageUrl" placeholder="https://...">

      <label for="thumbnailUrl">Thumbnail URL</label>
      <input id="thumbnailUrl" placeholder="https://...">

      <label for="footer">Footer</label>
      <div class="autocomplete-wrapper">
        <input id="footer" maxlength="2048" placeholder="Footer text">
        <div class="autocomplete-dropdown" id="ac-footer"></div>
      </div>

      <h3 style="margin-top:1.5rem;">Fields</h3>
      <div id="fieldRows"></div>
      <button class="btn secondary" type="button" onclick="addFieldRow()">+ Add Field</button>

      <br><br>
      <button class="btn" onclick="sendEmbed()">🚀 Send Embed</button>
    </div>

    <div>
      <h2>Live Preview</h2>
      <div class="discord-embed-preview" id="preview">
        <div class="title" id="pTitle"></div>
        <div class="desc" id="pDesc"></div>
        <div id="pFields"></div>
        <img id="pImage" style="display:none;">
        <div class="muted" id="pFooter" style="margin-top:0.5rem; font-size:0.8rem;"></div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    const guildId = '<%= guild.id %>';
    let mentionable = { users: [], channels: [], roles: [], emojis: [] };
    let fieldCounter = 0;

    // ---------- Load real guild data for autocomplete ----------
    async function loadMentionable() {
      try {
        const res = await fetch(`/api/guilds/${guildId}/mentionable`);
        if (res.ok) mentionable = await res.json();
      } catch (e) {
        console.error('Failed to load autocomplete data', e);
      }
    }

    // ---------- Autocomplete engine ----------
    // Finds the trigger (@, #, :) immediately before the cursor, if any, and the partial
    // query typed after it, so we know what to search and what to replace on selection.
    function findTrigger(text, cursorPos) {
      const upToCursor = text.slice(0, cursorPos);
      const match = upToCursor.match(/(?:^|\s)([@#:])([a-zA-Z0-9_]*)$/);
      if (!match) return null;
      return { trigger: match[1], query: match[2].toLowerCase(), start: cursorPos - match[2].length - 1 };
    }

    function getMatches(trigger, query) {
      if (trigger === '@') {
        return mentionable.users
          .filter((u) => u.name.toLowerCase().includes(query) || u.username.toLowerCase().includes(query))
          .slice(0, 8)
          .map((u) => ({ label: u.name, sublabel: `@${u.username}`, insert: `<@${u.id}>` }));
      }
      if (trigger === '#') {
        return mentionable.channels
          .filter((c) => c.name.toLowerCase().includes(query))
          .slice(0, 8)
          .map((c) => ({ label: `#${c.name}`, insert: `<#${c.id}>` }));
      }
      if (trigger === ':') {
        return mentionable.emojis
          .filter((e) => e.name.toLowerCase().includes(query))
          .slice(0, 8)
          .map((e) => ({ label: e.name, iconUrl: e.url, insert: `<${e.animated ? 'a' : ''}:${e.name}:${e.id}>` }));
      }
      return [];
    }

    function attachAutocomplete(inputEl, dropdownEl) {
      let currentMatches = [];
      let highlightedIndex = 0;

      function render() {
        if (currentMatches.length === 0) {
          dropdownEl.classList.remove('visible');
          dropdownEl.innerHTML = '';
          return;
        }
        dropdownEl.innerHTML = currentMatches
          .map(
            (m, i) => `
            <div class="autocomplete-item ${i === highlightedIndex ? 'highlighted' : ''}" data-index="${i}">
              ${m.iconUrl ? `<img src="${m.iconUrl}">` : ''}
              <span>${m.label}</span>
              ${m.sublabel ? `<span class="muted" style="font-size:0.8rem;">${m.sublabel}</span>` : ''}
            </div>`
          )
          .join('');
        dropdownEl.classList.add('visible');
        dropdownEl.querySelectorAll('.autocomplete-item').forEach((el) => {
          el.addEventListener('mousedown', (e) => {
            e.preventDefault();
            select(currentMatches[Number(el.dataset.index)]);
          });
        });
      }

      function select(match) {
        const text = inputEl.value;
        const cursorPos = inputEl.selectionStart;
        const trig = findTrigger(text, cursorPos);
        if (!trig) return;
        const before = text.slice(0, trig.start);
        const after = text.slice(cursorPos);
        inputEl.value = `${before}${match.insert} ${after}`;
        const newCursor = (before + match.insert + ' ').length;
        inputEl.setSelectionRange(newCursor, newCursor);
        currentMatches = [];
        render();
        updatePreview();
        inputEl.focus();
      }

      inputEl.addEventListener('input', () => {
        const trig = findTrigger(inputEl.value, inputEl.selectionStart);
        currentMatches = trig ? getMatches(trig.trigger, trig.query) : [];
        highlightedIndex = 0;
        render();
        updatePreview();
      });

      inputEl.addEventListener('keydown', (e) => {
        if (currentMatches.length === 0) return;
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          highlightedIndex = (highlightedIndex + 1) % currentMatches.length;
          render();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          highlightedIndex = (highlightedIndex - 1 + currentMatches.length) % currentMatches.length;
          render();
        } else if (e.key === 'Enter' || e.key === 'Tab') {
          e.preventDefault();
          select(currentMatches[highlightedIndex]);
        } else if (e.key === 'Escape') {
          currentMatches = [];
          render();
        }
      });

      inputEl.addEventListener('blur', () => setTimeout(() => { currentMatches = []; render(); }, 150));
    }

    // ---------- Rendering raw embed text the way Discord would show it ----------
    function renderMentionText(raw) {
      if (!raw) return '';
      let html = raw
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      // Restore our own encoded mention/emoji tokens (originally <...>) so we can style them.
      html = html
        .replace(/&lt;@(\d+)&gt;/g, (_, id) => {
          const u = mentionable.users.find((x) => x.id === id);
          return `<span class="mention-pill">@${u ? u.name : 'unknown-user'}</span>`;
        })
        .replace(/&lt;#(\d+)&gt;/g, (_, id) => {
          const c = mentionable.channels.find((x) => x.id === id);
          return `<span class="channel-pill">#${c ? c.name : 'unknown-channel'}</span>`;
        })
        .replace(/&lt;a?:(\w+):(\d+)&gt;/g, (_, name, id) => {
          const e = mentionable.emojis.find((x) => x.id === id);
          return e ? `<img class="custom-emoji" src="${e.url}" alt=":${name}:">` : `:${name}:`;
        });

      return html;
    }

    function updatePreview() {
      const title = document.getElementById('title').value;
      const desc = document.getElementById('description').value;
      const color = document.getElementById('color').value;
      const footer = document.getElementById('footer').value;
      const image = document.getElementById('imageUrl').value;

      document.getElementById('preview').style.borderLeftColor = color;
      document.getElementById('pTitle').innerHTML = renderMentionText(title);
      document.getElementById('pDesc').innerHTML = renderMentionText(desc);
      document.getElementById('pFooter').innerHTML = renderMentionText(footer);

      const img = document.getElementById('pImage');
      if (image) { img.src = image; img.style.display = 'block'; } else { img.style.display = 'none'; }

      const fieldsHtml = [...document.querySelectorAll('.field-entry')]
        .map((row) => {
          const name = row.querySelector('.f-name').value;
          const value = row.querySelector('.f-value').value;
          if (!name && !value) return '';
          return `<div style="margin-top:0.5rem;"><strong>${renderMentionText(name)}</strong><br>${renderMentionText(value)}</div>`;
        })
        .join('');
      document.getElementById('pFields').innerHTML = fieldsHtml;
    }

    function addFieldRow(name = '', value = '', inline = false) {
      const id = fieldCounter++;
      const container = document.getElementById('fieldRows');
      const row = document.createElement('div');
      row.className = 'field-row field-entry';
      row.innerHTML = `
        <div class="autocomplete-wrapper" style="flex:1;">
          <input class="f-name" placeholder="Field name" value="${name}">
          <div class="autocomplete-dropdown" id="ac-fname-${id}"></div>
        </div>
        <div class="autocomplete-wrapper" style="flex:1;">
          <input class="f-value" placeholder="Field value" value="${value}">
          <div class="autocomplete-dropdown" id="ac-fvalue-${id}"></div>
        </div>
        <label style="display:flex; align-items:center; gap:0.3rem; flex:0 0 auto;">
          <input type="checkbox" class="f-inline" style="width:auto;" ${inline ? 'checked' : ''}> Inline
        </label>
        <button class="btn secondary" type="button" onclick="this.parentElement.remove(); updatePreview();">✕</button>
      `;
      container.appendChild(row);
      attachAutocomplete(row.querySelector('.f-name'), row.querySelector(`#ac-fname-${id}`));
      attachAutocomplete(row.querySelector('.f-value'), row.querySelector(`#ac-fvalue-${id}`));
      row.querySelector('.f-inline').addEventListener('change', updatePreview);
    }

    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.style.display = 'block';
      setTimeout(() => (t.style.display = 'none'), 3000);
    }

    async function sendEmbed() {
      const channelId = document.getElementById('channel').value;
      if (!channelId) return showToast('❌ Select a channel first.');

      const fields = [...document.querySelectorAll('.field-entry')].map((row) => ({
        name: row.querySelector('.f-name').value,
        value: row.querySelector('.f-value').value,
        inline: row.querySelector('.f-inline').checked
      }));

      const payload = {
        channelId,
        title: document.getElementById('title').value,
        description: document.getElementById('description').value,
        color: document.getElementById('color').value,
        footer: document.getElementById('footer').value,
        imageUrl: document.getElementById('imageUrl').value,
        thumbnailUrl: document.getElementById('thumbnailUrl').value,
        fields
      };

      const res = await fetch(`/dashboard/${guildId}/embed/send`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json().catch(() => ({}));
      showToast(res.ok ? '✅ Embed sent!' : `❌ ${data.error || 'Failed to send embed.'}`);
    }

    ['title', 'description', 'color', 'footer', 'imageUrl'].forEach((id) => {
      const el = document.getElementById(id);
      el.addEventListener('input', updatePreview);
      if (['title', 'description', 'footer'].includes(id)) {
        attachAutocomplete(el, document.getElementById(`ac-${id}`));
      }
    });

    loadMentionable().then(updatePreview);
  </script>
</body>
</html>
