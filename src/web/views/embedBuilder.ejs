<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Embed Builder | <%= guild.name %></title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body class="site">
  <%- include('partials/site-bar') %>

  <main class="site-main eb-main">
    <div class="page-heading">
      <div>
        <a class="muted" href="/dashboard/<%= guild.id %>" style="font-size:0.85rem;">← <%= guild.name %></a>
        <h1 style="font-size:1.45rem; margin-top:0.2rem;">Embed Builder</h1>
        <p class="muted" style="margin:0.2rem 0 0; font-size:0.86rem;">Build messages with up to 10 embeds. Saves use Discord's JSON format, so you can import from and export to Discohook. Type <code>@</code>, <code>#</code> or <code>:</code> for autocomplete.</p>
      </div>
      <div class="eb-top-actions">
        <button class="btn secondary" type="button" onclick="openImport()">📥 Import</button>
        <div class="menu-wrap">
          <button class="btn secondary" type="button" onclick="toggleMenu('exportMenu')" aria-haspopup="true">📤 Export ▾</button>
          <div class="menu" id="exportMenu" role="menu">
            <button type="button" onclick="exportCurrent()">Download this message (.json)</button>
            <button type="button" onclick="copyJson()">Copy this message's JSON</button>
            <a href="/api/guilds/<%= guild.id %>/embed-templates/export" download>Download all saved templates</a>
          </div>
        </div>
        <button class="btn danger" type="button" onclick="clearAll()">🧹 Clear all</button>
      </div>
    </div>

    <div class="split eb-split">
      <div>
        <div class="card eb-card">
          <div class="eb-row">
            <label for="templateSelect">Saved templates</label>
            <div class="field-row" style="margin:0;">
              <select id="templateSelect"><option value="">— New / unsaved —</option></select>
              <button class="btn secondary small" type="button" onclick="loadSelectedTemplate()">Load</button>
              <button class="btn secondary small" type="button" onclick="deleteSelectedTemplate()">Delete</button>
            </div>
          </div>
          <div class="eb-row" style="display:flex; gap:0.5rem; flex-wrap:wrap;">
            <button class="btn small" type="button" onclick="saveTemplate(false)">💾 Save</button>
            <button class="btn secondary small" type="button" onclick="saveTemplate(true)">Save as new…</button>
            <span class="muted" id="draftStatus" style="font-size:0.78rem; align-self:center;"></span>
          </div>
        </div>

        <div class="card eb-card">
          <div class="radio-cards" style="margin-bottom:0.8rem;">
            <label class="radio-card"><input type="radio" name="sendMode" value="new" checked><span class="rc-body"><span class="rc-title">📨 Send a new message</span></span></label>
            <label class="radio-card"><input type="radio" name="sendMode" value="edit"><span class="rc-body"><span class="rc-title">✏️ Edit a bot message</span></span></label>
          </div>
          <div id="sendNewRow">
            <label for="channel">Send to channel</label>
            <select id="channel">
              <option value="">— Select a channel —</option>
              <% if (forums.length) { %><optgroup label="Text channels"><% } %>
              <% channels.forEach(c => { %><option value="<%= c.id %>">#<%= c.name %></option><% }) %>
              <% if (forums.length) { %></optgroup><optgroup label="Forums (creates a new post)">
              <% forums.forEach(f => { %><option value="<%= f.id %>" data-forum="1">💬 <%= f.name %></option><% }) %>
              </optgroup><% } %>
            </select>
            <div id="forumRow" style="display:none; margin-top:0.6rem;">
              <label for="postTitle">Post title</label>
              <input id="postTitle" maxlength="100" placeholder="What's this post about?" autocomplete="off">
              <div id="forumTagsWrap" style="margin-top:0.5rem;">
                <label>Tags <span class="muted" id="forumTagHint" style="font-weight:400;"></span></label>
                <div id="forumTags" style="display:flex; flex-wrap:wrap; gap:0.35rem;"></div>
              </div>
            </div>
            <script type="application/json" id="forumData"><%- JSON.stringify(forums).replace(/</g, '\\u003c') %></script>
          </div>
          <div id="sendEditRow" style="display:none;">
            <label for="editUrl">Message link</label>
            <div class="field-row" style="margin:0;">
              <input id="editUrl" placeholder="https://discord.com/channels/…" autocomplete="off">
              <button class="btn secondary small" type="button" onclick="loadFromLink('editUrl')">Load it</button>
            </div>
            <p class="muted" style="font-size:0.78rem; margin:0.4rem 0 0;">Right-click a message sent by LoofaryBot → Copy Message Link. Loading it copies its content into the editor.</p>
          </div>
          <details class="eb-details">
            <summary>Copy any message into the editor…</summary>
            <div class="field-row" style="margin-top:0.6rem;">
              <input id="copyUrl" placeholder="Any message link in this server" autocomplete="off">
              <button class="btn secondary small" type="button" onclick="loadFromLink('copyUrl')">Copy in</button>
            </div>
          </details>
        </div>

        <div class="card eb-card">
          <div class="eb-label-row"><label for="content" style="margin:0;">Message text</label><span class="counter" id="contentCount"></span></div>
          <textarea id="content" maxlength="2000" rows="3" placeholder="Text above the embeds. Mentions here are the only ones that actually ping."></textarea>
        </div>

        <div id="embeds"></div>
        <button class="btn secondary" type="button" id="addEmbedBtn" onclick="addEmbed()">+ Add embed</button>

        <div class="savebar eb-savebar">
          <span class="hint" id="totalHint"></span>
          <button class="btn secondary" type="button" onclick="useAsWelcome()">👋 Use as welcome message</button>
          <button class="btn" type="button" id="sendBtn" onclick="sendMessage()">🚀 Send</button>
        </div>
        <p class="muted" style="font-size:0.78rem;">Welcome messages use the text and the first embed (no fields) and support <code>{user}</code>, <code>{username}</code>, <code>{server}</code>, <code>{membercount}</code>, and <code>{avatar}</code> as the thumbnail. Shortcut: <kbd>Ctrl</kbd>+<kbd>S</kbd> saves the loaded template.</p>
      </div>

      <div class="sticky-preview">
        <div class="card" style="margin-bottom:0;">
          <h3 style="margin-top:0;">Live preview</h3>
          <div class="discord-chat eb-preview">
            <div class="discord-message-preview">
              <img class="discord-avatar" src="<%= bot.avatarUrl %>" alt="">
              <div class="discord-message-body">
                <div class="discord-message-header"><span class="discord-bot-name"><%= bot.name %></span><span class="discord-bot-badge">BOT</span><span class="discord-message-time">Today at 12:00 PM</span></div>
                <div class="desc md" id="pContent"></div>
                <div id="pEmbeds"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <dialog id="importDialog" class="eb-dialog">
    <form method="dialog" class="eb-dialog-inner" onsubmit="return false;">
      <h3 style="margin-top:0;">Import messages</h3>
      <p class="muted" style="font-size:0.84rem; margin-top:0;">Paste JSON from Discohook's JSON editor, a webhook payload, a single embed, an old Discohook share link (<code>…?data=</code>), or choose a file — including a Discohook backup export or a LoofaryBot template export.</p>
      <textarea id="importText" rows="8" placeholder='{"content": "Hello", "embeds": [{"title": "Rules", "color": 5793266}]}'></textarea>
      <div class="field-row" style="margin-top:0.6rem; align-items:center;">
        <input type="file" id="importFile" accept=".json,application/json">
        <button class="btn secondary small" type="button" onclick="parseImportInput()">Read</button>
      </div>
      <div id="importResults"></div>
      <div class="eb-dialog-actions">
        <button class="btn secondary" type="button" onclick="document.getElementById('importDialog').close()">Cancel</button>
        <label class="switch sm" style="margin-right:auto;" title="Replace templates that have the same name"><input type="checkbox" id="importOverwrite"><span class="track"></span><span style="font-weight:500; font-size:0.82rem;">Overwrite same names</span></label>
        <button class="btn secondary" type="button" id="importSaveBtn" onclick="saveImported()" disabled>Save as templates</button>
        <button class="btn" type="button" id="importOpenBtn" onclick="openImported()" disabled>Open in editor</button>
      </div>
    </form>
  </dialog>

  <div class="toast" id="toast"></div>

  <script src="/js/mentions.js"></script>
  <script src="/js/embed-json.js"></script>
  <script>
    window.EB_CONFIG = { guildId: '<%= guild.id %>', botAvatar: <%- JSON.stringify(bot.avatarUrl).replace(/</g, '\\u003c') %> };
  </script>
  <script src="/js/embed-builder.js"></script>
</body>
</html>
