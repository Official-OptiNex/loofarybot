<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FAQ | <%= guild.name %></title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body class="site">
  <%- include('partials/site-bar') %>

  <main class="site-main eb-main">
    <div class="page-heading">
      <div>
        <% if (guidesOnly) { %>
          <a class="muted" href="/dashboard/<%= guild.id %>/guides" style="font-size:0.85rem;">← Guides</a>
        <% } else { %>
          <a class="muted" href="/dashboard/<%= guild.id %>" style="font-size:0.85rem;">← <%= guild.name %></a>
        <% } %>
        <h1 style="font-size:1.45rem; margin-top:0.2rem;">FAQ</h1>
        <p class="muted" style="margin:0.2rem 0 0; font-size:0.86rem;">One message — text plus up to 10 embeds — posted by <code>/faq show</code>. Same editor as the Embed Builder: type <code>@</code>, <code>#</code> or <code>:</code> for autocomplete, or paste Discord / Discohook JSON.</p>
      </div>
      <div class="eb-top-actions">
        <button class="btn secondary" type="button" onclick="openImport()">📥 Import</button>
        <div class="menu-wrap">
          <button class="btn secondary" type="button" onclick="toggleMenu('exportMenu')" aria-haspopup="true">📤 Export ▾</button>
          <div class="menu" id="exportMenu" role="menu">
            <button type="button" onclick="exportCurrent()">Download this message (.json)</button>
            <button type="button" onclick="copyJson()">Copy this message's JSON</button>
          </div>
        </div>
      </div>
    </div>

    <div class="split eb-split">
      <div>
        <div class="card eb-card">
          <div class="eb-label-row"><label for="content" style="margin:0;">Message text</label><span class="counter" id="contentCount"></span></div>
          <textarea id="content" maxlength="2000" rows="3" placeholder="Optional text above the embeds. Mentions here are the only ones that actually ping."></textarea>
        </div>

        <div id="embeds"></div>
        <button class="btn secondary" type="button" id="addEmbedBtn" onclick="addEmbed()">+ Add embed</button>

        <div class="savebar eb-savebar">
          <span class="hint" id="totalHint"></span>
          <button class="btn" type="button" id="saveBtn" onclick="saveFaq()">💾 Save FAQ</button>
        </div>
        <p class="muted" style="font-size:0.78rem;">Saving stores the FAQ so <code>/faq show</code> posts it. To push it out now, pick a channel and post it below.</p>

        <div class="card eb-card">
          <label for="postChannel">Post to a channel now</label>
          <div class="field-row" style="margin:0;">
            <select id="postChannel">
              <option value="">— Select a channel —</option>
              <% channels.forEach(c => { %><option value="<%= c.id %>" <%= c.id === channelId ? 'selected' : '' %>>#<%= c.name %></option><% }) %>
            </select>
            <button class="btn secondary" type="button" id="postBtn" onclick="postFaq()">🚀 Post it</button>
          </div>
          <p class="muted" style="font-size:0.78rem; margin:0.4rem 0 0;">Posting also saves the FAQ, so the posted message and <code>/faq show</code> stay in sync.</p>
        </div>

        <details class="card eb-card eb-json" id="jsonPanel">
          <summary>📝 JSON editor <span class="muted" style="font-weight:400;">· edit the raw message (Discord / Discohook format)</span></summary>
          <p class="muted" style="font-size:0.78rem; margin:0.5rem 0;">This stays in sync with the builder above. Edit it and press <strong>Apply</strong> to update the builder, or paste JSON from Discohook. <code>{ "content": …, "embeds": [ … ] }</code>.</p>
          <textarea id="jsonEditor" rows="12" spellcheck="false" autocomplete="off" autocapitalize="off" style="width:100%; font-family:ui-monospace,Menlo,Consolas,monospace; font-size:0.8rem; white-space:pre;"></textarea>
          <div class="field-row" style="margin:0.5rem 0 0; align-items:center;">
            <button class="btn small" type="button" onclick="applyJson()">Apply to builder</button>
            <button class="btn secondary small" type="button" onclick="formatJson()">Format</button>
            <button class="btn secondary small" type="button" onclick="copyJson()">Copy</button>
            <span class="muted" id="jsonStatus" style="font-size:0.78rem; margin-left:auto;"></span>
          </div>
        </details>
      </div>

      <div class="sticky-preview">
        <div class="card" style="margin-bottom:0;">
          <h3 style="margin-top:0;">Live preview</h3>
          <div class="discord-chat eb-preview">
            <div class="discord-message-preview">
              <img class="discord-avatar" src="<%= bot.avatarUrl %>" alt="">
              <div class="discord-message-body">
                <div class="discord-message-header"><span class="discord-bot-name"><%= bot.name %></span><span class="discord-bot-badge">BOT</span><span class="discord-message-time">Today at 12:00 PM</span></div>
                <div class="desc md" id="pContent"></div>
                <div id="pEmbeds"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <dialog id="importDialog" class="eb-dialog">
    <form method="dialog" class="eb-dialog-inner" onsubmit="return false;">
      <h3 style="margin-top:0;">Import a message</h3>
      <p class="muted" style="font-size:0.84rem; margin-top:0;">Paste JSON from Discohook's JSON editor, a webhook payload, a single embed, or choose a file. The first message found is opened in the editor.</p>
      <textarea id="importText" rows="8" placeholder='{"content": "Hello", "embeds": [{"title": "FAQ", "color": 5793266}]}'></textarea>
      <div class="field-row" style="margin-top:0.6rem; align-items:center;">
        <input type="file" id="importFile" accept=".json,application/json">
        <button class="btn secondary small" type="button" onclick="parseImportInput()">Read</button>
      </div>
      <div id="importResults"></div>
      <div class="eb-dialog-actions">
        <button class="btn secondary" type="button" onclick="document.getElementById('importDialog').close()">Cancel</button>
        <button class="btn" type="button" id="importOpenBtn" onclick="openImported()" disabled>Open in editor</button>
      </div>
    </form>
  </dialog>

  <div class="toast" id="toast"></div>

  <script src="/js/mentions.js"></script>
  <script src="/js/embed-json.js"></script>
  <script id="faqData" type="application/json"><%- JSON.stringify(message).replace(/</g, '\\u003c') %></script>
  <script>
    window.FAQ_CONFIG = { guildId: '<%= guild.id %>' };
  </script>
  <script src="/js/faq.js"></script>
</body>
</html>
