    // --- Gambling ---
    function renderOdds() {
      const edge = Math.min(Math.max(Number(document.getElementById('gEdge').value) || 0, 0), 50) / 100;
      const x = (v) => `${v.toFixed(2)}x`;
      const mines = (k, m) => {
        let v = 1;
        for (let i = 0; i < k; i++) v *= (25 - i) / (25 - m - i);
        return v * (1 - edge);
      };
      const rows = [
        ['🪙 Coinflip', 'Win (50/50)', x(2 * (1 - edge))],
        ['🂡 Blackjack', 'Win · push returns the bet', x(2 - edge)],
        ['🂡 Blackjack', 'Natural blackjack (3:2)', x(1 + 1.5 * (1 - edge))],
        ['💣 Mines', '3 mines, 1 gem → 5 gems', `${x(mines(1, 3))} → ${x(mines(5, 3))}`],
        ['💣 Mines', '10 mines, 1 gem → 3 gems', `${x(mines(1, 10))} → ${x(mines(3, 10))}`],
        ['🃏 High-Low', 'One correct call on a 7', x((1 - edge) / (7 / 13))]
      ];
      document.getElementById('gOdds').innerHTML =
        '<tr><th>Game</th><th>Result</th><th style="text-align:right;">Pays</th></tr>' +
        rows.map(([g, r, p]) => `<tr><td>${g}</td><td class="muted">${r}</td><td>${p}</td></tr>`).join('') +
        `<tr><td colspan="3" class="muted" style="font-size:0.78rem;">Players get back ${(100 - edge * 100).toFixed(1)}% of what they bet on average.</td></tr>`;
    }

