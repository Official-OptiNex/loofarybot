        </div>
      </div>
    </div>

    <!-- GAMBLING -->
    <div class="tab-panel hidden" id="tab-gambling">
      <div class="module-hero">
        <div class="hero-icon red">🎰</div>
        <div>
          <h1>XP Gambling</h1>
          <p>Members bet XP on coinflip, blackjack, mines and high-low.</p>
          <div class="hero-status">
            <%- chip('', gambling.edgePercent + '% house edge') %>
            <%- chip('', 'Bets ' + gambling.minBet + '–' + (gambling.maxBet || '∞') + ' XP') %>
            <%- chip('', channelName(gambling.channelId) ? 'Only in ' + esc(channelName(gambling.channelId)) : 'Any channel') %>
          </div>
        </div>
        <div class="hero-toggle"><span class="muted" style="font-size:0.85rem;">Enabled</span><%- moduleToggle('gambling', gambling.enabled, 'gEnabled') %></div>
      </div>
      <div class="two-col">
        <div class="card settings-card">
          <div class="setting-row">
            <div><div class="setting-title">House edge</div><div class="setting-help">Taken from every payout. 4% means players get back 96% on average.</div></div>
            <div class="setting-control"><input type="number" id="gEdge" min="0" max="50" step="0.5" value="<%= gambling.edgePercent %>" oninput="renderOdds()"></div>
          </div>
