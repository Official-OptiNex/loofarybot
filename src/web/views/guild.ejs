    // --- Join analytics chart ---
    const chartState = { days: 30, bucket: 'day' };
    const fmt = (n) => Number(n).toLocaleString();

    function formatLabel(iso) {
      const d = new Date(iso + 'T00:00:00Z');
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', timeZone: 'UTC' });
    }

    async function loadJoinChart() {
      try {
        const res = await fetch(`/api/guilds/${guildId}/joins?days=${chartState.days}&bucket=${chartState.bucket}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to load.');
        renderJoinChart(data);
      } catch (err) {
        document.getElementById('chartEmpty').textContent = `❌ ${err.message}`;
        document.getElementById('chartEmpty').classList.add('visible');
      }
    }

    function setTrend(id, value, { suffix = '%', invert = false } = {}) {
      const el = document.getElementById(id);
      el.classList.remove('trend-up', 'trend-down');
      if (value === null || value === undefined) {
        el.textContent = '—';
        return;
      }
      el.textContent = `${value > 0 ? '+' : ''}${fmt(value)}${suffix}`;
      if (value !== 0) el.classList.add((value > 0) !== invert ? 'trend-up' : 'trend-down');
    }

    const cssVar = (name) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

    // Theme-dependent chart styling (re-applied when Sun/Moon is toggled).
    function styleChart(chart) {
      const label = cssVar('--text-label');
      const grid = cssVar('--border-card');
      const tick = { color: label, font: { family: "Inter, -apple-system, 'Segoe UI', sans-serif", size: 11 } };
      chart.options.scales.x.ticks = { ...tick, maxRotation: 0, autoSkipPadding: 18 };
      chart.options.scales.x.grid = { color: grid, borderDash: [4, 4], drawTicks: false };
      chart.options.scales.y.ticks = { ...tick, precision: 0, padding: 8 };
      chart.options.scales.y.grid = { color: grid, borderDash: [4, 4], drawTicks: false };
      Object.assign(chart.options.plugins.tooltip, {
        backgroundColor: cssVar('--bg-card'),
        borderColor: cssVar('--border-strong'),
        titleColor: cssVar('--text-main'),
        bodyColor: cssVar('--text-main')
      });
      chart.data.datasets.forEach((ds) => (ds.pointHoverBackgroundColor = cssVar('--bg-card')));
      chart.update();
    }

    function renderJoinChart(data) {
      const { totals } = data;
      const t = totals.trends || {};
      setTrend('tJoinsWeek', t.joinsWeek);
      setTrend('tJoinsDay', t.joinsDay);
      setTrend('tLeavesWeek', totals.leaves7, { suffix: '', invert: true });
      setTrend('tNetWeek', t.netWeek, { suffix: '' });
      document.getElementById('fJoinedToday').textContent = fmt(totals.today);
      document.getElementById('fLeftToday').textContent = fmt(totals.leavesToday);
      document.getElementById('vJoinsRange').textContent = fmt(totals.inRange);
      document.getElementById('lJoinsRange').textContent =
        chartState.days === 365 ? 'New joins · 1 year' : `New joins · ${chartState.days} days`;
      document.getElementById('chartEmpty').classList.toggle('visible', totals.tracked === 0);
      document.getElementById('chartSubtitle').textContent = `${fmt(totals.tracked)} joins tracked · UTC`;

      if (typeof Chart === 'undefined') return; // CDN blocked — the stat cards above still work
      const labels = data.labels.map(formatLabel);
      const line = (label, values, color) => ({
        label, data: values, borderColor: color, backgroundColor: color, borderWidth: 3, tension: 0.42, fill: false,
        pointRadius: 0, pointHoverRadius: 6, pointHoverBorderWidth: 3, pointHoverBorderColor: color
      });
      const datasets = [
        line('Joins', data.joins, cssVar('--c-blue')),
        line('Leaves', data.leaves, cssVar('--c-red')),
        line('Net change', data.net, cssVar('--c-yellow'))
      ];

      if (joinChart) {
        joinChart.data.labels = labels;
        joinChart.data.datasets.forEach((ds, i) => (ds.data = datasets[i].data));
        joinChart.update();
        return;
      }
      const ctx = document.getElementById('joinChart').getContext('2d');
      joinChart = new Chart(ctx, {
        type: 'line',
        data: { labels, datasets },
        options: {
          responsive: true, maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          layout: { padding: { top: 6 } },
          plugins: {
            legend: { display: false },
            tooltip: {
              borderWidth: 1, padding: 12, cornerRadius: 8, boxPadding: 5, usePointStyle: true,
              titleFont: { weight: '600' },
              callbacks: { label: (c) => ` ${c.dataset.label}: ${fmt(c.parsed.y)}` }
            }
          },
          scales: {
            x: { border: { display: false } },
            y: { beginAtZero: true, border: { display: false } }
          }
        }
      });
      styleChart(joinChart);
    }

    function bindSegmented(id, key, attr) {
      document.querySelectorAll(`#${id} button`).forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll(`#${id} button`).forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          chartState[key] = key === 'days' ? Number(btn.dataset[attr]) : btn.dataset[attr];
          loadJoinChart();
        });
      });
    }
    bindSegmented('rangeControl', 'days', 'days');
    bindSegmented('bucketControl', 'bucket', 'bucket');

