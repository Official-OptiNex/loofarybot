              <option value="">All events</option>
              <% Object.entries(logEvents).forEach(([key, label]) => { %><option value="<%= key %>"><%= label %></option><% }) %>
            </select>
            <button class="btn secondary small" onclick="loadLogs(1)">↻ Refresh</button>
          </div>
          <div class="log-list" id="logList"><div class="empty-state">Loading…</div></div>
          <div class="pagination">
            <button class="btn secondary small" id="logPrev" onclick="loadLogs(logState.page - 1)">← Newer</button>
            <span class="muted" id="logPageLabel"></span>
            <button class="btn secondary small" id="logNext" onclick="loadLogs(logState.page + 1)">Older →</button>
          </div>
        </div>
