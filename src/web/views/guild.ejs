<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= guild.name %> | LoofaryBot</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <div class="brand">🎁 LoofaryBot</div>
    <a class="btn secondary" href="/dashboard">← All Servers</a>
  </nav>
  <div class="container">
    <div class="guild-header">
      <% if (guild.iconURL()) { %>
        <img src="<%= guild.iconURL({ size: 128 }) %>">
      <% } %>
      <div>
        <h1 style="margin:0;"><%= guild.name %></h1>
        <p class="muted" style="margin:0.2rem 0 0;">
          👥 <%= stats.memberCount %> members
          <% if (stats.boostTier > 0) { %> · <span class="badge boost">⭐ Boost Tier <%= stats.boostTier %></span><% } %>
        </p>
      </div>
      <a class="btn" href="/dashboard/<%= guild.id %>/embed" style="margin-left:auto;">🖌️ Embed Builder</a>
    </div>

    <div class="tabs">
      <button class="tab-btn active" data-tab="overview">Overview</button>
      <button class="tab-btn" data-tab="honeypot">🍯 Honeypot</button>
      <button class="tab-btn" data-tab="leveling">📈 Leveling</button>
      <button class="tab-btn" data-tab="autorole">🛡️ Auto-Role</button>
      <button class="tab-btn" data-tab="leaderboard">🏆 Leaderboard</button>
      <button class="tab-btn" data-tab="commands">📜 Commands</button>
    </div>

    <!-- OVERVIEW -->
    <div class="tab-panel" id="tab-overview">
      <div class="overview-stat-grid">
        <div class="overview-stat"><div class="icon">👥</div><div class="value"><%= stats.memberCount %></div><div class="label">Members</div></div>
        <div class="overview-stat"><div class="icon">💬</div><div class="value"><%= stats.channelCount %></div><div class="label">Channels</div></div>
        <div class="overview-stat"><div class="icon">🎭</div><div class="value"><%= stats.roleCount %></div><div class="label">Roles</div></div>
        <div class="overview-stat"><div class="icon">😀</div><div class="value"><%= stats.emojiCount %></div><div class="label">Emojis</div></div>
        <div class="overview-stat"><div class="icon">⭐</div><div class="value"><%= stats.boostCount %></div><div class="label">Boosts</div></div>
        <div class="overview-stat"><div class="icon">📅</div><div class="value"><%= new Date(stats.createdTimestamp).toLocaleDateString() %></div><div class="label">Created</div></div>
      </div>
      <p class="muted" style="margin-bottom:1.5rem;">Owned by <strong><%= stats.ownerTag %></strong> · Server ID <code><%= guild.id %></code></p>

      <div class="grid">
        <div class="card">
          <h3>🍯 Honeypot <span class="badge <%= config.honeypotChannelId ? 'on' : 'off' %>"><%= config.honeypotChannelId ? 'Active' : 'Not set up' %></span></h3>
          <% if (config.honeypotChannelId) {
               const hpChannel = channels.find(c => c.id === config.honeypotChannelId);
          %>
            <p class="muted">Trap: <strong>#<%= hpChannel ? hpChannel.name : 'unknown-channel' %></strong> · Action: <strong><%= config.honeypotAction %></strong></p>
            <p class="muted">Kicks: <%= config.honeypotKicks || 0 %> · Soft Bans: <%= config.honeypotSoftbans || 0 %> · Bans: <%= config.honeypotBans || 0 %></p>
          <% } else { %>
            <p class="muted">Not set up yet — see the Honeypot tab.</p>
          <% } %>
        </div>
        <div class="card">
          <h3>📈 Leveling <span class="badge <%= config.levelingEnabled === false ? 'off' : 'on' %>"><%= config.levelingEnabled === false ? 'Disabled' : 'Enabled' %></span></h3>
          <p class="muted">XP per message: <strong><%= effectiveXp.xpMin %>–<%= effectiveXp.xpMax %></strong>,
            cooldown <strong><%= effectiveXp.cooldownMs / 1000 %>s</strong></p>
          <p class="muted"><%= (config.levelRoles || []).length %> role reward(s) configured.</p>
          <% const lvlChannel = config.levelUpChannelId ? channels.find(c => c.id === config.levelUpChannelId) : null; %>
          <p class="muted">Level-up messages: <strong><%= lvlChannel ? '#' + lvlChannel.name : 'same channel' %></strong></p>
        </div>
        <div class="card">
          <h3>🛡️ Auto-Role <span class="badge <%= (config.autoRoleId && config.autoRoleEnabled !== false) ? 'on' : 'off' %>"><%= (config.autoRoleId && config.autoRoleEnabled !== false) ? 'Active' : 'Not set up' %></span></h3>
          <% if (stats.autoRoleName) { %>
            <p class="muted">New members receive <strong><%= stats.autoRoleName %></strong> automatically.</p>
          <% } else { %>
            <p class="muted">Not configured yet — see the Auto-Role tab.</p>
          <% } %>
        </div>
        <div class="card">
          <h3>🖌️ Quick Links</h3>
          <p class="muted"><a href="/dashboard/<%= guild.id %>/embed">Open the Embed Builder →</a></p>
          <p class="muted" style="margin-top:0.4rem;">Use the tabs above to configure everything else.</p>
        </div>
      </div>
    </div>

    <!-- HONEYPOT -->
    <div class="tab-panel hidden" id="tab-honeypot">
      <div class="card">
        <h2>🍯 Honeypot Trap</h2>
        <p class="muted">Anyone who posts in this channel is instantly punished. A live counter embed is posted there.</p>
        <label for="hpChannel">Trap Channel</label>
        <select id="hpChannel">
          <option value="">— Select a channel —</option>
          <% channels.forEach(c => { %>
            <option value="<%= c.id %>" <%= config.honeypotChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
          <% }) %>
        </select>
        <label for="hpAction">Enforcement Action</label>
        <select id="hpAction">
          <option value="kick" <%= config.honeypotAction === 'kick' ? 'selected' : '' %>>Kick</option>
          <option value="softban" <%= config.honeypotAction === 'softban' ? 'selected' : '' %>>Soft Ban (purge messages)</option>
          <option value="ban" <%= config.honeypotAction === 'ban' ? 'selected' : '' %>>Permanent Ban</option>
        </select>
        <p class="muted" style="margin-top:0.75rem;">
          Current counts — Kicks: <strong><%= config.honeypotKicks || 0 %></strong>,
          Soft Bans: <strong><%= config.honeypotSoftbans || 0 %></strong>,
          Bans: <strong><%= config.honeypotBans || 0 %></strong>
        </p>
        <button class="btn" style="margin-top:1rem;" onclick="saveHoneypot()">Save Honeypot Settings</button>
      </div>
    </div>

    <!-- LEVELING -->
    <div class="tab-panel hidden" id="tab-leveling">
      <div class="card">
        <h2>📈 Leveling</h2>
        <label style="display:flex; align-items:center; gap:0.5rem;">
          <input type="checkbox" id="lvlEnabled" style="width:auto;" <%= config.levelingEnabled === false ? '' : 'checked' %>>
          Enable XP gain from chat messages
        </label>

        <h3 style="margin-top:1.5rem;">Level-Up Messages</h3>
        <label for="levelUpChannel">Send level-up messages to</label>
        <select id="levelUpChannel">
          <option value="">Same channel the member was chatting in</option>
          <% channels.forEach(c => { %>
            <option value="<%= c.id %>" <%= config.levelUpChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
          <% }) %>
        </select>
        <% if (config.levelUpChannelId && !channels.find(c => c.id === config.levelUpChannelId)) { %>
          <p class="muted" style="color:#FEE75C;">⚠️ The configured level-up channel no longer exists — messages are falling back to the same channel.</p>
        <% } %>

        <h3 style="margin-top:1.5rem;">XP Tuning</h3>
        <p class="muted">Leave a field blank to use the site-wide default shown as its placeholder.</p>
        <div class="field-row">
          <div>
            <label for="xpMin">Min XP / message</label>
            <input type="number" id="xpMin" min="0" placeholder="<%= effectiveXp.xpMin %>" value="<%= config.xpMin ?? '' %>">
          </div>
          <div>
            <label for="xpMax">Max XP / message</label>
            <input type="number" id="xpMax" min="0" placeholder="<%= effectiveXp.xpMax %>" value="<%= config.xpMax ?? '' %>">
          </div>
        </div>
        <div class="field-row">
          <div>
            <label for="xpCooldown">Cooldown (seconds)</label>
            <input type="number" id="xpCooldown" min="0" placeholder="<%= effectiveXp.cooldownMs / 1000 %>" value="<%= config.xpCooldownSeconds ?? '' %>">
          </div>
          <div>
            <label for="levelXpBase">Level curve base (higher = slower)</label>
            <input type="number" id="levelXpBase" min="1" placeholder="<%= effectiveXp.levelXpBase %>" value="<%= config.levelXpBase ?? '' %>">
          </div>
        </div>

        <h3 style="margin-top:1.5rem;">Level-Up Role Rewards</h3>
        <div id="levelRoleRows">
          <% (config.levelRoles || []).forEach(lr => {
               const role = roles.find(r => r.id === lr.roleId);
          %>
            <div class="field-row level-role-row">
              <input type="number" min="1" class="lr-level" value="<%= lr.level %>" placeholder="Level">
              <select class="lr-role">
                <% roles.forEach(r => { %>
                  <option value="<%= r.id %>" <%= r.id === lr.roleId ? 'selected' : '' %>><%= r.name %><%= r.assignable ? '' : ' ⚠️ (bot cannot assign this)' %></option>
                <% }) %>
              </select>
              <button class="btn secondary" type="button" onclick="this.parentElement.remove()">Remove</button>
            </div>
            <% if (role && !role.assignable) { %>
              <p class="muted" style="color:#FEE75C; margin-top:-0.3rem;">⚠️ LoofaryBot's role is below <%= role.name %> — move LoofaryBot's role higher in Server Settings → Roles.</p>
            <% } %>
          <% }) %>
        </div>
        <button class="btn secondary" type="button" onclick="addLevelRoleRow()">+ Add Role Reward</button>
        <br>
        <button class="btn" style="margin-top:1rem;" onclick="saveLevels()">Save Leveling Settings</button>
      </div>
    </div>

    <!-- AUTO-ROLE -->
    <div class="tab-panel hidden" id="tab-autorole">
      <div class="card">
        <h2>🛡️ Auto-Role</h2>
        <p class="muted">Automatically grant a role to every member when they join. Use Sync to also grant it to everyone already in the server.</p>

        <label style="display:flex; align-items:center; gap:0.5rem;">
          <input type="checkbox" id="arEnabled" style="width:auto;" <%= config.autoRoleEnabled === false ? '' : 'checked' %>>
          Enable auto-role on join
        </label>

        <label for="arRole">Role to grant</label>
        <select id="arRole">
          <option value="">— None —</option>
          <% roles.forEach(r => { %>
            <option value="<%= r.id %>" <%= config.autoRoleId === r.id ? 'selected' : '' %>><%= r.name %><%= r.assignable ? '' : ' ⚠️ (bot cannot assign this)' %></option>
          <% }) %>
        </select>

        <button class="btn" style="margin-top:1rem;" onclick="saveAutoRole()">Save Auto-Role Settings</button>
        <button class="btn secondary" style="margin-top:1rem;" onclick="syncAutoRole()">🔄 Sync to Existing Members</button>
        <p class="muted" id="arSyncResult" style="margin-top:0.75rem;"></p>
      </div>
    </div>

    <!-- COMMANDS -->
    <div class="tab-panel hidden" id="tab-commands">
      <% commandReference.forEach(group => { %>
        <div class="card">
          <h3><%= group.group %></h3>
          <% group.commands.forEach(cmd => { %>
            <div class="cmd-row">
              <code><%= cmd.usage %></code>
              <span class="muted"><%= cmd.description %></span>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </div>

    <!-- LEADERBOARD -->
    <div class="tab-panel hidden" id="tab-leaderboard">
      <div class="card">
        <h2>🏆 XP Leaderboard</h2>
        <div id="leaderboardRows" class="muted">Loading…</div>
        <div class="pagination">
          <button class="btn secondary" id="lbPrev" onclick="changeLeaderboardPage(-1)">← Prev</button>
          <span class="muted" id="lbPageLabel">Page 1</span>
          <button class="btn secondary" id="lbNext" onclick="changeLeaderboardPage(1)">Next →</button>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    const guildId = '<%= guild.id %>';
    const roles = <%- JSON.stringify(roles) %>;

    // --- Tabs ---
    document.querySelectorAll('.tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach((b) => b.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach((p) => p.classList.add('hidden'));
        btn.classList.add('active');
        document.getElementById(`tab-${btn.dataset.tab}`).classList.remove('hidden');
        if (btn.dataset.tab === 'leaderboard') loadLeaderboard();
      });
    });

    // --- Leaderboard ---
    let lbCurrentPage = 1;
    let lbTotalPages = 1;
    let lbLoaded = false;

    async function loadLeaderboard() {
      if (lbLoaded) return;
      lbLoaded = true;
      await fetchLeaderboardPage(1);
    }

    async function fetchLeaderboardPage(page) {
      const container = document.getElementById('leaderboardRows');
      container.innerHTML = '<p class="muted">Loading…</p>';
      try {
        const res = await fetch(`/api/guilds/${guildId}/leaderboard?page=${page}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to load.');

        lbCurrentPage = data.page;
        lbTotalPages = data.totalPages;
        document.getElementById('lbPageLabel').textContent = `Page ${data.page} of ${data.totalPages} · ${data.total} ranked member(s)`;
        document.getElementById('lbPrev').disabled = data.page <= 1;
        document.getElementById('lbNext').disabled = data.page >= data.totalPages;

        if (data.entries.length === 0) {
          container.innerHTML = '<p class="muted">No XP data yet for this server.</p>';
          return;
        }

        container.innerHTML = data.entries
          .map(
            (e) => `
            <div class="leaderboard-row">
              <div class="leaderboard-rank ${e.rank <= 3 ? 'top3' : ''}">#${e.rank}</div>
              ${e.avatarUrl ? `<img class="leaderboard-avatar" src="${e.avatarUrl}">` : '<div class="leaderboard-avatar"></div>'}
              <div class="leaderboard-name">${e.name}</div>
              <div class="leaderboard-stats">Level ${e.level} · ${e.xp} XP</div>
            </div>`
          )
          .join('');
      } catch (err) {
        container.innerHTML = `<p class="muted">❌ ${err.message}</p>`;
      }
    }

    function changeLeaderboardPage(delta) {
      const next = lbCurrentPage + delta;
      if (next < 1 || next > lbTotalPages) return;
      fetchLeaderboardPage(next);
    }

    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.style.display = 'block';
      setTimeout(() => (t.style.display = 'none'), 2500);
    }

    function roleOptionsHtml(selectedId) {
      return roles
        .map((r) => `<option value="${r.id}" ${r.id === selectedId ? 'selected' : ''}>${r.name}${r.assignable ? '' : ' ⚠️ (bot cannot assign this)'}</option>`)
        .join('');
    }

    function addLevelRoleRow() {
      const container = document.getElementById('levelRoleRows');
      const row = document.createElement('div');
      row.className = 'field-row level-role-row';
      row.innerHTML = `
        <input type="number" min="1" class="lr-level" placeholder="Level">
        <select class="lr-role">${roleOptionsHtml(null)}</select>
        <button class="btn secondary" type="button" onclick="this.parentElement.remove()">Remove</button>
      `;
      container.appendChild(row);
    }

    async function saveHoneypot() {
      const channelId = document.getElementById('hpChannel').value;
      const action = document.getElementById('hpAction').value;
      const res = await fetch(`/api/guilds/${guildId}/honeypot`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ channelId, action })
      });
      showToast(res.ok ? '✅ Honeypot settings saved.' : '❌ Failed to save.');
    }

    async function saveLevels() {
      const enabled = document.getElementById('lvlEnabled').checked;
      const levelRoles = [...document.querySelectorAll('.level-role-row')].map((row) => ({
        level: row.querySelector('.lr-level').value,
        roleId: row.querySelector('.lr-role').value
      }));
      const payload = {
        enabled,
        levelRoles,
        xpMin: document.getElementById('xpMin').value,
        xpMax: document.getElementById('xpMax').value,
        xpCooldownSeconds: document.getElementById('xpCooldown').value,
        levelXpBase: document.getElementById('levelXpBase').value,
        levelUpChannelId: document.getElementById('levelUpChannel').value
      };
      const res = await fetch(`/api/guilds/${guildId}/levels`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      showToast(res.ok ? '✅ Leveling settings saved. Reload to see updated hierarchy warnings.' : '❌ Failed to save.');
    }

    // --- Auto-Role ---
    async function saveAutoRole() {
      const roleId = document.getElementById('arRole').value;
      const enabled = document.getElementById('arEnabled').checked;
      const res = await fetch(`/api/guilds/${guildId}/autorole`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ roleId, enabled })
      });
      showToast(res.ok ? '✅ Auto-role settings saved.' : '❌ Failed to save.');
    }

    async function syncAutoRole() {
      const resultEl = document.getElementById('arSyncResult');
      resultEl.textContent = 'Syncing… this can take a moment on larger servers.';
      try {
        const res = await fetch(`/api/guilds/${guildId}/autorole/sync`, { method: 'POST' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Sync failed.');
        resultEl.textContent = `✅ Granted the role to ${data.granted} member(s).${data.failed > 0 ? ` Failed for ${data.failed} (check hierarchy/permissions).` : ''}`;
      } catch (err) {
        resultEl.textContent = `❌ ${err.message}`;
      }
    }
  </script>
</body>
</html>
