<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= guild.name %> | LoofaryBot</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>
<%
  // Line icons (24x24, stroke-based) shared by the sidebar, app bar and stat cards.
  const ICON_PATHS = {
    home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9v11.5h13V9"/><path d="M10 20.5v-6h4v6"/>',
    welcome: '<path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.1-4.6A8.5 8.5 0 1 1 21 12z"/><path d="M9 13.5a3.5 3.5 0 0 0 6 0"/>',
    shield: '<path d="M12 3l8 3v6c0 4.8-3.4 8-8 9-4.6-1-8-4.2-8-9V6z"/>',
    trending: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
    userplus: '<circle cx="9" cy="8" r="4"/><path d="M2 21a7 7 0 0 1 14 0"/><path d="M19 8v6M16 11h6"/>',
    dice: '<rect x="3.5" y="3.5" width="17" height="17" rx="4"/><circle cx="8.5" cy="8.5" r="1.1" fill="currentColor"/><circle cx="12" cy="12" r="1.1" fill="currentColor"/><circle cx="15.5" cy="15.5" r="1.1" fill="currentColor"/>',
    file: '<path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8z"/><path d="M14 3v5h5"/><path d="M8.5 13h7M8.5 16.5h4.5"/>',
    trophy: '<path d="M8 21h8M12 16.5V21"/><path d="M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M17 5.5h2.5a2.5 2.5 0 0 1-2.8 4M7 5.5H4.5a2.5 2.5 0 0 0 2.8 4"/>',
    terminal: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l3 3-3 3M12.5 15H17"/>',
    search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>',
    bell: '<path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 20.5a2 2 0 0 0 4 0"/>',
    brush: '<path d="M18.5 3.5a2.1 2.1 0 0 1 3 3L12 16l-3.5.5.5-3.5z"/><path d="M8 17c-2 0-3.5 1.3-3.5 3.5H8a2.5 2.5 0 0 0 0-5"/>',
    menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
    users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6.5 6.5 0 0 1 3.5 5.5"/>',
    login: '<path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"/><path d="M10 16l4-4-4-4M14 12H4"/>',
    star: '<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>',
    target: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1" fill="currentColor"/>',
    curve: '<path d="M3 3v18h18"/><path d="M6.5 15c3-7 5.5-7 8 0 1.5 4 3 3.5 5-2"/>',
    radio: '<circle cx="12" cy="12" r="2"/><path d="M16.2 7.8a6 6 0 0 1 0 8.4M7.8 16.2a6 6 0 0 1 0-8.4M19 5a10 10 0 0 1 0 14M5 19A10 10 0 0 1 5 5"/>',
    gear: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>'
  };
  const icon = (name) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON_PATHS[name]}</svg>`;

  const NAV = [
    ['overview', 'home', 'Overview'],
    ['welcome', 'welcome', 'Welcome'],
    ['honeypot', 'shield', 'Honeypot'],
    ['leveling', 'trending', 'Leveling'],
    ['autorole', 'userplus', 'Auto-Role'],
    ['gambling', 'dice', 'Gambling'],
    ['logs', 'file', 'Logs'],
    ['alerts', 'radio', 'Alerts'],
    ['leaderboard', 'trophy', 'Leaderboard'],
    ['commands', 'terminal', 'Commands'],
    ['settings', 'gear', 'Server settings']
  ].filter(([tab]) => tab === 'overview' || (tab === 'logs' ? can('logs') || can('logviewer') : can(tab)));
  const isAdmin = access.level === 'admin';
  const logChannelSet = !!(config.logChannelId && channels.find(c => c.id === config.logChannelId));
  // [tab, label, enabled flag] — the switches mirror each module's on/off setting.
  const MODULES = [
    ['welcome', 'Welcome', !!welcome.enabled],
    ['honeypot', 'Honeypot', config.honeypotEnabled !== false],
    ['leveling', 'Leveling', config.levelingEnabled !== false],
    ['autorole', 'Auto-Role', config.autoRoleEnabled !== false],
    ['gambling', 'Gambling', gambling.enabled],
    ['logs', 'Logs', config.logsEnabled !== false],
    ['alerts', 'Alerts', config.socialAlertsEnabled !== false]
  ].filter(([tab]) => can(tab) || (tab === 'logs' && can('logviewer')));
  // Moderators see module switches only for pages they're allowed to edit.
  const sideToggle = (key, on) =>
    `<label class="switch sm" title="${can(key) ? `Turn ${key} on or off` : 'Only admins can change this'}"><input type="checkbox" class="module-toggle" data-module="${key}" ${on ? 'checked' : ''} ${can(key) ? '' : 'disabled'} aria-label="Enable ${key}"><span class="track"></span></label>`;
  const catches = (config.honeypotKicks || 0) + (config.honeypotSoftbans || 0) + (config.honeypotBans || 0);
  const pct = (cur, target) => Math.max(0, Math.min(100, target > 0 ? (cur / target) * 100 : 0));
%>
<div class="app-shell" id="appShell">
  <aside class="sidebar" id="sidebar" aria-label="Dashboard navigation">
    <a class="sidebar-brand" href="/dashboard"><span class="brand-mark">🎁</span>LoofaryBot</a>

    <div class="server-card">
      <% if (guild.iconURL()) { %>
        <img src="<%= guild.iconURL({ size: 64 }) %>" alt="">
      <% } else { %>
        <div class="guild-icon-fallback"><%= guild.name.slice(0, 1) %></div>
      <% } %>
      <div style="min-width:0;">
        <div class="name"><%= guild.name %></div>
        <a href="/dashboard">Switch server →</a>
      </div>
    </div>

    <div class="nav-section">
      <div class="nav-heading"><span class="ring-dot"></span>Menu</div>
      <% NAV.forEach(([tab, ic, label], i) => { %>
        <button class="nav-item <%= i === 0 ? 'active' : '' %>" data-tab="<%= tab %>"><%- icon(ic) %><span><%= label %></span></button>
      <% }) %>
    </div>

    <div class="nav-section">
      <div class="nav-heading"><span class="ring-dot green"></span>Modules</div>
      <% MODULES.forEach(([tab, label, on]) => { %>
        <div class="module-row"><button class="module-link" data-tab="<%= tab %>"><%= label %></button><%- sideToggle(tab, on) %></div>
      <% }) %>
    </div>

    <div class="sidebar-footer">
      <label class="switch" title="Toggle light / dark theme">
        <input type="checkbox" id="themeToggle" aria-label="Dark theme">
        <span class="track"></span>
      </label>
      <span><span id="sunLabel">Sun</span> / <strong id="moonLabel">Moon</strong></span>
    </div>
  </aside>
  <div class="sidebar-scrim" onclick="toggleSidebar(false)"></div>

  <div class="main-area">
    <header class="appbar">
      <button class="appbar-icon menu-toggle" onclick="toggleSidebar()" aria-label="Open menu"><%- icon('menu') %></button>
      <div class="appbar-search">
        <%- icon('search') %>
        <input id="globalSearch" type="search" placeholder="Search settings and commands …" autocomplete="off" aria-label="Search settings and commands">
        <div class="search-results" id="searchResults" role="listbox"></div>
      </div>
      <% if (can('embed')) { %><a class="appbar-icon" href="/dashboard/<%= guild.id %>/embed" title="Embed Builder" aria-label="Embed Builder"><%- icon('brush') %></a><% } %>
      <button class="appbar-icon" data-tab="logs" title="Server logs" aria-label="Server logs"><%- icon('bell') %><% if (!logChannelSet) { %><span class="badge-dot"></span><% } %></button>
      <div class="appbar-user">
        <div class="avatar-wrap"><img src="<%= viewer.avatarUrl %>" alt=""><span class="online"></span></div>
        <div class="user-meta">
          <div><%= viewer.username %><% if (!isAdmin) { %> <span class="badge boost" style="font-size:0.6rem;">Moderator</span><% } %></div>
          <a href="/auth/logout">Log out</a>
        </div>
      </div>
    </header>

    <main class="content">
    <!-- OVERVIEW -->
    <div class="tab-panel" id="tab-overview">
      <div class="page-heading">
        <h1>Server members <span>(<%= stats.memberCount.toLocaleString() %>)</span></h1>
        <div class="avatar-stack" title="Newest members">
          <% recentMembers.forEach(m => { %>
            <img src="<%= m.avatarUrl %>" alt="<%= m.name %>" title="<%= m.name %>">
          <% }) %>
          <% if (stats.memberCount > recentMembers.length) { %>
            <% const others = stats.memberCount - recentMembers.length; %>
            <span class="more">+<%= others >= 1000 ? Math.floor(others / 1000) + 'k' : others %></span>
          <% } %>
        </div>
      </div>

      <div class="stat-cards">
        <div class="stat-card tone-blue">
          <div class="stat-body">
            <div class="stat-top"><span class="stat-label">Total members</span><span class="stat-icon"><%- icon('users') %></span></div>
            <div class="stat-value"><%= stats.memberCount.toLocaleString() %></div>
            <div class="stat-trends"><span>Joins wk:<strong id="tJoinsWeek">—</strong></span><span>Day:<strong id="tJoinsDay">—</strong></span></div>
          </div>
          <div class="stat-footer"><span>Joined today</span><strong id="fJoinedToday">—</strong></div>
        </div>
        <div class="stat-card tone-red">
          <div class="stat-body">
            <div class="stat-top"><span class="stat-label" id="lJoinsRange">New joins · 30 days</span><span class="stat-icon"><%- icon('login') %></span></div>
            <div class="stat-value" id="vJoinsRange">—</div>
            <div class="stat-trends"><span>Left wk:<strong id="tLeavesWeek">—</strong></span><span>Net wk:<strong id="tNetWeek">—</strong></span></div>
          </div>
          <div class="stat-footer"><span>Left today</span><strong id="fLeftToday">—</strong></div>
        </div>
        <div class="stat-card tone-yellow">
          <div class="stat-body">
            <div class="stat-top"><span class="stat-label">Ranked members</span><span class="stat-icon"><%- icon('star') %></span></div>
            <div class="stat-value"><%= levelStats.ranked.toLocaleString() %></div>
            <div class="stat-trends"><span>Top level:<strong><%= levelStats.topLevel %></strong></span><span>XP:<strong><%= levelStats.totalXp >= 1e6 ? (levelStats.totalXp / 1e6).toFixed(1) + 'M' : levelStats.totalXp >= 1e3 ? (levelStats.totalXp / 1e3).toFixed(1) + 'k' : levelStats.totalXp %></strong></span></div>
          </div>
          <div class="stat-footer"><span>Role rewards</span><strong><%= (config.levelRoles || []).length %></strong></div>
        </div>
        <div class="stat-card tone-green">
          <div class="stat-body">
            <div class="stat-top"><span class="stat-label">Honeypot catches</span><span class="stat-icon"><%- icon('shield') %></span></div>
            <div class="stat-value"><%= catches.toLocaleString() %></div>
            <div class="stat-trends"><span>Kicks:<strong><%= config.honeypotKicks || 0 %></strong></span><span>Bans:<strong><%= config.honeypotBans || 0 %></strong></span></div>
          </div>
          <div class="stat-footer"><span>Soft bans</span><strong><%= config.honeypotSoftbans || 0 %></strong></div>
        </div>
      </div>

      <div class="overview-row">
        <div class="card panel-card">
          <div class="panel-head">
            <h2 class="panel-title"><%- icon('curve') %>Member curve</h2>
            <div class="chart-controls">
              <div class="segmented" id="rangeControl" role="group" aria-label="Date range">
                <button data-days="7">7D</button>
                <button data-days="30" class="active">30D</button>
                <button data-days="90">90D</button>
                <button data-days="365">1Y</button>
              </div>
              <div class="segmented" id="bucketControl" role="group" aria-label="Group by">
                <button data-bucket="day" class="active">Daily</button>
                <button data-bucket="week">Weekly</button>
              </div>
              <button class="btn secondary small" id="syncJoinsBtn" onclick="syncJoinData()">🔄 Sync Join Data</button>
            </div>
          </div>
          <div class="panel-body">
            <div class="chart-wrap">
              <canvas id="joinChart" aria-label="Member joins, leaves and net change" role="img"></canvas>
              <div class="chart-empty" id="chartEmpty">No join data yet. New joins are recorded automatically; click <strong>&nbsp;Sync Join Data&nbsp;</strong> to backfill current members.</div>
            </div>
            <div class="chart-legend">
              <span><span class="dot" style="background:var(--c-blue);"></span>Joins</span>
              <span><span class="dot" style="background:var(--c-red);"></span>Leaves <span class="muted">(tracked from now on)</span></span>
              <span><span class="dot" style="background:var(--c-yellow);"></span>Net change</span>
              <span id="chartSubtitle" style="margin-left:auto;"></span>
            </div>
          </div>
        </div>

        <div class="card panel-card">
          <div class="panel-head"><h2 class="panel-title"><%- icon('target') %>Server goals</h2></div>
          <div class="panel-body">
            <div class="goal blue">
              <div class="goal-head"><span>Members</span><span><%= goals.members.current.toLocaleString() %> / <%= goals.members.target.toLocaleString() %></span></div>
              <div class="goal-track"><div class="goal-fill" style="width:<%= pct(goals.members.current, goals.members.target) %>%;"></div></div>
              <div class="goal-note"><%= (goals.members.target - goals.members.current).toLocaleString() %> to the next milestone</div>
            </div>
            <div class="goal red">
              <div class="goal-head"><span>Ranked members</span><span><%= goals.ranked.current.toLocaleString() %> / <%= goals.ranked.target.toLocaleString() %></span></div>
              <div class="goal-track"><div class="goal-fill" style="width:<%= pct(goals.ranked.current, goals.ranked.target) %>%;"></div></div>
              <div class="goal-note"><%= Math.round(pct(goals.ranked.current, goals.ranked.target)) %>% of members have earned XP</div>
            </div>
            <div class="goal yellow">
              <div class="goal-head"><span>Boosts</span><span><%= goals.boosts.current %> / <%= goals.boosts.target %></span></div>
              <div class="goal-track"><div class="goal-fill" style="width:<%= pct(goals.boosts.current, goals.boosts.target) %>%;"></div></div>
              <div class="goal-note"><%= goals.boosts.maxed ? 'Max boost tier reached 🎉' : (goals.boosts.target - goals.boosts.current) + ' more for Boost Tier ' + ([2, 7, 14].indexOf(goals.boosts.target) + 1) %></div>
            </div>
          </div>
        </div>
      </div>

      <div class="section-title"><h2>Modules</h2></div>
      <div class="grid">
        <div class="card">
          <% const wChannel = welcome.channelId ? channels.find(c => c.id === welcome.channelId) : null; %>
          <h3>👋 Welcome <%- sideToggle('welcome', !!welcome.enabled) %></h3>
          <p class="muted"><%= wChannel ? 'Greeting new members in #' + wChannel.name : 'Set up a greeting in the Welcome tab.' %></p>
        </div>
        <div class="card">
          <h3>🍯 Honeypot <%- sideToggle('honeypot', config.honeypotEnabled !== false) %></h3>
          <% if (config.honeypotChannelId) {
               const hpChannel = channels.find(c => c.id === config.honeypotChannelId);
          %>
            <p class="muted">Trap: <strong>#<%= hpChannel ? hpChannel.name : 'unknown-channel' %></strong> · Action: <strong><%= config.honeypotAction %></strong></p>
            <p class="muted">Kicks: <%= config.honeypotKicks || 0 %> · Soft Bans: <%= config.honeypotSoftbans || 0 %> · Bans: <%= config.honeypotBans || 0 %></p>
          <% } else { %>
            <p class="muted">Not set up yet — see the Honeypot tab.</p>
          <% } %>
        </div>
        <div class="card">
          <h3>📈 Leveling <%- sideToggle('leveling', config.levelingEnabled !== false) %></h3>
          <p class="muted">XP per message: <strong><%= effectiveXp.xpMin %>–<%= effectiveXp.xpMax %></strong>,
            cooldown <strong><%= effectiveXp.cooldownMs / 1000 %>s</strong></p>
          <p class="muted"><%= (config.levelRoles || []).length %> role reward(s) configured.</p>
          <% const lvlChannel = config.levelUpChannelId ? channels.find(c => c.id === config.levelUpChannelId) : null; %>
          <p class="muted">Level-up messages: <strong><%= lvlChannel ? '#' + lvlChannel.name : 'same channel' %></strong></p>
        </div>
        <div class="card">
          <h3>🛡️ Auto-Role <%- sideToggle('autorole', config.autoRoleEnabled !== false) %></h3>
          <% if (stats.autoRoleName) { %>
            <p class="muted">New members receive <strong><%= stats.autoRoleName %></strong> automatically.</p>
          <% } else { %>
            <p class="muted">Not configured yet — see the Auto-Role tab.</p>
          <% } %>
        </div>
        <div class="card">
          <h3>🎰 Gambling <%- sideToggle('gambling', gambling.enabled) %></h3>
          <p class="muted">House edge <strong><%= gambling.edgePercent %>%</strong> · Bets <strong><%= gambling.minBet %>–<%= gambling.maxBet || '∞' %> XP</strong></p>
          <% const gChannel = gambling.channelId ? channels.find(c => c.id === gambling.channelId) : null; %>
          <p class="muted">Channel: <strong><%= gChannel ? '#' + gChannel.name : 'anywhere' %></strong></p>
        </div>
        <div class="card">
          <% const logCh = config.logChannelId ? channels.find(c => c.id === config.logChannelId) : null; %>
          <h3>📋 Logs <%- sideToggle('logs', config.logsEnabled !== false) %></h3>
          <p class="muted"><%= logCh ? 'Also posting to #' + logCh.name : 'Viewable on the Logs page' %> · <a href="#logs" data-tab="logs">Open log viewer →</a></p>
        </div>
        <div class="card">
          <h3>🖌️ Quick Links</h3>
          <% if (can('embed')) { %><p class="muted"><a href="/dashboard/<%= guild.id %>/embed">Open the Embed Builder →</a></p><% } %>
          <p class="muted" style="margin-top:0.4rem;">Use the tabs above to configure everything else.</p>
        </div>
      </div>
    </div>

<%
  // Shared building blocks for module pages.
  const moduleToggle = (key, on, id, size = '') =>
    `<label class="switch ${size}" title="Turn this module on or off"><input type="checkbox" class="module-toggle" data-module="${key}" ${id ? `id="${id}"` : ''} ${on ? 'checked' : ''} aria-label="Enable ${key}"><span class="track"></span></label>`;
  const chip = (tone, text) => `<span class="status-chip ${tone}"><span class="dot"></span>${text}</span>`;
  const channelName = (id) => { const c = id ? channels.find(x => x.id === id) : null; return c ? '#' + c.name : null; };
  const channelOptions = (selected, emptyLabel) =>
    `<option value="">${emptyLabel}</option>` + channels.map(c => `<option value="${c.id}" ${selected === c.id ? 'selected' : ''}>#${esc(c.name)}</option>`).join('');
  function esc(s) { return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]); }
  const hpe = config.honeypotEmbed || {};
  const we = welcome.embedConfig || {};
%>
    <!-- WELCOME -->
    <div class="tab-panel hidden" id="tab-welcome">
      <div class="module-hero">
        <div class="hero-icon">👋</div>
        <div>
          <h1>Welcome Messages</h1>
          <p>Greet every new member automatically with a message, an embed, or both.</p>
          <div class="hero-status">
            <%- channelName(welcome.channelId) ? chip('good', 'Posting in ' + esc(channelName(welcome.channelId))) : chip('warn', 'No channel picked') %>
          </div>
        </div>
        <div class="hero-toggle"><span class="muted" style="font-size:0.85rem;">Enabled</span><%- moduleToggle('welcome', welcome.enabled, 'wEnabled') %></div>
      </div>

      <div class="split">
        <div>
          <div class="subtabs" data-subtabs>
            <button class="active" data-sub="w-message">✉️ Message</button>
            <button data-sub="w-embed">🧩 Embed</button>
          </div>

          <div class="subpage" data-page="w-message">
            <div class="card settings-card">
              <div class="setting-row">
                <div><div class="setting-title">Channel</div><div class="setting-help">Where new members are greeted.</div></div>
                <div class="setting-control"><select id="wChannel" onchange="renderWelcomePreview()"><%- channelOptions(welcome.channelId, '— Select a channel —') %></select></div>
              </div>
              <div class="setting-row stack">
                <div><div class="setting-title">Message text</div><div class="setting-help">Type <code>@</code>, <code>#</code> or <code>:</code> to insert members, roles, channels and emoji. Click a placeholder to insert it.</div></div>
                <textarea id="wContent" maxlength="2000" rows="4" placeholder="Welcome to {server}, {user}!"><%= welcome.messageContent || '' %></textarea>
                <div class="chip-row" aria-label="Insert placeholder">
                  <button type="button" class="chip" data-insert="{user}" title="Mentions the new member">{user}</button>
                  <button type="button" class="chip" data-insert="{username}" title="Their username">{username}</button>
                  <button type="button" class="chip" data-insert="{server}" title="Server name">{server}</button>
                  <button type="button" class="chip" data-insert="{membercount}" title="Member count after they joined">{membercount}</button>
                </div>
              </div>
            </div>
          </div>

          <div class="subpage hidden" data-page="w-embed">
            <div class="card settings-card">
              <div class="setting-row">
                <div><div class="setting-title">Include a rich embed</div><div class="setting-help">Shown under the message text.</div></div>
                <div class="setting-control"><label class="switch"><input type="checkbox" id="wEmbedEnabled" <%= welcome.embedEnabled ? 'checked' : '' %> onchange="toggleWelcomeEmbed()"><span class="track"></span></label></div>
              </div>
              <div id="wEmbedFields" class="subpanel <%= welcome.embedEnabled ? '' : 'disabled' %>" style="border:none; margin:0; padding:0;">
                <div class="setting-row">
                  <div><div class="setting-title">Title & color</div></div>
                  <div class="setting-control">
                    <input id="wTitle" maxlength="256" value="<%= we.title || '' %>" placeholder="Welcome, {username}!">
                    <input id="wColor" type="color" value="<%= we.color || '#5865F2' %>" oninput="renderWelcomePreview()" style="flex:0 0 64px; min-width:64px;">
                  </div>
                </div>
                <div class="setting-row stack">
                  <div class="setting-title">Description</div>
                  <textarea id="wDesc" maxlength="4096" rows="4" placeholder="Grab your roles in #roles and say hi!"><%= we.description || '' %></textarea>
                </div>
                <div class="setting-row">
                  <div><div class="setting-title">Images</div><div class="setting-help">Use <code>{avatar}</code> as the thumbnail to show the new member's avatar.</div></div>
                  <div class="setting-control">
                    <input id="wImage" value="<%= we.imageUrl || '' %>" placeholder="Image https://…" oninput="renderWelcomePreview()">
                    <input id="wThumb" value="<%= we.thumbnailUrl || '' %>" placeholder="Thumbnail or {avatar}" oninput="renderWelcomePreview()">
                  </div>
                </div>
                <div class="setting-row stack">
                  <div class="setting-title">Footer</div>
                  <input id="wFooter" maxlength="2048" value="<%= we.footer || '' %>" placeholder="You are member #{membercount}">
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="sticky-preview">
          <div class="card" style="margin-bottom:0;">
            <h3 style="margin-top:0;">Live preview</h3>
            <div class="discord-chat">
              <div class="channel-name" id="wpChannel"># welcome</div>
              <div class="discord-message-preview">
                <img class="discord-avatar" src="<%= bot.avatarUrl %>" alt="">
                <div class="discord-message-body">
                  <div class="discord-message-header">
                    <span class="discord-bot-name"><%= bot.name %></span>
                    <span class="discord-bot-badge">BOT</span>
                    <span class="discord-message-time">Today at 12:00 PM</span>
                  </div>
                  <div class="desc" id="wpContent"></div>
                  <div class="discord-embed-preview" id="wpEmbed" style="margin-top:0.4rem; display:none;">
                    <img id="wpThumb" alt="" style="float:right; width:72px; height:72px; object-fit:cover; margin:0 0 0.5rem 0.75rem; display:none;">
                    <div class="title" id="wpTitle"></div>
                    <div class="desc" id="wpDesc"></div>
                    <img id="wpImage" alt="" style="display:none;">
                    <div id="wpFooter" style="margin-top:0.5rem; font-size:0.75rem; color:#949ba4;"></div>
                  </div>
                </div>
              </div>
            </div>
            <p class="muted" style="font-size:0.78rem; margin:0.75rem 0 0;">Previewed as if <strong><%= viewer.username %></strong> just joined. Only the new member is pinged.</p>
          </div>
        </div>
      </div>

      <div class="savebar">
        <span class="hint">“Send test” posts the current form to the channel, using you as the new member.</span>
        <% if (can('embed')) { %><a class="btn secondary" href="/dashboard/<%= guild.id %>/embed?welcome=1">🖌️ Design in Embed Builder</a><% } %>
        <button class="btn secondary" onclick="testWelcome()">📨 Send test</button>
        <button class="btn" onclick="saveWelcome()">Save changes</button>
      </div>
    </div>

    <!-- HONEYPOT -->
    <div class="tab-panel hidden" id="tab-honeypot">
      <div class="module-hero">
        <div class="hero-icon green">🍯</div>
        <div>
          <h1>Honeypot</h1>
          <p>A trap channel real members never post in. Anyone who does is removed instantly — usually raid bots and hacked accounts.</p>
          <div class="hero-status">
            <%- channelName(config.honeypotChannelId) ? chip('good', 'Armed in ' + esc(channelName(config.honeypotChannelId))) : chip('warn', 'No trap channel yet') %>
            <%- chip('', 'Action: ' + ({ kick: 'Kick', softban: 'Soft ban', ban: 'Ban' }[config.honeypotAction || 'kick'])) %>
            <%- config.honeypotDmEnabled === false ? chip('', 'No DM') : chip('good', 'DMs caught members') %>
          </div>
        </div>
        <div class="hero-toggle"><span class="muted" style="font-size:0.85rem;">Enabled</span><%- moduleToggle('honeypot', config.honeypotEnabled !== false, null) %></div>
      </div>

      <div class="mini-stats">
        <div class="mini-stat"><div class="value"><%= (config.honeypotKicks || 0) + (config.honeypotSoftbans || 0) + (config.honeypotBans || 0) %></div><div class="label">Total catches</div></div>
        <div class="mini-stat"><div class="value"><%= config.honeypotKicks || 0 %></div><div class="label">Kicks</div></div>
        <div class="mini-stat"><div class="value"><%= config.honeypotSoftbans || 0 %></div><div class="label">Soft bans</div></div>
        <div class="mini-stat"><div class="value"><%= config.honeypotBans || 0 %></div><div class="label">Bans</div></div>
      </div>

      <div class="subtabs" data-subtabs>
        <button class="active" data-sub="hp-setup">⚙️ Setup</button>
        <button data-sub="hp-message">🪤 Trap message</button>
        <button data-sub="hp-dm">✉️ Member DM</button>
      </div>

      <div class="subpage" data-page="hp-setup">
        <div class="card settings-card">
          <div class="setting-row">
            <div><div class="setting-title">Trap channel</div><div class="setting-help">Changing it posts a fresh trap message in the new channel.</div></div>
            <div class="setting-control"><select id="hpChannel"><%- channelOptions(config.honeypotChannelId, '— Select a channel —') %></select></div>
          </div>
          <div class="setting-row stack">
            <div><div class="setting-title">Punishment</div><div class="setting-help">What happens to anyone who posts in the trap.</div></div>
            <div class="radio-cards">
              <% [['kick', 'Kick', 'Removed, can rejoin with an invite.'], ['softban', 'Soft ban', 'Banned & unbanned — deletes their last 24h of messages.'], ['ban', 'Permanent ban', 'Removed for good until unbanned.']].forEach(([v, t, d]) => { %>
                <label class="radio-card"><input type="radio" name="hpAction" value="<%= v %>" <%= (config.honeypotAction || 'kick') === v ? 'checked' : '' %>><span class="rc-body"><span class="rc-title"><%= t %></span><span class="rc-desc" style="display:block;"><%= d %></span></span></label>
              <% }) %>
            </div>
          </div>
        </div>
      </div>

      <div class="subpage hidden" data-page="hp-message">
        <div class="split">
          <div class="card settings-card">
            <div class="setting-row stack">
              <div><div class="setting-title">Disguise the trap</div><div class="setting-help">Blank fields use the default shown as the placeholder. Type <code>@</code> or <code>#</code> to insert mentions.</div></div>
            </div>
            <div class="setting-row">
              <div class="setting-title">Title & color</div>
              <div class="setting-control">
                <input type="text" id="hpTitle" maxlength="256" placeholder="<%= defaultTrapEmbed.title %>" value="<%= hpe.title || '' %>">
                <input type="color" id="hpColor" value="<%= hpe.color || defaultTrapEmbed.color %>" oninput="renderHpPreview()" style="flex:0 0 64px; min-width:64px;">
              </div>
            </div>
            <div class="setting-row stack">
              <div class="setting-title">Description</div>
              <textarea id="hpDesc" rows="4" maxlength="4000" placeholder="<%= defaultTrapEmbed.description %>"><%= hpe.description || '' %></textarea>
            </div>
            <div class="setting-row stack">
              <div class="setting-title">Footer</div>
              <input type="text" id="hpFooter" maxlength="2048" placeholder="<%= defaultTrapEmbed.footer %>" value="<%= hpe.footer || '' %>">
            </div>
            <div class="setting-row">
              <div class="setting-title">Images</div>
              <div class="setting-control">
                <input type="text" id="hpImage" placeholder="Image https://…" value="<%= hpe.imageUrl || '' %>" oninput="renderHpPreview()">
                <input type="text" id="hpThumb" placeholder="Thumbnail https://…" value="<%= hpe.thumbnailUrl || '' %>" oninput="renderHpPreview()">
              </div>
            </div>
            <div class="setting-row">
              <div><div class="setting-title">Show counters</div><div class="setting-help">Turn off to make the trap look like a normal channel.</div></div>
              <div class="setting-control"><label class="switch"><input type="checkbox" id="hpShowCounts" <%= hpe.showCounts === false ? '' : 'checked' %> onchange="renderHpPreview()"><span class="track"></span></label></div>
            </div>
          </div>
          <div class="sticky-preview">
            <div class="card" style="margin-bottom:0;">
              <h3 style="margin-top:0;">Preview</h3>
              <div class="discord-chat"><div class="discord-embed-preview" id="hpPreview"></div></div>
            </div>
          </div>
        </div>
      </div>

      <div class="subpage hidden" data-page="hp-dm">
        <div class="split">
          <div class="card settings-card">
            <div class="setting-row">
              <div><div class="setting-title">DM caught members</div><div class="setting-help">Sent just before the punishment, explaining what happened, the likely cause (a compromised account or bot) and how to secure their account.</div></div>
              <div class="setting-control"><label class="switch"><input type="checkbox" id="hpDm" <%= config.honeypotDmEnabled === false ? '' : 'checked' %>><span class="track"></span></label></div>
            </div>
            <div class="setting-row stack">
              <div class="setting-help">The punishment line follows the Setup tab's choice. Members with DMs closed are still punished — they just don't get the message.</div>
            </div>
          </div>
          <div class="sticky-preview">
            <div class="card" style="margin-bottom:0;">
              <h3 style="margin-top:0;">What they receive</h3>
              <div class="discord-chat">
                <div class="discord-embed-preview" id="hpDmPreview" style="border-left-color:#ED4245;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="savebar">
        <span class="hint">Changes apply to the live trap message immediately.</span>
        <button class="btn" onclick="saveHoneypot()">Save changes</button>
      </div>
    </div>

    <!-- LEVELING -->
    <div class="tab-panel hidden" id="tab-leveling">
      <div class="module-hero">
        <div class="hero-icon yellow">📈</div>
        <div>
          <h1>Leveling</h1>
          <p>Members earn XP for chatting, level up, and unlock role rewards.</p>
          <div class="hero-status">
            <%- chip('', levelStats.ranked.toLocaleString() + ' ranked members') %>
            <%- chip('', 'Top level ' + levelStats.topLevel) %>
            <%- chip('', effectiveXp.xpMin + '–' + effectiveXp.xpMax + ' XP / message') %>
          </div>
        </div>
        <div class="hero-toggle"><span class="muted" style="font-size:0.85rem;">XP gain</span><%- moduleToggle('leveling', config.levelingEnabled !== false, 'lvlEnabled') %></div>
      </div>

      <div class="subtabs" data-subtabs>
        <button class="active" data-sub="lv-xp">⚡ XP & speed</button>
        <button data-sub="lv-rewards">🏅 Role rewards</button>
        <button data-sub="lv-mult">✖️ Multipliers</button>
        <button data-sub="lv-msg">📣 Level-up messages</button>
        <button data-sub="lv-colors">🎨 Level colors</button>
        <button data-sub="lv-daily">🔥 Daily streaks</button>
        <button data-sub="lv-cards">🪪 Rank cards</button>
      </div>

      <div class="subpage" data-page="lv-xp">
        <div class="card settings-card">
          <div class="setting-row">
            <div><div class="setting-title">XP per message</div><div class="setting-help">A random amount in this range, once per cooldown. Blank = default.</div></div>
            <div class="setting-control">
              <input type="number" id="xpMin" min="0" placeholder="Min <%= effectiveXp.xpMin %>" value="<%= config.xpMin ?? '' %>">
              <input type="number" id="xpMax" min="0" placeholder="Max <%= effectiveXp.xpMax %>" value="<%= config.xpMax ?? '' %>">
            </div>
          </div>
          <div class="setting-row">
            <div><div class="setting-title">Cooldown</div><div class="setting-help">Seconds between messages that earn XP — stops spam farming.</div></div>
            <div class="setting-control"><input type="number" id="xpCooldown" min="0" placeholder="<%= effectiveXp.cooldownMs / 1000 %> seconds" value="<%= config.xpCooldownSeconds ?? '' %>"></div>
          </div>
          <div class="setting-row">
            <div><div class="setting-title">Level curve</div><div class="setting-help">Higher = slower leveling. XP for level N ≈ base × N<sup>1.5</sup>.</div></div>
            <div class="setting-control"><input type="number" id="levelXpBase" min="1" placeholder="Base <%= effectiveXp.levelXpBase %>" value="<%= config.levelXpBase ?? '' %>"></div>
          </div>
        </div>
      </div>

      <div class="subpage hidden" data-page="lv-rewards">
        <div class="card">
          <div class="setting-title">Roles granted at levels</div>
          <div class="setting-help" style="margin-bottom:1rem;">Members keep earned roles even if they lose XP later.</div>
          <div id="levelRoleRows">
            <% (config.levelRoles || []).sort((a, b) => a.level - b.level).forEach(lr => {
                 const role = roles.find(r => r.id === lr.roleId);
            %>
              <div class="field-row level-role-row">
                <input type="number" min="1" class="lr-level" value="<%= lr.level %>" placeholder="Level" style="flex:0 0 110px;">
                <select class="lr-role">
                  <% roles.forEach(r => { %>
                    <option value="<%= r.id %>" <%= r.id === lr.roleId ? 'selected' : '' %>><%= r.name %><%= r.assignable ? '' : ' ⚠️ (bot cannot assign this)' %></option>
                  <% }) %>
                </select>
                <button class="btn secondary" type="button" onclick="this.parentElement.remove()">Remove</button>
              </div>
              <% if (role && !role.assignable) { %>
                <p class="muted" style="color:var(--c-yellow); margin-top:-0.3rem; font-size:0.8rem;">⚠️ LoofaryBot's role is below <%= role.name %> — move LoofaryBot's role higher in Server Settings → Roles.</p>
              <% } %>
            <% }) %>
          </div>
          <button class="btn secondary small" type="button" onclick="addLevelRoleRow()">+ Add role reward</button>
        </div>
      </div>

      <div class="subpage hidden" data-page="lv-mult">
        <div class="card">
          <div class="setting-title">XP multipliers</div>
          <div class="setting-help" style="margin-bottom:1rem;">Earned XP = base × channel multiplier × the member's best role multiplier. Use <strong>0</strong> to switch XP off in a channel (e.g. bot spam) or <strong>2</strong> for double XP (e.g. boosters).</div>
          <div id="multiplierRows"></div>
          <button class="btn secondary small" type="button" onclick="addMultiplierRow()">+ Add multiplier</button>
        </div>
      </div>

      <div class="subpage hidden" data-page="lv-msg">
        <div class="card settings-card">
          <div class="setting-row">
            <div><div class="setting-title">Where level-up messages go</div><div class="setting-help">Keep bot spam out of chat by sending them to one channel.</div></div>
            <div class="setting-control"><select id="levelUpChannel"><%- channelOptions(config.levelUpChannelId, 'Same channel the member was chatting in') %></select></div>
          </div>
          <% if (config.levelUpChannelId && !channels.find(c => c.id === config.levelUpChannelId)) { %>
            <div class="setting-row stack"><div class="setting-help" style="color:var(--c-yellow);">⚠️ The chosen channel no longer exists — messages are going to the same channel for now.</div></div>
          <% } %>
        </div>
      </div>

      <div class="subpage hidden" data-page="lv-colors">
        <div class="two-col">
          <div class="card settings-card">
            <div class="setting-row">
              <div><div class="setting-title">Level name colors</div><div class="setting-help">Members get a cosmetic color role for the highest tier they've reached, so their name color changes as they level up (and back down if they lose levels).</div></div>
              <div class="setting-control"><label class="switch"><input type="checkbox" id="lcEnabled" <%= levelColorSettings.enabled ? 'checked' : '' %>><span class="track"></span></label></div>
            </div>
            <div class="setting-row">
              <div><div class="setting-title">Tiers</div><div class="setting-help">A new color every N levels, up to a top tier.</div></div>
              <div class="setting-control">
                <span class="muted" style="font-size:0.8rem;">Every</span>
                <input type="number" id="lcInterval" min="1" max="1000" value="<%= levelColorSettings.interval %>" aria-label="New color every N levels" style="flex:0 0 80px; min-width:80px;">
                <span class="muted" style="font-size:0.8rem;">levels, up to level</span>
                <input type="number" id="lcMax" min="1" max="10000" value="<%= levelColorSettings.maxLevel %>" aria-label="Top tier level" style="flex:0 0 90px; min-width:90px;">
              </div>
            </div>
            <div class="setting-row stack">
              <div><div class="setting-title">Placement</div><div class="setting-help">Discord shows the color of a member's <em>highest</em> colored role.</div></div>
              <div class="radio-cards">
                <% [['low', 'Just above @everyone', 'Staff & other colored roles keep their color.'], ['high', 'As high as possible', 'The level color wins over other roles.'], ['above', 'Above a role', 'Sit directly above a role you pick.']].forEach(([v, t, d]) => { %>
                  <label class="radio-card"><input type="radio" name="lcPlacement" value="<%= v %>" <%= levelColorSettings.placement === v ? 'checked' : '' %>><span class="rc-body"><span class="rc-title"><%= t %></span><span class="rc-desc" style="display:block;"><%= d %></span></span></label>
                <% }) %>
              </div>
              <select id="lcAnchor" style="<%= levelColorSettings.placement === 'above' ? '' : 'display:none;' %>">
                <option value="">— Pick a role to sit above —</option>
                <% roles.forEach(r => { %><option value="<%= r.id %>" <%= levelColorSettings.anchorRoleId === r.id ? 'selected' : '' %>><%= r.name %></option><% }) %>
              </select>
            </div>
          </div>

          <div class="card">
            <h3 style="margin-top:0;">Apply to everyone</h3>
            <p class="muted" style="font-size:0.85rem;">New level-ups update colors automatically. <strong>Sync</strong> checks every member's current level and gives them the right color role — use it after turning colors on or changing tiers.</p>
            <button class="btn" id="lcSyncBtn" onclick="syncLevelColors()">🔄 Sync all members</button>
            <p class="muted" id="lcSyncResult" style="font-size:0.85rem; margin-top:0.75rem;"></p>
            <div class="subpanel">
              <p class="muted" style="font-size:0.8rem;">Remove every auto-created “Level N” role from the server (your custom roles are kept).</p>
              <button class="btn danger small" onclick="removeLevelColorRoles()">Delete auto roles</button>
            </div>
          </div>
        </div>

        <div class="card" style="margin-top:1.25rem;">
          <div class="setting-title">Tier roles</div>
          <div class="setting-help" style="margin-bottom:1rem;">“Auto” creates a <code>Level N</code> role the first time someone reaches that tier. Pick one of your roles to use it instead — members gain and lose it with their level.</div>
          <div id="lcTiers"></div>
        </div>
      </div>

      <% const dly = Object.assign({ enabled: true, baseXp: 50, bonusPerDay: 10, maxBonus: 200, milestoneEvery: 7, milestoneBonus: 250 }, (config.daily && (config.daily.toObject ? config.daily.toObject() : config.daily)) || {}); %>
      <div class="subpage hidden" data-page="lv-daily">
        <div class="two-col">
          <div class="card settings-card">
            <div class="setting-row">
              <div><div class="setting-title">/daily rewards</div><div class="setting-help">Members claim XP once per day (resets at midnight UTC). Consecutive days build a streak for bigger rewards; missing a day starts it over.</div></div>
              <div class="setting-control"><label class="switch"><input type="checkbox" id="dEnabled" <%= dly.enabled !== false ? 'checked' : '' %>><span class="track"></span></label></div>
            </div>
            <div class="setting-row">
              <div><div class="setting-title">Base reward</div><div class="setting-help">XP every claim.</div></div>
              <div class="setting-control"><input type="number" id="dBase" min="0" value="<%= dly.baseXp %>" class="daily-input"></div>
            </div>
            <div class="setting-row">
              <div><div class="setting-title">Streak bonus</div><div class="setting-help">Extra XP per streak day, up to a cap.</div></div>
              <div class="setting-control">
                <span class="muted" style="font-size:0.8rem;">+</span><input type="number" id="dBonus" min="0" value="<%= dly.bonusPerDay %>" class="daily-input" style="flex:0 0 90px; min-width:90px;">
                <span class="muted" style="font-size:0.8rem;">per day, max</span><input type="number" id="dMax" min="0" value="<%= dly.maxBonus %>" class="daily-input" style="flex:0 0 100px; min-width:100px;">
              </div>
            </div>
            <div class="setting-row">
              <div><div class="setting-title">Milestones</div><div class="setting-help">A one-off bonus every N days (0 = off).</div></div>
              <div class="setting-control">
                <span class="muted" style="font-size:0.8rem;">every</span><input type="number" id="dEvery" min="0" value="<%= dly.milestoneEvery %>" class="daily-input" style="flex:0 0 80px; min-width:80px;">
                <span class="muted" style="font-size:0.8rem;">days: +</span><input type="number" id="dMilestone" min="0" value="<%= dly.milestoneBonus %>" class="daily-input" style="flex:0 0 100px; min-width:100px;">
              </div>
            </div>
          </div>
          <div class="card">
            <h3 style="margin-top:0;">Reward by streak day</h3>
            <table class="payout-table" id="dailyTable"></table>
          </div>
        </div>
      </div>

      <div class="subpage hidden" data-page="lv-cards">
        <div class="card settings-card">
          <div class="setting-row">
            <div><div class="setting-title">Boosters only</div><div class="setting-help">When on, only Server Boosters (and admins) can use <code>/levels card</code> to set their rank card color, background and tagline. Same as <code>/levels cardaccess</code>.</div></div>
            <div class="setting-control"><label class="switch"><input type="checkbox" id="cardBoosterOnly" <%= config.rankCardBoosterOnly ? 'checked' : '' %>><span class="track"></span></label></div>
          </div>
        </div>
      </div>

      <div class="savebar">
        <span class="hint">Saves every leveling tab at once, including level colors.</span>
        <button class="btn" onclick="saveLevelsAll()">Save changes</button>
      </div>
    </div>

    <!-- AUTO-ROLE -->
    <div class="tab-panel hidden" id="tab-autorole">
      <div class="module-hero">
        <div class="hero-icon">🛡️</div>
        <div>
          <h1>Auto-Role</h1>
          <p>Give every new member a role the moment they join.</p>
          <div class="hero-status"><%- stats.autoRoleName ? chip('good', 'Grants @' + esc(stats.autoRoleName)) : chip('warn', 'No role picked') %></div>
        </div>
        <div class="hero-toggle"><span class="muted" style="font-size:0.85rem;">Enabled</span><%- moduleToggle('autorole', config.autoRoleEnabled !== false, 'arEnabled') %></div>
      </div>
      <div class="two-col">
        <div class="card">
          <h3 style="margin-top:0;">Role to grant</h3>
          <p class="muted" style="font-size:0.85rem;">LoofaryBot's own role must sit above this role in Server Settings → Roles.</p>
          <select id="arRole">
            <option value="">— None —</option>
            <% roles.forEach(r => { %>
              <option value="<%= r.id %>" <%= config.autoRoleId === r.id ? 'selected' : '' %>><%= r.name %><%= r.assignable ? '' : ' ⚠️ (bot cannot assign this)' %></option>
            <% }) %>
          </select>
          <button class="btn" style="margin-top:1rem;" onclick="saveAutoRole()">Save role</button>
        </div>
        <div class="card">
          <h3 style="margin-top:0;">Existing members</h3>
          <p class="muted" style="font-size:0.85rem;">Auto-role only applies to new joins. Sync gives the saved role to everyone already here who doesn't have it.</p>
