    // --- Daily streaks ---
    function readDaily() {
      const n = (id) => Number(document.getElementById(id).value) || 0;
      return { enabled: document.getElementById('dEnabled').checked, baseXp: n('dBase'), bonusPerDay: n('dBonus'), maxBonus: n('dMax'), milestoneEvery: n('dEvery'), milestoneBonus: n('dMilestone') };
    }
    function renderDailyTable() {
      const d = readDaily();
      const days = [1, 2, 3, 5, 7, 10, 14, 21, 30];
      const rows = days.map((day) => {
        const bonus = Math.min(d.bonusPerDay * (day - 1), d.maxBonus);
        const milestone = d.milestoneEvery > 0 && day % d.milestoneEvery === 0 ? d.milestoneBonus : 0;
        return `<tr><td>Day ${day}</td><td class="muted">${d.baseXp} + ${bonus}${milestone ? ` + 🏅${milestone}` : ''}</td><td>+${fmt(d.baseXp + bonus + milestone)} XP</td></tr>`;
      });
      document.getElementById('dailyTable').innerHTML = '<tr><th>Streak</th><th>Base + bonus</th><th style="text-align:right;">Reward</th></tr>' + rows.join('');
    }
    document.querySelectorAll('.daily-input').forEach((el) => el.addEventListener('input', renderDailyTable));
    renderDailyTable();

    // --- Go-live / upload alerts ---
    const alertState = { loaded: false, subs: [], twitch: false, defaults: {} };
    const aPlatform = () => (document.querySelector('input[name="aPlatform"]:checked') || {}).value || 'twitch';

    async function loadAlerts() {
      alertState.loaded = true;
      try {
        const res = await fetch(`/api/guilds/${guildId}/alerts`);
        const data = await res.json();
        alertState.subs = data.subscriptions || [];
        alertState.twitch = data.twitchConfigured;
        alertState.defaults = data.defaults || {};
        renderAlertList();
      } catch {
        document.getElementById('alertList').innerHTML = '<div class="card empty-state">❌ Failed to load alerts.</div>';
      }
    }

    function renderAlertList() {
      const subs = alertState.subs;
      document.getElementById('twitchSetupNote').style.display = alertState.twitch ? 'none' : '';
      document.getElementById('alertsStatus').innerHTML =
        `<span class="status-chip"><span class="dot"></span>${subs.length} followed</span>` +
        `<span class="status-chip ${alertState.twitch ? 'good' : 'warn'}"><span class="dot"></span>Twitch ${alertState.twitch ? 'connected' : 'needs setup'}</span>` +
        '<span class="status-chip good"><span class="dot"></span>YouTube ready</span>';
      const list = document.getElementById('alertList');
      if (!subs.length) {
        list.innerHTML = '<div class="card empty-state"><div class="big">📡</div>No alerts yet — add a Twitch or YouTube channel.</div>';
        return;
      }
      list.innerHTML = subs.map((sub) => {
        const ch = channels.find((c) => c.id === sub.channelId);
        const ping = sub.pingRoleId ? (sub.pingRoleId === guildId ? '@everyone' : '@' + ((roles.find((r) => r.id === sub.pingRoleId) || {}).name || 'deleted-role')) : 'no ping';
        return `<div class="card" style="padding:1rem 1.2rem; margin-bottom:0.9rem;">
          <div style="display:flex; align-items:center; gap:0.8rem; flex-wrap:wrap;">
            <div class="hero-icon ${sub.platform === 'twitch' ? '' : 'red'}" style="width:40px; height:40px; font-size:1.1rem;">${sub.platform === 'twitch' ? '🟣' : '🔴'}</div>
            <div style="min-width:0; flex:1;">
              <div style="font-weight:700;">${esc(sub.displayName)} ${sub.state && sub.state.live ? '<span class="status-chip off" style="margin-left:0.3rem;"><span class="dot"></span>LIVE</span>' : ''}</div>
              <div class="muted" style="font-size:0.8rem;">${sub.platform === 'twitch' ? 'Twitch go-live' : 'YouTube uploads'} → #${esc(ch ? ch.name : 'deleted-channel')} · ${esc(ping)}</div>
            </div>
            <label class="switch sm" title="Pause or resume this alert"><input type="checkbox" ${sub.enabled ? 'checked' : ''} onchange="toggleAlert('${sub._id}', this.checked)"><span class="track"></span></label>
            <button class="btn secondary small" onclick="openAlertEditor('${sub._id}')">Edit</button>
            <button class="btn secondary small" onclick="testAlert('${sub._id}')">Test</button>
            <button class="btn danger small" onclick="deleteAlert('${sub._id}')">Remove</button>
          </div>
        </div>`;
      }).join('');
    }

    function openAlertEditor(id = null) {
      const sub = id ? alertState.subs.find((s) => s._id === id) : null;
      document.getElementById('alertEditor').style.display = '';
      document.getElementById('alertEditorTitle').textContent = sub ? `Edit ${sub.displayName}` : 'New alert';
      document.getElementById('aId').value = sub ? sub._id : '';
      const platform = sub ? sub.platform : alertState.twitch ? 'twitch' : 'youtube';
      document.querySelector(`input[name="aPlatform"][value="${platform}"]`).checked = true;
      document.getElementById('aAccount').value = sub ? sub.displayName : '';
      document.getElementById('aChannel').value = sub ? sub.channelId : '';
      document.getElementById('aPing').value = sub ? sub.pingRoleId || '' : '';
      document.getElementById('aMessage').value = sub ? sub.message : '';
      const e = (sub && sub.embed) || {};
      document.getElementById('aEmbed').checked = e.enabled !== false;
      document.getElementById('aImage').checked = e.showImage !== false;
      document.getElementById('aTitle').value = e.title || '';
      document.getElementById('aDesc').value = e.description || '';
      applyPlatformDefaults(!sub, e.color);
      document.getElementById('alertEditor').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function closeAlertEditor() {
      document.getElementById('alertEditor').style.display = 'none';
    }
    // Placeholders show the platform's default text; the color picker starts at the platform color.
    function applyPlatformDefaults(resetColor = true, color = '') {
      const p = aPlatform();
      const d = alertState.defaults[p] || {};
      document.getElementById('aMessage').placeholder = d.message || '';
      document.getElementById('aTitle').placeholder = `Title (default: ${d.title || ''})`;
      document.getElementById('aDesc').placeholder = `Description (default: ${(d.description || '').replace(/\n/g, ' ')})`;
      document.getElementById('aAccountHelp').textContent = p === 'twitch' ? 'Twitch username or twitch.tv link' : 'YouTube @handle, channel link, or channel ID';
      document.getElementById('aAccount').placeholder = p === 'twitch' ? 'e.g. loofary' : 'e.g. @loofary';
      if (resetColor || !color) document.getElementById('aColor').value = (color || d.color || '#5865F2');
      else document.getElementById('aColor').value = color;
      renderAlertPreview();
    }
    document.querySelectorAll('input[name="aPlatform"]').forEach((r) => r.addEventListener('change', () => applyPlatformDefaults(true)));
    ['aMessage', 'aTitle', 'aDesc', 'aAccount', 'aColor', 'aEmbed', 'aImage', 'aPing', 'aChannel'].forEach((id) =>
      document.getElementById(id).addEventListener(['aEmbed', 'aImage', 'aPing', 'aChannel'].includes(id) ? 'change' : 'input', renderAlertPreview)
    );

    function renderAlertPreview() {
      const p = aPlatform();
      const d = alertState.defaults[p] || {};
      const name = document.getElementById('aAccount').value.replace(/^@/, '').trim() || (p === 'twitch' ? 'loofary' : 'Loofary');
      const vars = p === 'twitch'
        ? { name, title: 'Ranked grind + chill vibes', game: 'Valorant', url: `https://twitch.tv/${name.toLowerCase()}` }
        : { name, title: 'I built a Discord bot', game: '', url: 'https://youtube.com/watch?v=dQw4w9WgXcQ' };
      const fillVars = (t) => String(t || '').replace(/\{(name|title|url|game)\}/gi, (m) => vars[m.slice(1, -1).toLowerCase()] ?? '');
      const pingId = document.getElementById('aPing').value;
      const ping = pingId ? `<span class="mention-pill">@${esc(pingId === guildId ? 'everyone' : ((roles.find((r) => r.id === pingId) || {}).name || 'role'))}</span> ` : '';
      document.getElementById('apContent').innerHTML = ping + LoofMentions.markdown(esc(fillVars(document.getElementById('aMessage').value || d.message)));
      const ch = channels.find((c) => c.id === document.getElementById('aChannel').value);
      document.getElementById('apChannel').textContent = `# ${ch ? ch.name : 'alerts'}`;
      const embedOn = document.getElementById('aEmbed').checked;
      const emb = document.getElementById('apEmbed');
      emb.style.display = embedOn ? '' : 'none';
      emb.style.borderLeftColor = document.getElementById('aColor').value;
      document.getElementById('apAuthor').textContent = name;
      document.getElementById('apTitle').textContent = fillVars(document.getElementById('aTitle').value || d.title);
      document.getElementById('apDesc').innerHTML = LoofMentions.markdown(esc(fillVars(document.getElementById('aDesc').value || d.description)));
      document.getElementById('apImage').style.display = document.getElementById('aImage').checked ? 'flex' : 'none';
      document.getElementById('apButton').textContent = p === 'twitch' ? 'Watch stream' : 'Watch video';
    }

    async function saveAlert() {
      const id = document.getElementById('aId').value;
      const existing = id ? alertState.subs.find((s) => s._id === id) : null;
      const accountInput = document.getElementById('aAccount').value.trim();
      const body = {
        id: id || undefined,
        platform: aPlatform(),
        // Unchanged name on edit → keep the resolved account instead of re-resolving it.
        account: existing && accountInput === existing.displayName ? existing.account : accountInput,
        channelId: document.getElementById('aChannel').value,
        pingRoleId: document.getElementById('aPing').value || null,
        message: document.getElementById('aMessage').value,
        embed: {
          enabled: document.getElementById('aEmbed').checked,
          showImage: document.getElementById('aImage').checked,
          title: document.getElementById('aTitle').value,
          description: document.getElementById('aDesc').value,
          color: document.getElementById('aColor').value
        }
      };
      if (!body.account) return showToast('❌ Enter the channel to follow.');
      const btn = document.getElementById('aSaveBtn');
      btn.disabled = true;
      try {
        const res = await fetch(`/api/guilds/${guildId}/alerts`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Failed to save.');
        showToast(`✅ Following ${data.subscription.displayName}.`);
        closeAlertEditor();
        await loadAlerts();
      } catch (err) {
        showToast(`❌ ${err.message}`);
      } finally {
        btn.disabled = false;
      }
    }
    async function toggleAlert(id, enabled) {
      const sub = alertState.subs.find((s) => s._id === id);
      const res = await fetch(`/api/guilds/${guildId}/alerts`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...sub, id, enabled }) });
      showToast(res.ok ? (enabled ? '▶️ Alert resumed.' : '⏸️ Alert paused.') : '❌ Failed to update.');
      if (res.ok) sub.enabled = enabled;
    }
    async function testAlert(id) {
      const res = await fetch(`/api/guilds/${guildId}/alerts/${id}/test`, { method: 'POST' });
      const data = await res.json().catch(() => ({}));
      showToast(res.ok ? '🧪 Test alert posted (no one was pinged).' : `❌ ${data.error || 'Failed.'}`);
    }
    async function deleteAlert(id) {
      const sub = alertState.subs.find((s) => s._id === id);
      if (!confirm(`Stop following ${sub ? sub.displayName : 'this channel'}?`)) return;
      const res = await fetch(`/api/guilds/${guildId}/alerts/${id}`, { method: 'DELETE' });
      showToast(res.ok ? '🗑️ Alert removed.' : '❌ Failed to remove.');
      if (res.ok) loadAlerts();
    }

    // --- Server settings (admin only — the page isn't rendered for moderators) ---
    const auditState = { page: 1, loaded: false };
    const hasSettings = !!document.getElementById('tab-settings');

    async function saveModAccess() {
      const modRoleIds = [...document.querySelectorAll('.mod-role:checked')].map((el) => el.value);
      const modPages = [...document.querySelectorAll('.mod-page:checked')].map((el) => el.value);
      postJson('settings/access', { modRoleIds, modPages }, '✅ Moderator access saved.');
    }
    function saveAlertsChannel() {
      postJson('settings/alerts-channel', { channelId: document.getElementById('alertsChannel').value || null }, '✅ Bot alerts channel saved.');
    }
    if (hasSettings) {
      document.getElementById('modRoleFilter').addEventListener('input', (ev) => {
        const q = ev.target.value.trim().toLowerCase();
        document.querySelectorAll('#modRoleList label').forEach((l) => (l.style.display = !q || l.dataset.name.includes(q) ? '' : 'none'));
      });
      document.getElementById('auditSection').addEventListener('change', () => loadAudit(1));
      document.getElementById('importFile').addEventListener('change', previewImport);
    }

    async function loadAudit(page = 1) {
      const list = document.getElementById('auditList');
      const params = new URLSearchParams({ page: Math.max(1, page), section: document.getElementById('auditSection').value });
      try {
        const res = await fetch(`/api/guilds/${guildId}/audit?${params}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to load.');
        auditState.page = data.page;
        document.getElementById('auditPageLabel').textContent = `Page ${data.page} of ${data.totalPages} · ${fmt(data.total)} change(s)`;
        document.getElementById('auditPrev').disabled = data.page <= 1;
        document.getElementById('auditNext').disabled = data.page >= data.totalPages;
        list.innerHTML = data.entries.length
          ? data.entries.map((e) => `<div class="log-row">
              ${e.avatarUrl ? `<img src="${esc(e.avatarUrl)}" alt="">` : '<div class="log-avatar"></div>'}
              <div style="min-width:0;">
                <div class="log-head"><strong>${esc(e.username || e.userId)}</strong>${e.role === 'mod' ? '<span class="log-type roles">Moderator</span>' : ''}<span class="log-type voice">${esc(e.section)}</span></div>
                <div style="font-size:0.9rem; margin-top:0.15rem;">${esc(e.action)}</div>
                ${e.detail ? `<div class="log-summary">${esc(e.detail)}</div>` : ''}
              </div>
              <div class="log-meta" title="${esc(new Date(e.createdAt).toLocaleString())}">${relTime(e.createdAt)}</div>
            </div>`).join('')
          : '<div class="empty-state"><div class="big">🕘</div>No dashboard changes recorded yet.</div>';
      } catch (err) {
        list.innerHTML = `<div class="empty-state">❌ ${esc(err.message)}</div>`;
      }
    }

    const REASONS = { daily: 'Daily (automatic)', manual: 'Manual', 'before-import': 'Before an import', 'before-restore': 'Before a restore' };
    async function loadBackups() {
      const list = document.getElementById('backupList');
      try {
        const res = await fetch(`/api/guilds/${guildId}/backups`);
        const data = await res.json();
        list.innerHTML = data.backups.length
          ? data.backups.map((b) => `<div class="log-row" style="grid-template-columns: minmax(0,1fr) auto;">
              <div>
                <div class="log-head"><strong>${esc(new Date(b.createdAt).toLocaleString())}</strong><span class="log-type ${b.reason === 'daily' ? 'voice' : 'messageEdit'}">${esc(REASONS[b.reason] || b.reason)}</span></div>
                <div class="log-summary">${b.memberCount ? `${fmt(b.memberCount)} members' XP · ` : ''}${(b.sizeBytes / 1024).toFixed(1)} KB${b.createdBy ? ` · by ${esc(b.createdBy)}` : ''}</div>
              </div>
              <div class="log-meta" style="display:flex; gap:0.4rem; align-items:center;">
                <a class="btn secondary small" href="/api/guilds/${guildId}/backups/${b._id}/download">⬇️</a>
                <button class="btn secondary small" onclick="restoreBackup('${b._id}', ${b.memberCount > 0})">Restore</button>
              </div>
            </div>`).join('')
          : '<div class="empty-state"><div class="big">💾</div>No backups yet — the first automatic one runs shortly after the bot starts.</div>';
      } catch {
        list.innerHTML = '<div class="empty-state">❌ Failed to load backups.</div>';
      }
    }
    async function createBackup() {
      const res = await fetch(`/api/guilds/${guildId}/backups`, { method: 'POST' });
      showToast(res.ok ? '💾 Backup created.' : '❌ Backup failed.');
      if (res.ok) loadBackups();
    }
    async function restoreBackup(id, hasXp) {
      if (!confirm('Restore this backup? Current settings are replaced (a safety backup is taken first).')) return;
      const includeXp = hasXp && confirm('Also restore members\' XP from this backup? Choose Cancel to keep everyone\'s current XP.');
      const res = await fetch(`/api/guilds/${guildId}/backups/${id}/restore`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ includeXp }) });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) return showToast(`❌ ${data.error || 'Restore failed.'}`);
      showToast('✅ Backup restored — reloading…');
      setTimeout(() => location.reload(), 1200);
    }
    function exportSettings() {
      location.href = `/api/guilds/${guildId}/export${document.getElementById('exportXp').checked ? '?xp=1' : ''}`;
    }

    let importPayload = null;
    async function previewImport(ev) {
      const box = document.getElementById('importPreview');
      importPayload = null;
      const file = ev.target.files[0];
      if (!file) return (box.innerHTML = '');
      try {
        importPayload = JSON.parse(await file.text());
        const res = await fetch(`/api/guilds/${guildId}/import/preview`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ payload: importPayload }) });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Invalid file.');
        const s = data.summary;
        box.innerHTML = `<div class="log-content">
          <strong>${esc(s.guildName)}</strong> · exported ${s.exportedAt ? esc(new Date(s.exportedAt).toLocaleString()) : 'unknown date'}<br>
          <span class="muted">${[s.hasSettings && 'module settings', s.hasWelcome && 'welcome', s.alerts && `${s.alerts} alert(s)`, s.embedTemplates && `${s.embedTemplates} embed template(s)`, s.members && `${fmt(s.members)} members' XP`].filter(Boolean).join(' · ')}</span>
          ${s.crossServer ? '<br><span style="color:var(--c-yellow);">⚠️ This file is from a different server — channel and role picks won\'t match here and will need re-selecting.</span>' : ''}
        </div>
        ${s.members ? '<label style="display:flex; align-items:center; gap:0.5rem; font-weight:500; color:var(--text-main);"><input type="checkbox" id="importXp" style="width:auto;"> Also import members\' XP (overwrites current XP)</label>' : ''}
        <button class="btn danger" style="margin-top:0.6rem;" onclick="runImport()">Import & replace current settings</button>`;
      } catch (err) {
        box.innerHTML = `<div class="log-content">❌ ${esc(err.message)}</div>`;
      }
    }
    async function runImport() {
      if (!importPayload || !confirm('Replace this server\'s LoofaryBot settings with the file? A backup is taken first.')) return;
      const includeXp = !!(document.getElementById('importXp') && document.getElementById('importXp').checked);
      const res = await fetch(`/api/guilds/${guildId}/import`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ payload: importPayload, includeXp }) });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) return showToast(`❌ ${data.error || 'Import failed.'}`);
      showToast('✅ Settings imported — reloading…');
      setTimeout(() => location.reload(), 1200);
    }

    // --- Level color tiers ---
    const LC_PALETTE = <%- JSON.stringify(levelColorPalette) %>;
    const lcStored = new Map(<%- JSON.stringify(levelColorTiers.map((t) => [t.level, t])).replace(/</g, '\\u003c') %>);
    const assignableRoles = roles.filter((r) => r.assignable);

    function lcLevels() {
      const every = Math.max(1, parseInt(document.getElementById('lcInterval').value, 10) || 5);
      const max = Math.max(every, parseInt(document.getElementById('lcMax').value, 10) || 100);
      const out = [];
      for (let l = every; l <= max && out.length < 50; l += every) out.push(l);
      return { every, levels: out };
    }
    function lcDefaultColor(level, every, levels) {
      if (level === levels[levels.length - 1]) return '#FFD700';
      return LC_PALETTE[Math.max(0, Math.round(level / every) - 1) % (LC_PALETTE.length - 1)];
    }

    let lcRendered = null; // tier layout currently on screen, to tell real color edits from defaults

    // Remember in-progress edits when tiers are re-rendered (e.g. after changing the interval).
    function lcCaptureEdits() {
      if (!lcRendered) return;
      document.querySelectorAll('.lc-row').forEach((row) => {
        const level = Number(row.dataset.level);
        const roleId = row.querySelector('.lc-role').value;
        const color = row.querySelector('.lc-color').value;
        const prev = lcStored.get(level) || { level };
        const shownDefault = lcDefaultColor(level, lcRendered.every, lcRendered.levels);
        const storedColor = prev.custom ? null : prev.color;
        // Only a color that differs from what was on screen by default counts as the admin's pick.
        const picked = color.toLowerCase() !== (storedColor || shownDefault).toLowerCase() ? color : storedColor && storedColor.toLowerCase() !== shownDefault.toLowerCase() ? storedColor : null;
        lcStored.set(level, { ...prev, custom: !!roleId, roleId: roleId || (prev.custom ? null : prev.roleId), color: picked, editedColor: picked });
      });
    }

    function renderLcTiers(capture = true) {
      if (capture) lcCaptureEdits();
      const { every, levels } = lcLevels();
      lcRendered = { every, levels };
      const container = document.getElementById('lcTiers');
      container.innerHTML = levels.map((level) => {
        const t = lcStored.get(level) || {};
        const custom = t.custom && t.roleId;
        const customRole = custom ? roles.find((r) => r.id === t.roleId) : null;
        const color = t.editedColor || (custom ? t.color : t.color) || lcDefaultColor(level, every, levels);
        const options = ['<option value="">Auto — “Level ' + level + '” role</option>']
          .concat(assignableRoles.map((r) => `<option value="${esc(r.id)}" ${custom && r.id === t.roleId ? 'selected' : ''}>@${esc(r.name)}</option>`))
          .join('');
        return `<div class="field-row lc-row" data-level="${level}" style="align-items:center;">
          <span class="status-chip" style="flex:0 0 86px; justify-content:center;">Lv ${level}+</span>
          <span class="lc-preview" style="flex:0 0 150px; font-weight:700; color:${esc(color)}; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${esc(viewer.username)}</span>
          <select class="lc-role">${options}</select>
          <input type="color" class="lc-color" value="${esc(color)}" style="flex:0 0 64px; min-width:64px;" ${custom ? 'disabled title="Custom roles keep their own color"' : ''}>
          <span class="muted" style="flex:0 0 110px; font-size:0.75rem;">${custom ? (customRole ? 'your role' : '⚠️ role missing') : t.roleId ? 'created' : 'created when reached'}</span>
        </div>`;
      }).join('');
      container.querySelectorAll('.lc-row').forEach((row) => {
        const colorInput = row.querySelector('.lc-color');
        const preview = row.querySelector('.lc-preview');
        colorInput.addEventListener('input', () => (preview.style.color = colorInput.value));
        row.querySelector('.lc-role').addEventListener('change', () => renderLcTiers());
      });
    }
    ['lcInterval', 'lcMax'].forEach((id) => document.getElementById(id).addEventListener('change', () => renderLcTiers()));
    document.querySelectorAll('input[name="lcPlacement"]').forEach((r) =>
      r.addEventListener('change', () => (document.getElementById('lcAnchor').style.display = r.value === 'above' && r.checked ? '' : 'none'))
    );

    function readLevelColors() {
      const { every, levels } = lcLevels();
      return {
        enabled: document.getElementById('lcEnabled').checked,
        interval: every,
        maxLevel: parseInt(document.getElementById('lcMax').value, 10) || 100,
        placement: (document.querySelector('input[name="lcPlacement"]:checked') || {}).value || 'low',
        anchorRoleId: document.getElementById('lcAnchor').value || null,
        tiers: [...document.querySelectorAll('.lc-row')].map((row) => {
          const level = Number(row.dataset.level);
          const roleId = row.querySelector('.lc-role').value || null;
          const color = row.querySelector('.lc-color').value;
          // Only send a color override when it differs from the palette default.
          return { level, roleId, color: roleId || color.toLowerCase() === lcDefaultColor(level, every, levels).toLowerCase() ? null : color };
        })
      };
    }

    async function saveLevelColors({ quiet = false } = {}) {
      const res = await fetch(`/api/guilds/${guildId}/levelcolors`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(readLevelColors())
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Failed to save level colors.');
      lcStored.clear();
      (data.tiers || []).forEach((t) => lcStored.set(t.level, t));
      renderLcTiers(false);
      if (!quiet) showToast('✅ Level colors saved.');
    }

    async function syncLevelColors() {
      const btn = document.getElementById('lcSyncBtn');
      const out = document.getElementById('lcSyncResult');
      btn.disabled = true;
      out.textContent = 'Saving settings and syncing every member… this can take a minute on big servers.';
      try {
        await saveLevelColors({ quiet: true });
        const res = await fetch(`/api/guilds/${guildId}/levelcolors/sync`, { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Sync failed.');
        out.textContent = `✅ Checked ${fmt(data.scanned)} members · ${fmt(data.updated)} updated · ${data.tiersInUse} tier(s) in use.${data.failed ? ` ⚠️ ${data.failed} failed (role hierarchy?).` : ''}`;
        const r2 = await fetch(`/api/guilds/${guildId}/levelcolors`);
        const d2 = await r2.json().catch(() => ({}));
        if (r2.ok) { lcStored.clear(); (d2.tiers || []).forEach((t) => lcStored.set(t.level, t)); renderLcTiers(false); }
      } catch (err) {
        out.textContent = `❌ ${err.message}`;
      } finally {
        btn.disabled = false;
      }
    }

    async function removeLevelColorRoles() {
      if (!confirm('Delete every auto-created "Level N" color role from this server? Custom roles are kept.')) return;
      const res = await fetch(`/api/guilds/${guildId}/levelcolors/remove-auto`, { method: 'POST' });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) return showToast(`❌ ${data.error || 'Failed.'}`);
      lcStored.forEach((t, level) => { if (!t.custom) lcStored.set(level, { level }); });
      renderLcTiers(false);
      showToast(`🗑️ Deleted ${data.deleted} role(s).`);
    }
    renderLcTiers(false);

    // --- Sub-tabs inside module pages ---
    document.querySelectorAll('[data-subtabs]').forEach((bar) => {
      const panel = bar.closest('.tab-panel');
      bar.querySelectorAll('button').forEach((btn) =>
        btn.addEventListener('click', () => {
          bar.querySelectorAll('button').forEach((b) => b.classList.toggle('active', b === btn));
          panel.querySelectorAll('.subpage').forEach((pg) => pg.classList.toggle('hidden', pg.dataset.page !== btn.dataset.sub));
          if (btn.dataset.sub === 'lg-view') loadLogs(logState.page);
        })
      );
    });

    // --- Module on/off switches (sidebar, overview cards and page headers stay in sync) ---
    document.querySelectorAll('.module-toggle').forEach((input) => {
      input.addEventListener('click', (ev) => ev.stopPropagation());
      input.addEventListener('change', async () => {
        const module = input.dataset.module;
        const enabled = input.checked;
        const all = document.querySelectorAll(`.module-toggle[data-module="${module}"]`);
        all.forEach((el) => (el.disabled = true));
        try {
          const res = await fetch(`/api/guilds/${guildId}/modules/${module}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ enabled })
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'Failed to update.');
          all.forEach((el) => (el.checked = enabled));
          const label = module.charAt(0).toUpperCase() + module.slice(1);
          showToast(`${enabled ? '✅' : '⏸️'} ${label} ${enabled ? 'enabled' : 'disabled'}.${data.note ? ' ' + data.note : ''}`);
        } catch (err) {
          input.checked = !enabled;
          showToast(`❌ ${err.message}`);
        } finally {
          all.forEach((el) => (el.disabled = false));
        }
      });
    });

    // --- Honeypot DM preview (mirrors buildHoneypotNotice on the bot) ---
    const PUNISH = {
      kick: ['Kick', 'You were <strong>kicked</strong>. You can rejoin with a new invite once your account is secure.'],
      softban: ['Soft ban', 'You were <strong>soft-banned</strong>: briefly banned so your recent messages were deleted, then unbanned. You can rejoin with a new invite once your account is secure.'],
      ban: ['Permanent ban', 'You were <strong>banned</strong>. If you believe this was a mistake, contact the server staff to appeal.']
    };
    function renderHpDmPreview() {
      const action = (document.querySelector('input[name="hpAction"]:checked') || {}).value || 'kick';
      const ch = channels.find((c) => c.id === document.getElementById('hpChannel').value);
      const [label, detail] = PUNISH[action];
      const el = document.getElementById('hpDmPreview');
      el.style.opacity = document.getElementById('hpDm').checked ? '1' : '0.4';
      el.innerHTML = `
        <div class="title">⚠️ You were removed from ${esc(guildName)}</div>
        <div class="desc">Your account sent a message in <strong>#${esc(ch ? ch.name : 'trap-channel')}</strong>, a hidden trap channel that real members are told never to post in. Posting there triggers an automatic anti-raid action.</div>
        <div class="desc" style="margin-top:0.6rem;"><strong>Punishment</strong><br><strong>${label}</strong> — ${detail}</div>
        <div class="desc" style="margin-top:0.6rem;"><strong>Why this usually happens</strong><br>• <strong>Your account may be compromised</strong> — scam bots often hijack accounts and spam every channel they can see.<br>• <strong>The account is a self-bot or automation</strong> posting on its own.<br>• <strong>It was a mistake</strong> — you posted without reading the channel's warning.</div>
        <div class="desc" style="margin-top:0.6rem;"><strong>Secure your account</strong><br>1. Change your Discord password.<br>2. Turn on Two-Factor Authentication.<br>3. Settings → Authorized Apps: remove anything you don't recognize.<br>4. Never scan QR codes or run scripts people send you to "verify".</div>`;
    }
    document.querySelectorAll('input[name="hpAction"], #hpDm, #hpChannel').forEach((el) => el.addEventListener('change', renderHpDmPreview));

    // --- Server log viewer ---
    const logState = { page: 1, totalPages: 1 };
    const LOG_LABELS = { messageEdit: 'Edited', messageDelete: 'Deleted', memberJoin: 'Joined', memberLeave: 'Left', voice: 'Voice', roles: 'Roles' };

    // Word diff (same algorithm as the bot's log embeds) for highlighting edits.
    function diffWords(a, b) {
      const A = String(a || '').split(/(\s+)/).filter(Boolean);
      const B = String(b || '').split(/(\s+)/).filter(Boolean);
      if (A.length > 600 || B.length > 600) return [{ t: 'del', s: a }, { t: 'add', s: b }];
      const dp = Array.from({ length: A.length + 1 }, () => new Uint16Array(B.length + 1));
      for (let i = A.length - 1; i >= 0; i--)
        for (let j = B.length - 1; j >= 0; j--) dp[i][j] = A[i] === B[j] ? dp[i + 1][j + 1] + 1 : Math.max(dp[i + 1][j], dp[i][j + 1]);
      const out = [];
      let i = 0, j = 0;
      while (i < A.length && j < B.length) {
        if (A[i] === B[j]) { out.push({ t: 'same', s: A[i] }); i++; j++; }
        else if (dp[i + 1][j] >= dp[i][j + 1]) out.push({ t: 'del', s: A[i++] });
        else out.push({ t: 'add', s: B[j++] });
      }
      while (i < A.length) out.push({ t: 'del', s: A[i++] });
      while (j < B.length) out.push({ t: 'add', s: B[j++] });
      return out;
    }

    function relTime(iso) {
      const sec = Math.round((Date.now() - new Date(iso)) / 1000);
      if (sec < 60) return 'just now';
      const units = [['d', 86400], ['h', 3600], ['m', 60]];
      for (const [u, n] of units) if (sec >= n) return `${Math.floor(sec / n)}${u} ago`;
      return 'just now';
    }

    function renderLogEntry(e) {
      const avatar = e.userAvatar ? `<img src="${esc(e.userAvatar)}" alt="">` : '<div class="log-avatar"></div>';
      let body = '';
      if (e.type === 'messageEdit') {
        if (e.details && e.details.beforeUnknown) {
          body = `<div class="log-content"><span class="lbl">After</span>${esc(e.after)}</div>`;
        } else {
          const ops = diffWords(e.before, e.after);
          const before = ops.filter((o) => o.t !== 'add').map((o) => (o.t === 'del' ? `<span class="diff-del">${esc(o.s)}</span>` : esc(o.s))).join('');
          const after = ops.filter((o) => o.t !== 'del').map((o) => (o.t === 'add' ? `<span class="diff-add">${esc(o.s)}</span>` : esc(o.s))).join('');
          body = `<div class="log-content"><span class="lbl">Before</span>${before || '<em>(empty)</em>'}</div><div class="log-content"><span class="lbl">After</span>${after || '<em>(empty)</em>'}</div>`;
        }
      } else if (e.type === 'messageDelete') {
        body = e.details && e.details.contentUnknown
          ? '<div class="log-content muted">Content unavailable — sent before the bot last restarted.</div>'
          : `<div class="log-content">${esc(e.before) || '<em>(no text)</em>'}${e.details && e.details.attachments && e.details.attachments.length ? `<br><span class="muted">📎 ${e.details.attachments.map(esc).join(', ')}</span>` : ''}</div>`;
      } else if (e.type === 'roles' && e.details) {
        const add = (e.details.added || []).map((r) => `<span class="diff-add">+${esc(r)}</span>`).join(' ');
        const rem = (e.details.removed || []).map((r) => `<span class="diff-del">−${esc(r)}</span>`).join(' ');
        body = `<div class="log-content">${[add, rem].filter(Boolean).join(' ')}${e.details.executor ? `<br><span class="muted">by ${esc(e.details.executor)}</span>` : ''}</div>`;
      } else if (e.type === 'memberJoin' && e.details && e.details.newAccount) {
        body = `<div class="log-content"><span class="diff-del" style="text-decoration:none;">⚠️ New account (${e.details.accountAgeDays}d old)</span></div>`;
      }
      const jump = e.messageUrl ? `<a href="${esc(e.messageUrl)}" target="_blank" rel="noopener">🔗 Jump</a>` : '';
      return `<div class="log-row">
        ${avatar}
        <div style="min-width:0;">
          <div class="log-head"><strong>${esc(e.userTag || 'Unknown user')}</strong><span class="log-type ${esc(e.type)}">${esc(LOG_LABELS[e.type] || e.type)}</span></div>
          <div class="log-summary">${esc(e.summary)}</div>
          ${body}
        </div>
        <div class="log-meta" title="${esc(new Date(e.createdAt).toLocaleString())}">${relTime(e.createdAt)}<br>${jump}</div>
      </div>`;
    }

    async function loadLogs(page = 1) {
      const list = document.getElementById('logList');
      const params = new URLSearchParams({ page: Math.max(1, page), q: document.getElementById('logSearch').value.trim(), type: document.getElementById('logType').value });
      try {
        const res = await fetch(`/api/guilds/${guildId}/logs?${params}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to load logs.');
        logState.page = data.page;
        logState.totalPages = data.totalPages;
        document.getElementById('logPageLabel').textContent = `Page ${data.page} of ${data.totalPages} · ${fmt(data.total)} event(s)`;
        document.getElementById('logPrev').disabled = data.page <= 1;
        document.getElementById('logNext').disabled = data.page >= data.totalPages;
        list.innerHTML = data.entries.length
          ? data.entries.map(renderLogEntry).join('')
          : `<div class="empty-state"><div class="big">🗒️</div>${params.get('q') || params.get('type') ? 'No events match your search.' : 'No events logged yet. New activity shows up here automatically.'}</div>`;
      } catch (err) {
        list.innerHTML = `<div class="empty-state">❌ ${esc(err.message)}</div>`;
      }
    }
    let logSearchTimer;
    document.getElementById('logSearch').addEventListener('input', () => {
      clearTimeout(logSearchTimer);
      logSearchTimer = setTimeout(() => loadLogs(1), 300);
    });
    document.getElementById('logType').addEventListener('change', () => loadLogs(1));

    // --- Commands page: filter + click to copy ---
    let cmdPerm = 'all';
    function filterCommands() {
      const q = document.getElementById('cmdSearch').value.trim().toLowerCase();
      document.querySelectorAll('.cmd-card').forEach((card) => {
        let visible = 0;
        card.querySelectorAll('.cmd-item').forEach((item) => {
          const show = (!q || item.dataset.text.includes(q)) && (cmdPerm === 'all' || item.dataset.perm === cmdPerm);
          item.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        card.style.display = visible ? '' : 'none';
      });
    }
    document.querySelectorAll('#cmdPermFilter button').forEach((btn) =>
      btn.addEventListener('click', () => {
        document.querySelectorAll('#cmdPermFilter button').forEach((b) => b.classList.toggle('active', b === btn));
        cmdPerm = btn.dataset.perm;
        filterCommands();
      })
    );
    document.querySelectorAll('.cmd-item code').forEach((code) =>
      code.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.dataset.copy);
          showToast(`📋 Copied ${code.dataset.copy}`);
        } catch {
          showToast('❌ Could not copy — select it manually.');
        }
      })
    );

    // --- @ / # / : autocomplete on every field the bot sends ---
    LoofMentions.load(guildId).then(() => {
      renderWelcomePreview();
      renderHpPreview();
    });
    ['wContent', 'wTitle', 'wDesc', 'wFooter'].forEach((id) => LoofMentions.attach(document.getElementById(id), { onChange: renderWelcomePreview }));
    ['hpTitle', 'hpDesc', 'hpFooter'].forEach((id) => LoofMentions.attach(document.getElementById(id), { onChange: renderHpPreview }));

    renderHpPreview();
    renderHpDmPreview();
    renderOdds();
    renderWelcomePreview();
    loadJoinChart();

    // Deep link: /dashboard/:id#welcome opens that tab (used after saving from the Embed Builder).
    if (location.hash) showTab(location.hash.slice(1));

    async function saveLevels() {
      const enabled = document.getElementById('lvlEnabled').checked;
      const levelRoles = [...document.querySelectorAll('.level-role-row')].map((row) => ({
        level: row.querySelector('.lr-level').value,
        roleId: row.querySelector('.lr-role').value
      }));
      const payload = {
        enabled,
        levelRoles,
        xpMin: document.getElementById('xpMin').value,
        xpMax: document.getElementById('xpMax').value,
        xpCooldownSeconds: document.getElementById('xpCooldown').value,
        levelXpBase: document.getElementById('levelXpBase').value,
        levelUpChannelId: document.getElementById('levelUpChannel').value,
        rankCardBoosterOnly: document.getElementById('cardBoosterOnly').checked,
        daily: readDaily(),
        xpMultipliers: [...document.querySelectorAll('.multiplier-row')].map((row) => ({
          type: row.querySelector('.mul-type').value,
          targetId: row.querySelector('.mul-target').value,
          multiplier: row.querySelector('.mul-value').value
        }))
      };
      const res = await fetch(`/api/guilds/${guildId}/levels`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      showToast(res.ok ? '✅ Leveling settings saved. Reload to see updated hierarchy warnings.' : '❌ Failed to save.');
    }

    // --- Auto-Role ---
    async function saveAutoRole() {
      const roleId = document.getElementById('arRole').value;
      const enabled = document.getElementById('arEnabled').checked;
      const res = await fetch(`/api/guilds/${guildId}/autorole`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ roleId, enabled })
      });
      showToast(res.ok ? '✅ Auto-role settings saved.' : '❌ Failed to save.');
    }

    async function syncAutoRole() {
      const resultEl = document.getElementById('arSyncResult');
      resultEl.textContent = 'Syncing… this can take a moment on larger servers.';
      try {
        const res = await fetch(`/api/guilds/${guildId}/autorole/sync`, { method: 'POST' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Sync failed.');
        resultEl.textContent = `✅ Granted the role to ${data.granted} member(s).${data.failed > 0 ? ` Failed for ${data.failed} (check hierarchy/permissions).` : ''}`;
      } catch (err) {
        resultEl.textContent = `❌ ${err.message}`;
      }
    }
  </script>
</body>
</html>
