<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= guild.name %> | LoofaryBot</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>
<%
  // Line icons (24x24, stroke-based) shared by the sidebar, app bar and stat cards.
  const ICON_PATHS = {
    home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9v11.5h13V9"/><path d="M10 20.5v-6h4v6"/>',
    welcome: '<path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.1-4.6A8.5 8.5 0 1 1 21 12z"/><path d="M9 13.5a3.5 3.5 0 0 0 6 0"/>',
    shield: '<path d="M12 3l8 3v6c0 4.8-3.4 8-8 9-4.6-1-8-4.2-8-9V6z"/>',
    trending: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
    userplus: '<circle cx="9" cy="8" r="4"/><path d="M2 21a7 7 0 0 1 14 0"/><path d="M19 8v6M16 11h6"/>',
    dice: '<rect x="3.5" y="3.5" width="17" height="17" rx="4"/><circle cx="8.5" cy="8.5" r="1.1" fill="currentColor"/><circle cx="12" cy="12" r="1.1" fill="currentColor"/><circle cx="15.5" cy="15.5" r="1.1" fill="currentColor"/>',
    file: '<path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8z"/><path d="M14 3v5h5"/><path d="M8.5 13h7M8.5 16.5h4.5"/>',
    trophy: '<path d="M8 21h8M12 16.5V21"/><path d="M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M17 5.5h2.5a2.5 2.5 0 0 1-2.8 4M7 5.5H4.5a2.5 2.5 0 0 0 2.8 4"/>',
    terminal: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l3 3-3 3M12.5 15H17"/>',
    search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>',
    bell: '<path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 20.5a2 2 0 0 0 4 0"/>',
    brush: '<path d="M18.5 3.5a2.1 2.1 0 0 1 3 3L12 16l-3.5.5.5-3.5z"/><path d="M8 17c-2 0-3.5 1.3-3.5 3.5H8a2.5 2.5 0 0 0 0-5"/>',
    menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
    users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6.5 6.5 0 0 1 3.5 5.5"/>',
    login: '<path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"/><path d="M10 16l4-4-4-4M14 12H4"/>',
    star: '<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>',
    target: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1" fill="currentColor"/>',
    curve: '<path d="M3 3v18h18"/><path d="M6.5 15c3-7 5.5-7 8 0 1.5 4 3 3.5 5-2"/>'
  };
  const icon = (name) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON_PATHS[name]}</svg>`;

  const NAV = [
    ['overview', 'home', 'Overview'],
    ['welcome', 'welcome', 'Welcome'],
    ['honeypot', 'shield', 'Honeypot'],
    ['leveling', 'trending', 'Leveling'],
    ['autorole', 'userplus', 'Auto-Role'],
    ['gambling', 'dice', 'Gambling'],
    ['logs', 'file', 'Logs'],
    ['leaderboard', 'trophy', 'Leaderboard'],
    ['commands', 'terminal', 'Commands']
  ];
  const logChannelSet = !!(config.logChannelId && channels.find(c => c.id === config.logChannelId));
  const MODULES = [
    ['welcome', 'Welcome', !!(welcome.enabled && welcome.channelId)],
    ['honeypot', 'Honeypot', !!config.honeypotChannelId],
    ['leveling', 'Leveling', config.levelingEnabled !== false],
    ['autorole', 'Auto-Role', !!(config.autoRoleId && config.autoRoleEnabled !== false)],
    ['gambling', 'Gambling', gambling.enabled],
    ['logs', 'Logs', logChannelSet]
  ];
  const catches = (config.honeypotKicks || 0) + (config.honeypotSoftbans || 0) + (config.honeypotBans || 0);
  const pct = (cur, target) => Math.max(0, Math.min(100, target > 0 ? (cur / target) * 100 : 0));
%>
<div class="app-shell" id="appShell">
  <aside class="sidebar" id="sidebar" aria-label="Dashboard navigation">
    <a class="sidebar-brand" href="/dashboard"><span class="brand-mark">🎁</span>LoofaryBot</a>

    <div class="server-card">
      <% if (guild.iconURL()) { %>
        <img src="<%= guild.iconURL({ size: 64 }) %>" alt="">
      <% } else { %>
        <div class="guild-icon-fallback"><%= guild.name.slice(0, 1) %></div>
      <% } %>
      <div style="min-width:0;">
        <div class="name"><%= guild.name %></div>
        <a href="/dashboard">Switch server →</a>
      </div>
    </div>

    <div class="nav-section">
      <div class="nav-heading"><span class="ring-dot"></span>Menu</div>
      <% NAV.forEach(([tab, ic, label], i) => { %>
        <button class="nav-item <%= i === 0 ? 'active' : '' %>" data-tab="<%= tab %>"><%- icon(ic) %><span><%= label %></span></button>
      <% }) %>
    </div>

    <div class="nav-section">
      <div class="nav-heading"><span class="ring-dot green"></span>Modules</div>
      <% MODULES.forEach(([tab, label, on]) => { %>
        <button class="module-row" data-tab="<%= tab %>"><span><%= label %></span><span class="pill <%= on ? 'on' : '' %>"><%= on ? 'ON' : 'OFF' %></span></button>
      <% }) %>
    </div>

    <div class="sidebar-footer">
      <label class="switch" title="Toggle light / dark theme">
        <input type="checkbox" id="themeToggle" aria-label="Dark theme">
        <span class="track"></span>
      </label>
      <span><span id="sunLabel">Sun</span> / <strong id="moonLabel">Moon</strong></span>
    </div>
  </aside>
  <div class="sidebar-scrim" onclick="toggleSidebar(false)"></div>

  <div class="main-area">
    <header class="appbar">
      <button class="appbar-icon menu-toggle" onclick="toggleSidebar()" aria-label="Open menu"><%- icon('menu') %></button>
      <div class="appbar-search">
        <%- icon('search') %>
        <input id="globalSearch" type="search" placeholder="Search settings and commands …" autocomplete="off" aria-label="Search settings and commands">
        <div class="search-results" id="searchResults" role="listbox"></div>
      </div>
      <a class="appbar-icon" href="/dashboard/<%= guild.id %>/embed" title="Embed Builder" aria-label="Embed Builder"><%- icon('brush') %></a>
      <button class="appbar-icon" data-tab="logs" title="Server logs" aria-label="Server logs"><%- icon('bell') %><% if (!logChannelSet) { %><span class="badge-dot"></span><% } %></button>
      <div class="appbar-user">
        <div class="avatar-wrap"><img src="<%= viewer.avatarUrl %>" alt=""><span class="online"></span></div>
        <div class="user-meta">
          <div><%= viewer.username %></div>
          <a href="/auth/logout">Log out</a>
        </div>
      </div>
    </header>

    <main class="content">
    <!-- OVERVIEW -->
    <div class="tab-panel" id="tab-overview">
      <div class="page-heading">
        <h1>Server members <span>(<%= stats.memberCount.toLocaleString() %>)</span></h1>
        <div class="avatar-stack" title="Newest members">
          <% recentMembers.forEach(m => { %>
            <img src="<%= m.avatarUrl %>" alt="<%= m.name %>" title="<%= m.name %>">
          <% }) %>
          <% if (stats.memberCount > recentMembers.length) { %>
            <% const others = stats.memberCount - recentMembers.length; %>
            <span class="more">+<%= others >= 1000 ? Math.floor(others / 1000) + 'k' : others %></span>
          <% } %>
        </div>
      </div>

      <div class="stat-cards">
        <div class="stat-card tone-blue">
          <div class="stat-body">
            <div class="stat-top"><span class="stat-label">Total members</span><span class="stat-icon"><%- icon('users') %></span></div>
            <div class="stat-value"><%= stats.memberCount.toLocaleString() %></div>
            <div class="stat-trends"><span>Joins wk:<strong id="tJoinsWeek">—</strong></span><span>Day:<strong id="tJoinsDay">—</strong></span></div>
          </div>
          <div class="stat-footer"><span>Joined today</span><strong id="fJoinedToday">—</strong></div>
        </div>
        <div class="stat-card tone-red">
          <div class="stat-body">
            <div class="stat-top"><span class="stat-label" id="lJoinsRange">New joins · 30 days</span><span class="stat-icon"><%- icon('login') %></span></div>
            <div class="stat-value" id="vJoinsRange">—</div>
            <div class="stat-trends"><span>Left wk:<strong id="tLeavesWeek">—</strong></span><span>Net wk:<strong id="tNetWeek">—</strong></span></div>
          </div>
          <div class="stat-footer"><span>Left today</span><strong id="fLeftToday">—</strong></div>
        </div>
        <div class="stat-card tone-yellow">
          <div class="stat-body">
            <div class="stat-top"><span class="stat-label">Ranked members</span><span class="stat-icon"><%- icon('star') %></span></div>
            <div class="stat-value"><%= levelStats.ranked.toLocaleString() %></div>
            <div class="stat-trends"><span>Top level:<strong><%= levelStats.topLevel %></strong></span><span>XP:<strong><%= levelStats.totalXp >= 1e6 ? (levelStats.totalXp / 1e6).toFixed(1) + 'M' : levelStats.totalXp >= 1e3 ? (levelStats.totalXp / 1e3).toFixed(1) + 'k' : levelStats.totalXp %></strong></span></div>
          </div>
          <div class="stat-footer"><span>Role rewards</span><strong><%= (config.levelRoles || []).length %></strong></div>
        </div>
        <div class="stat-card tone-green">
          <div class="stat-body">
            <div class="stat-top"><span class="stat-label">Honeypot catches</span><span class="stat-icon"><%- icon('shield') %></span></div>
            <div class="stat-value"><%= catches.toLocaleString() %></div>
            <div class="stat-trends"><span>Kicks:<strong><%= config.honeypotKicks || 0 %></strong></span><span>Bans:<strong><%= config.honeypotBans || 0 %></strong></span></div>
          </div>
          <div class="stat-footer"><span>Soft bans</span><strong><%= config.honeypotSoftbans || 0 %></strong></div>
        </div>
      </div>

      <div class="overview-row">
        <div class="card panel-card">
          <div class="panel-head">
            <h2 class="panel-title"><%- icon('curve') %>Member curve</h2>
            <div class="chart-controls">
              <div class="segmented" id="rangeControl" role="group" aria-label="Date range">
                <button data-days="7">7D</button>
                <button data-days="30" class="active">30D</button>
                <button data-days="90">90D</button>
                <button data-days="365">1Y</button>
              </div>
              <div class="segmented" id="bucketControl" role="group" aria-label="Group by">
                <button data-bucket="day" class="active">Daily</button>
                <button data-bucket="week">Weekly</button>
              </div>
              <button class="btn secondary small" id="syncJoinsBtn" onclick="syncJoinData()">🔄 Sync Join Data</button>
            </div>
          </div>
          <div class="panel-body">
            <div class="chart-wrap">
              <canvas id="joinChart" aria-label="Member joins, leaves and net change" role="img"></canvas>
              <div class="chart-empty" id="chartEmpty">No join data yet. New joins are recorded automatically; click <strong>&nbsp;Sync Join Data&nbsp;</strong> to backfill current members.</div>
            </div>
            <div class="chart-legend">
              <span><span class="dot" style="background:var(--c-blue);"></span>Joins</span>
              <span><span class="dot" style="background:var(--c-red);"></span>Leaves <span class="muted">(tracked from now on)</span></span>
              <span><span class="dot" style="background:var(--c-yellow);"></span>Net change</span>
              <span id="chartSubtitle" style="margin-left:auto;"></span>
            </div>
          </div>
        </div>

        <div class="card panel-card">
          <div class="panel-head"><h2 class="panel-title"><%- icon('target') %>Server goals</h2></div>
          <div class="panel-body">
            <div class="goal blue">
              <div class="goal-head"><span>Members</span><span><%= goals.members.current.toLocaleString() %> / <%= goals.members.target.toLocaleString() %></span></div>
              <div class="goal-track"><div class="goal-fill" style="width:<%= pct(goals.members.current, goals.members.target) %>%;"></div></div>
              <div class="goal-note"><%= (goals.members.target - goals.members.current).toLocaleString() %> to the next milestone</div>
            </div>
            <div class="goal red">
              <div class="goal-head"><span>Ranked members</span><span><%= goals.ranked.current.toLocaleString() %> / <%= goals.ranked.target.toLocaleString() %></span></div>
              <div class="goal-track"><div class="goal-fill" style="width:<%= pct(goals.ranked.current, goals.ranked.target) %>%;"></div></div>
              <div class="goal-note"><%= Math.round(pct(goals.ranked.current, goals.ranked.target)) %>% of members have earned XP</div>
            </div>
            <div class="goal yellow">
              <div class="goal-head"><span>Boosts</span><span><%= goals.boosts.current %> / <%= goals.boosts.target %></span></div>
              <div class="goal-track"><div class="goal-fill" style="width:<%= pct(goals.boosts.current, goals.boosts.target) %>%;"></div></div>
              <div class="goal-note"><%= goals.boosts.maxed ? 'Max boost tier reached 🎉' : (goals.boosts.target - goals.boosts.current) + ' more for Boost Tier ' + ([2, 7, 14].indexOf(goals.boosts.target) + 1) %></div>
            </div>
          </div>
        </div>
      </div>

      <div class="section-title"><h2>Modules</h2></div>
      <div class="grid">
        <div class="card">
          <% const wChannel = welcome.channelId ? channels.find(c => c.id === welcome.channelId) : null; %>
          <h3>👋 Welcome <span class="badge <%= welcome.enabled && wChannel ? 'on' : 'off' %>"><%= welcome.enabled && wChannel ? 'Active' : 'Off' %></span></h3>
          <p class="muted"><%= wChannel ? 'Greeting new members in #' + wChannel.name : 'Set up a greeting in the Welcome tab.' %></p>
        </div>
        <div class="card">
          <h3>🍯 Honeypot <span class="badge <%= config.honeypotChannelId ? 'on' : 'off' %>"><%= config.honeypotChannelId ? 'Active' : 'Not set up' %></span></h3>
          <% if (config.honeypotChannelId) {
               const hpChannel = channels.find(c => c.id === config.honeypotChannelId);
          %>
            <p class="muted">Trap: <strong>#<%= hpChannel ? hpChannel.name : 'unknown-channel' %></strong> · Action: <strong><%= config.honeypotAction %></strong></p>
            <p class="muted">Kicks: <%= config.honeypotKicks || 0 %> · Soft Bans: <%= config.honeypotSoftbans || 0 %> · Bans: <%= config.honeypotBans || 0 %></p>
          <% } else { %>
            <p class="muted">Not set up yet — see the Honeypot tab.</p>
          <% } %>
        </div>
        <div class="card">
          <h3>📈 Leveling <span class="badge <%= config.levelingEnabled === false ? 'off' : 'on' %>"><%= config.levelingEnabled === false ? 'Disabled' : 'Enabled' %></span></h3>
          <p class="muted">XP per message: <strong><%= effectiveXp.xpMin %>–<%= effectiveXp.xpMax %></strong>,
            cooldown <strong><%= effectiveXp.cooldownMs / 1000 %>s</strong></p>
          <p class="muted"><%= (config.levelRoles || []).length %> role reward(s) configured.</p>
          <% const lvlChannel = config.levelUpChannelId ? channels.find(c => c.id === config.levelUpChannelId) : null; %>
          <p class="muted">Level-up messages: <strong><%= lvlChannel ? '#' + lvlChannel.name : 'same channel' %></strong></p>
        </div>
        <div class="card">
          <h3>🛡️ Auto-Role <span class="badge <%= (config.autoRoleId && config.autoRoleEnabled !== false) ? 'on' : 'off' %>"><%= (config.autoRoleId && config.autoRoleEnabled !== false) ? 'Active' : 'Not set up' %></span></h3>
          <% if (stats.autoRoleName) { %>
            <p class="muted">New members receive <strong><%= stats.autoRoleName %></strong> automatically.</p>
          <% } else { %>
            <p class="muted">Not configured yet — see the Auto-Role tab.</p>
          <% } %>
        </div>
        <div class="card">
          <h3>🎰 Gambling <span class="badge <%= gambling.enabled ? 'on' : 'off' %>"><%= gambling.enabled ? 'Enabled' : 'Disabled' %></span></h3>
          <p class="muted">House edge <strong><%= gambling.edgePercent %>%</strong> · Bets <strong><%= gambling.minBet %>–<%= gambling.maxBet || '∞' %> XP</strong></p>
          <% const gChannel = gambling.channelId ? channels.find(c => c.id === gambling.channelId) : null; %>
          <p class="muted">Channel: <strong><%= gChannel ? '#' + gChannel.name : 'anywhere' %></strong></p>
        </div>
        <div class="card">
          <% const logCh = config.logChannelId ? channels.find(c => c.id === config.logChannelId) : null; %>
          <h3>📋 Logs <span class="badge <%= logCh ? 'on' : 'off' %>"><%= logCh ? 'Active' : 'Not set up' %></span></h3>
          <p class="muted"><%= logCh ? 'Logging to #' + logCh.name : 'Pick a log channel in the Logs tab.' %></p>
        </div>
        <div class="card">
          <h3>🖌️ Quick Links</h3>
          <p class="muted"><a href="/dashboard/<%= guild.id %>/embed">Open the Embed Builder →</a></p>
          <p class="muted" style="margin-top:0.4rem;">Use the tabs above to configure everything else.</p>
        </div>
      </div>
    </div>

    <!-- WELCOME -->
    <% const we = welcome.embedConfig || {}; %>
    <div class="tab-panel hidden" id="tab-welcome">
      <div class="split">
        <div class="card">
          <h2>👋 Welcome Messages</h2>
          <p class="muted">Greet every new member automatically. Placeholders are filled in when someone joins.</p>

          <label class="switch" style="margin-top:0.5rem;">
            <input type="checkbox" id="wEnabled" <%= welcome.enabled ? 'checked' : '' %>>
            <span class="track"></span>
            Enable welcome messages
          </label>

          <label for="wChannel">Channel</label>
          <select id="wChannel" onchange="renderWelcomePreview()">
            <option value="">— Select a channel —</option>
            <% channels.forEach(c => { %>
              <option value="<%= c.id %>" <%= welcome.channelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
            <% }) %>
          </select>

          <label for="wContent">Message text</label>
          <textarea id="wContent" maxlength="2000" rows="3" oninput="renderWelcomePreview()" placeholder="Welcome to {server}, {user}!"><%= welcome.messageContent || '' %></textarea>
          <div class="chip-row" aria-label="Insert placeholder">
            <button type="button" class="chip" data-insert="{user}" title="Mentions the new member">{user}</button>
            <button type="button" class="chip" data-insert="{username}" title="Their username">{username}</button>
            <button type="button" class="chip" data-insert="{server}" title="Server name">{server}</button>
            <button type="button" class="chip" data-insert="{membercount}" title="Member count after they joined">{membercount}</button>
          </div>

          <div class="subpanel">
            <label class="switch" style="margin-top:1rem;">
              <input type="checkbox" id="wEmbedEnabled" <%= welcome.embedEnabled ? 'checked' : '' %> onchange="toggleWelcomeEmbed()">
              <span class="track"></span>
              Include a rich embed
            </label>
            <div id="wEmbedFields" class="<%= welcome.embedEnabled ? '' : 'disabled' %>">
              <div class="field-row">
                <div>
                  <label for="wTitle">Embed title</label>
                  <input id="wTitle" maxlength="256" value="<%= we.title || '' %>" placeholder="Welcome, {username}!" oninput="renderWelcomePreview()">
                </div>
                <div style="flex:0 0 110px;">
                  <label for="wColor">Color</label>
                  <input id="wColor" type="color" value="<%= we.color || '#5865F2' %>" oninput="renderWelcomePreview()">
                </div>
              </div>
              <label for="wDesc">Embed description</label>
              <textarea id="wDesc" maxlength="4096" rows="4" oninput="renderWelcomePreview()" placeholder="Grab your roles in #roles and say hi!"><%= we.description || '' %></textarea>
              <div class="field-row">
                <div>
                  <label for="wImage">Image URL</label>
                  <input id="wImage" value="<%= we.imageUrl || '' %>" placeholder="https://…" oninput="renderWelcomePreview()">
                </div>
                <div>
                  <label for="wThumb">Thumbnail URL <span class="muted" style="font-weight:400;">(or {avatar})</span></label>
                  <input id="wThumb" value="<%= we.thumbnailUrl || '' %>" placeholder="{avatar}" oninput="renderWelcomePreview()">
                </div>
              </div>
              <label for="wFooter">Footer</label>
              <input id="wFooter" maxlength="2048" value="<%= we.footer || '' %>" placeholder="You are member #{membercount}" oninput="renderWelcomePreview()">
            </div>
          </div>

          <div style="display:flex; gap:0.6rem; flex-wrap:wrap; margin-top:1.5rem;">
            <button class="btn" onclick="saveWelcome()">Save Welcome Settings</button>
            <button class="btn secondary" onclick="testWelcome()">📨 Send test</button>
            <a class="btn secondary" href="/dashboard/<%= guild.id %>/embed?welcome=1">🖌️ Design in Embed Builder</a>
          </div>
          <p class="muted" style="font-size:0.8rem; margin-top:0.75rem;">“Send test” posts the current form (saved or not) to the chosen channel, using you as the new member.</p>
        </div>

        <div class="sticky-preview">
          <div class="card" style="margin-bottom:0;">
            <h3 style="margin-top:0;">Live preview</h3>
            <div class="discord-chat">
              <div class="channel-name" id="wpChannel"># welcome</div>
              <div class="discord-message-preview">
                <img class="discord-avatar" src="<%= bot.avatarUrl %>" alt="">
                <div class="discord-message-body">
                  <div class="discord-message-header">
                    <span class="discord-bot-name"><%= bot.name %></span>
                    <span class="discord-bot-badge">BOT</span>
                    <span class="discord-message-time">Today at 12:00 PM</span>
                  </div>
                  <div class="desc" id="wpContent"></div>
                  <div class="discord-embed-preview" id="wpEmbed" style="margin-top:0.4rem; display:none;">
                    <img id="wpThumb" alt="" style="float:right; width:72px; height:72px; object-fit:cover; margin:0 0 0.5rem 0.75rem; display:none;">
                    <div class="title" id="wpTitle"></div>
                    <div class="desc" id="wpDesc"></div>
                    <img id="wpImage" alt="" style="display:none;">
                    <div id="wpFooter" style="margin-top:0.5rem; font-size:0.75rem; color:#949ba4;"></div>
                  </div>
                </div>
              </div>
            </div>
            <p class="muted" style="font-size:0.78rem; margin:0.75rem 0 0;">Previewed as if <strong><%= viewer.username %></strong> just joined. Only the new member is pinged.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- HONEYPOT -->
    <div class="tab-panel hidden" id="tab-honeypot">
      <div class="card">
        <h2>🍯 Honeypot Trap</h2>
        <p class="muted">Anyone who posts in this channel is instantly punished. A live counter embed is posted there.</p>
        <label for="hpChannel">Trap Channel</label>
        <select id="hpChannel">
          <option value="">— Select a channel —</option>
          <% channels.forEach(c => { %>
            <option value="<%= c.id %>" <%= config.honeypotChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
          <% }) %>
        </select>
        <label for="hpAction">Enforcement Action</label>
        <select id="hpAction">
          <option value="kick" <%= config.honeypotAction === 'kick' ? 'selected' : '' %>>Kick</option>
          <option value="softban" <%= config.honeypotAction === 'softban' ? 'selected' : '' %>>Soft Ban (purge messages)</option>
          <option value="ban" <%= config.honeypotAction === 'ban' ? 'selected' : '' %>>Permanent Ban</option>
        </select>
        <p class="muted" style="margin-top:0.75rem;">
          Current counts — Kicks: <strong><%= config.honeypotKicks || 0 %></strong>,
          Soft Bans: <strong><%= config.honeypotSoftbans || 0 %></strong>,
          Bans: <strong><%= config.honeypotBans || 0 %></strong>
        </p>
        <% const hpe = config.honeypotEmbed || {}; %>
        <h3 style="margin-top:1.5rem;">Trap Message Appearance</h3>
        <p class="muted">Disguise the trap as something innocent (e.g. a fake "verify here" channel). Blank fields use the default shown as the placeholder.</p>
        <div class="field-row">
          <div>
            <label for="hpTitle">Title</label>
            <input type="text" id="hpTitle" maxlength="256" placeholder="<%= defaultTrapEmbed.title %>" value="<%= hpe.title || '' %>" oninput="renderHpPreview()">
          </div>
          <div style="flex:0 0 140px;">
            <label for="hpColor">Color</label>
            <input type="color" id="hpColor" value="<%= hpe.color || defaultTrapEmbed.color %>" oninput="renderHpPreview()">
          </div>
        </div>
        <label for="hpDesc">Description</label>
        <textarea id="hpDesc" rows="4" maxlength="4000" placeholder="<%= defaultTrapEmbed.description %>" oninput="renderHpPreview()"><%= hpe.description || '' %></textarea>
        <label for="hpFooter">Footer</label>
        <input type="text" id="hpFooter" maxlength="2048" placeholder="<%= defaultTrapEmbed.footer %>" value="<%= hpe.footer || '' %>" oninput="renderHpPreview()">
        <div class="field-row">
          <div>
            <label for="hpImage">Image URL</label>
            <input type="text" id="hpImage" placeholder="https://…" value="<%= hpe.imageUrl || '' %>" oninput="renderHpPreview()">
          </div>
          <div>
            <label for="hpThumb">Thumbnail URL</label>
            <input type="text" id="hpThumb" placeholder="https://…" value="<%= hpe.thumbnailUrl || '' %>" oninput="renderHpPreview()">
          </div>
        </div>
        <label style="display:flex; align-items:center; gap:0.5rem;">
          <input type="checkbox" id="hpShowCounts" style="width:auto;" <%= hpe.showCounts === false ? '' : 'checked' %> onchange="renderHpPreview()">
          Show kick/ban counters (turn off to disguise it better)
        </label>
        <label>Preview</label>
        <div class="discord-embed-preview" id="hpPreview"></div>

        <button class="btn" style="margin-top:1rem;" onclick="saveHoneypot()">Save Honeypot Settings</button>
      </div>
    </div>

    <!-- LEVELING -->
    <div class="tab-panel hidden" id="tab-leveling">
      <div class="card">
        <h2>📈 Leveling</h2>
        <label style="display:flex; align-items:center; gap:0.5rem;">
          <input type="checkbox" id="lvlEnabled" style="width:auto;" <%= config.levelingEnabled === false ? '' : 'checked' %>>
          Enable XP gain from chat messages
        </label>

        <h3 style="margin-top:1.5rem;">Level-Up Messages</h3>
        <label for="levelUpChannel">Send level-up messages to</label>
        <select id="levelUpChannel">
          <option value="">Same channel the member was chatting in</option>
          <% channels.forEach(c => { %>
            <option value="<%= c.id %>" <%= config.levelUpChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
          <% }) %>
        </select>
        <% if (config.levelUpChannelId && !channels.find(c => c.id === config.levelUpChannelId)) { %>
          <p class="muted" style="color:#FEE75C;">⚠️ The configured level-up channel no longer exists — messages are falling back to the same channel.</p>
        <% } %>

        <h3 style="margin-top:1.5rem;">XP Tuning</h3>
        <p class="muted">Leave a field blank to use the site-wide default shown as its placeholder.</p>
        <div class="field-row">
          <div>
            <label for="xpMin">Min XP / message</label>
            <input type="number" id="xpMin" min="0" placeholder="<%= effectiveXp.xpMin %>" value="<%= config.xpMin ?? '' %>">
          </div>
          <div>
            <label for="xpMax">Max XP / message</label>
            <input type="number" id="xpMax" min="0" placeholder="<%= effectiveXp.xpMax %>" value="<%= config.xpMax ?? '' %>">
          </div>
        </div>
        <div class="field-row">
          <div>
            <label for="xpCooldown">Cooldown (seconds)</label>
            <input type="number" id="xpCooldown" min="0" placeholder="<%= effectiveXp.cooldownMs / 1000 %>" value="<%= config.xpCooldownSeconds ?? '' %>">
          </div>
          <div>
            <label for="levelXpBase">Level curve base (higher = slower)</label>
            <input type="number" id="levelXpBase" min="1" placeholder="<%= effectiveXp.levelXpBase %>" value="<%= config.levelXpBase ?? '' %>">
          </div>
        </div>

        <h3 style="margin-top:1.5rem;">XP Multipliers</h3>
        <p class="muted">Channel multiplier × the member's best role multiplier. Use 0 to disable XP in a channel (e.g. bot spam), 2 for double XP (e.g. boosters).</p>
        <div id="multiplierRows"></div>
        <button class="btn secondary" type="button" onclick="addMultiplierRow()">+ Add Multiplier</button>

        <h3 style="margin-top:1.5rem;">Rank Cards</h3>
        <label style="display:flex; align-items:center; gap:0.5rem;">
          <input type="checkbox" id="cardBoosterOnly" style="width:auto;" <%= config.rankCardBoosterOnly ? 'checked' : '' %>>
          Only server boosters can customize their <code>/levels card</code>
        </label>

        <h3 style="margin-top:1.5rem;">Level-Up Role Rewards</h3>
        <div id="levelRoleRows">
          <% (config.levelRoles || []).forEach(lr => {
               const role = roles.find(r => r.id === lr.roleId);
          %>
            <div class="field-row level-role-row">
              <input type="number" min="1" class="lr-level" value="<%= lr.level %>" placeholder="Level">
              <select class="lr-role">
                <% roles.forEach(r => { %>
                  <option value="<%= r.id %>" <%= r.id === lr.roleId ? 'selected' : '' %>><%= r.name %><%= r.assignable ? '' : ' ⚠️ (bot cannot assign this)' %></option>
                <% }) %>
              </select>
              <button class="btn secondary" type="button" onclick="this.parentElement.remove()">Remove</button>
            </div>
            <% if (role && !role.assignable) { %>
              <p class="muted" style="color:#FEE75C; margin-top:-0.3rem;">⚠️ LoofaryBot's role is below <%= role.name %> — move LoofaryBot's role higher in Server Settings → Roles.</p>
            <% } %>
          <% }) %>
        </div>
        <button class="btn secondary" type="button" onclick="addLevelRoleRow()">+ Add Role Reward</button>
        <br>
        <button class="btn" style="margin-top:1rem;" onclick="saveLevels()">Save Leveling Settings</button>
      </div>
    </div>

    <!-- AUTO-ROLE -->
    <div class="tab-panel hidden" id="tab-autorole">
      <div class="card">
        <h2>🛡️ Auto-Role</h2>
        <p class="muted">Automatically grant a role to every member when they join. Use Sync to also grant it to everyone already in the server.</p>

        <label style="display:flex; align-items:center; gap:0.5rem;">
          <input type="checkbox" id="arEnabled" style="width:auto;" <%= config.autoRoleEnabled === false ? '' : 'checked' %>>
          Enable auto-role on join
        </label>

        <label for="arRole">Role to grant</label>
        <select id="arRole">
          <option value="">— None —</option>
          <% roles.forEach(r => { %>
            <option value="<%= r.id %>" <%= config.autoRoleId === r.id ? 'selected' : '' %>><%= r.name %><%= r.assignable ? '' : ' ⚠️ (bot cannot assign this)' %></option>
          <% }) %>
        </select>

        <button class="btn" style="margin-top:1rem;" onclick="saveAutoRole()">Save Auto-Role Settings</button>
        <button class="btn secondary" style="margin-top:1rem;" onclick="syncAutoRole()">🔄 Sync to Existing Members</button>
        <p class="muted" id="arSyncResult" style="margin-top:0.75rem;"></p>
      </div>
    </div>

    <!-- GAMBLING -->
    <div class="tab-panel hidden" id="tab-gambling">
      <div class="card">
        <h2>🎰 XP Gambling</h2>
        <p class="muted">Members bet XP on <code>/gamble coinflip</code>, <code>/gamble mines</code> and <code>/gamble highlow</code>. The house edge is taken off every payout multiplier.</p>
        <label style="display:flex; align-items:center; gap:0.5rem;">
          <input type="checkbox" id="gEnabled" style="width:auto;" <%= gambling.enabled ? 'checked' : '' %>>
          Enable XP gambling
        </label>
        <div class="field-row">
          <div>
            <label for="gEdge">House edge (%)</label>
            <input type="number" id="gEdge" min="0" max="50" step="0.5" value="<%= gambling.edgePercent %>" oninput="renderOdds()">
          </div>
          <div>
            <label for="gMin">Min bet (XP)</label>
            <input type="number" id="gMin" min="1" value="<%= gambling.minBet %>">
          </div>
          <div>
            <label for="gMax">Max bet (XP, blank = no limit)</label>
            <input type="number" id="gMax" min="1" value="<%= gambling.maxBet || '' %>">
          </div>
        </div>
        <label for="gChannel">Allowed channel</label>
        <select id="gChannel">
          <option value="">Any channel</option>
          <% channels.forEach(c => { %>
            <option value="<%= c.id %>" <%= gambling.channelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
          <% }) %>
        </select>
        <p class="muted" id="gOdds" style="margin-top:0.75rem;"></p>
        <button class="btn" style="margin-top:1rem;" onclick="saveGambling()">Save Gambling Settings</button>
      </div>
    </div>

    <!-- LOGS -->
    <div class="tab-panel hidden" id="tab-logs">
      <div class="card">
        <h2>📋 Server Logs</h2>
        <p class="muted">Send a record of server activity to a private staff channel.</p>
        <label for="logChannel">Log channel</label>
        <select id="logChannel">
          <option value="">— Logging off —</option>
          <% channels.forEach(c => { %>
            <option value="<%= c.id %>" <%= config.logChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
          <% }) %>
        </select>
        <label style="margin-top:1rem;">Events to log</label>
        <% Object.entries(logEvents).forEach(([key, label]) => { %>
          <label style="display:flex; align-items:center; gap:0.5rem; font-weight:normal;">
            <input type="checkbox" class="log-event" data-key="<%= key %>" style="width:auto;" <%= (config.logEvents && config.logEvents[key] === false) ? '' : 'checked' %>>
            <%= label %>
          </label>
        <% }) %>
        <button class="btn" style="margin-top:1rem;" onclick="saveLogs()">Save Log Settings</button>
      </div>
    </div>

    <!-- COMMANDS -->
    <div class="tab-panel hidden" id="tab-commands">
      <% commandReference.forEach(group => { %>
        <div class="card">
          <h3><%= group.group %></h3>
          <% group.commands.forEach(cmd => { %>
            <div class="cmd-row">
              <code><%= cmd.usage %></code>
              <span class="muted"><%= cmd.description %></span>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </div>

    <!-- LEADERBOARD -->
    <div class="tab-panel hidden" id="tab-leaderboard">
      <div class="card">
        <h2>🏆 XP Leaderboard</h2>
        <div id="leaderboardRows" class="muted">Loading…</div>
        <div class="pagination">
          <button class="btn secondary" id="lbPrev" onclick="changeLeaderboardPage(-1)">← Prev</button>
          <span class="muted" id="lbPageLabel">Page 1</span>
          <button class="btn secondary" id="lbNext" onclick="changeLeaderboardPage(1)">Next →</button>
        </div>
      </div>
    </div>
    </main>
  </div>
</div>

  <div class="toast" id="toast"></div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>
  <script>
    const guildId = '<%= guild.id %>';
    const roles = <%- JSON.stringify(roles).replace(/</g, '\\u003c') %>;
    const channels = <%- JSON.stringify(channels).replace(/</g, '\\u003c') %>;
    const initialMultipliers = <%- JSON.stringify(config.xpMultipliers || []).replace(/</g, '\\u003c') %>;
    const trapDefaults = <%- JSON.stringify(defaultTrapEmbed).replace(/</g, '\\u003c') %>;
    const trapCounts = { kicks: <%= config.honeypotKicks || 0 %>, softbans: <%= config.honeypotSoftbans || 0 %>, bans: <%= config.honeypotBans || 0 %> };

    const guildName = <%- JSON.stringify(guild.name).replace(/</g, '\\u003c') %>;
    const memberCount = <%= stats.memberCount %>;
    const viewer = <%- JSON.stringify(viewer).replace(/</g, '\\u003c') %>;

    function esc(str) {
      return String(str ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    }

    let joinChart = null; // created once join data loads

    // --- Navigation (sidebar, module rows and app-bar buttons all carry data-tab) ---
    function showTab(tab) {
      const panel = document.getElementById(`tab-${tab}`);
      if (!panel) return;
      document.querySelectorAll('.tab-panel').forEach((p) => p.classList.add('hidden'));
      panel.classList.remove('hidden');
      document.querySelectorAll('.nav-item').forEach((b) => b.classList.toggle('active', b.dataset.tab === tab));
      if (tab === 'leaderboard') loadLeaderboard();
      if (tab === 'overview' && joinChart) joinChart.resize();
      history.replaceState(null, '', tab === 'overview' ? location.pathname : `#${tab}`);
      toggleSidebar(false);
      window.scrollTo({ top: 0 });
    }
    document.querySelectorAll('[data-tab]').forEach((el) => el.addEventListener('click', () => showTab(el.dataset.tab)));

    function toggleSidebar(open) {
      const shell = document.getElementById('appShell');
      shell.classList.toggle('nav-open', open ?? !shell.classList.contains('nav-open'));
    }

    // --- Sun / Moon theme ---
    const themeToggle = document.getElementById('themeToggle');
    function applyTheme(theme) {
      if (theme === 'light') document.documentElement.setAttribute('data-theme', 'light');
      else document.documentElement.removeAttribute('data-theme');
      themeToggle.checked = theme !== 'light';
      document.getElementById('sunLabel').style.fontWeight = theme === 'light' ? '700' : '';
      document.getElementById('moonLabel').style.fontWeight = theme === 'light' ? '400' : '';
      try { localStorage.setItem('loofary-theme', theme); } catch (e) { /* storage blocked */ }
      if (joinChart) styleChart(joinChart);
    }
    themeToggle.addEventListener('change', () => applyTheme(themeToggle.checked ? 'dark' : 'light'));
    themeToggle.checked = document.documentElement.getAttribute('data-theme') !== 'light';

    // --- Global search: jump to a settings page or a command ---
    const commandIndex = <%- JSON.stringify(commandReference.flatMap((g) => g.commands.map((c) => ({ label: c.usage, detail: c.description, group: g.group })))).replace(/</g, '\\u003c') %>;
    const searchIndex = [
      ...[...document.querySelectorAll('.nav-item')].map((b) => ({ label: b.textContent.trim(), kind: 'Page', tab: b.dataset.tab })),
      ...commandIndex.map((c) => ({ label: c.label, kind: c.group, tab: 'commands', detail: c.detail }))
    ];
    const searchInput = document.getElementById('globalSearch');
    const searchResults = document.getElementById('searchResults');
    let searchMatches = [];
    let searchHighlight = 0;

    function renderSearch() {
      const q = searchInput.value.trim().toLowerCase();
      searchMatches = q ? searchIndex.filter((i) => `${i.label} ${i.detail || ''}`.toLowerCase().includes(q)).slice(0, 8) : [];
      searchHighlight = 0;
      searchResults.innerHTML = searchMatches.length
        ? searchMatches.map((m, i) => `<button data-i="${i}" class="${i === 0 ? 'highlighted' : ''}"><span>${esc(m.label)}</span><span class="kind">${esc(m.kind)}</span></button>`).join('')
        : q ? '<button disabled><span class="kind">No matches</span></button>' : '';
      searchResults.classList.toggle('visible', !!q);
    }
    function pickSearch(i) {
      const m = searchMatches[i];
      if (!m) return;
      searchInput.value = '';
      searchResults.classList.remove('visible');
      showTab(m.tab);
      if (m.tab === 'commands') {
        const row = [...document.querySelectorAll('#tab-commands .cmd-row')].find((r) => r.querySelector('code').textContent === m.label);
        if (row) {
          row.scrollIntoView({ block: 'center' });
          row.style.background = 'var(--accent-gold-soft)';
          setTimeout(() => (row.style.background = ''), 1600);
        }
      }
    }
    searchInput.addEventListener('input', renderSearch);
    searchInput.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowDown' || ev.key === 'ArrowUp') {
        ev.preventDefault();
        if (!searchMatches.length) return;
        searchHighlight = (searchHighlight + (ev.key === 'ArrowDown' ? 1 : -1) + searchMatches.length) % searchMatches.length;
        searchResults.querySelectorAll('button').forEach((b, i) => b.classList.toggle('highlighted', i === searchHighlight));
      } else if (ev.key === 'Enter') {
        pickSearch(searchHighlight);
      } else if (ev.key === 'Escape') {
        searchResults.classList.remove('visible');
      }
    });
    searchResults.addEventListener('mousedown', (ev) => {
      const btn = ev.target.closest('button[data-i]');
      if (btn) pickSearch(Number(btn.dataset.i));
    });
    searchInput.addEventListener('blur', () => setTimeout(() => searchResults.classList.remove('visible'), 150));

    // --- Leaderboard ---
    let lbCurrentPage = 1;
    let lbTotalPages = 1;
    let lbLoaded = false;

    async function loadLeaderboard() {
      if (lbLoaded) return;
      lbLoaded = true;
      await fetchLeaderboardPage(1);
    }

    async function fetchLeaderboardPage(page) {
      const container = document.getElementById('leaderboardRows');
      container.innerHTML = '<p class="muted">Loading…</p>';
      try {
        const res = await fetch(`/api/guilds/${guildId}/leaderboard?page=${page}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to load.');

        lbCurrentPage = data.page;
        lbTotalPages = data.totalPages;
        document.getElementById('lbPageLabel').textContent = `Page ${data.page} of ${data.totalPages} · ${data.total} ranked member(s)`;
        document.getElementById('lbPrev').disabled = data.page <= 1;
        document.getElementById('lbNext').disabled = data.page >= data.totalPages;

        if (data.entries.length === 0) {
          container.innerHTML = '<p class="muted">No XP data yet for this server.</p>';
          return;
        }

        container.innerHTML = data.entries
          .map(
            (e) => `
            <div class="leaderboard-row">
              <div class="leaderboard-rank ${e.rank <= 3 ? 'top3' : ''}">#${e.rank}</div>
              ${e.avatarUrl ? `<img class="leaderboard-avatar" src="${e.avatarUrl}">` : '<div class="leaderboard-avatar"></div>'}
              <div class="leaderboard-name">${e.name}</div>
              <div class="leaderboard-stats">Level ${e.level} · ${e.xp} XP</div>
            </div>`
          )
          .join('');
      } catch (err) {
        container.innerHTML = `<p class="muted">❌ ${err.message}</p>`;
      }
    }

    function changeLeaderboardPage(delta) {
      const next = lbCurrentPage + delta;
      if (next < 1 || next > lbTotalPages) return;
      fetchLeaderboardPage(next);
    }

    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.style.display = 'block';
      setTimeout(() => (t.style.display = 'none'), 2500);
    }

    function roleOptionsHtml(selectedId) {
      return roles
        .map((r) => `<option value="${r.id}" ${r.id === selectedId ? 'selected' : ''}>${r.name}${r.assignable ? '' : ' ⚠️ (bot cannot assign this)'}</option>`)
        .join('');
    }

    function addLevelRoleRow() {
      const container = document.getElementById('levelRoleRows');
      const row = document.createElement('div');
      row.className = 'field-row level-role-row';
      row.innerHTML = `
        <input type="number" min="1" class="lr-level" placeholder="Level">
        <select class="lr-role">${roleOptionsHtml(null)}</select>
        <button class="btn secondary" type="button" onclick="this.parentElement.remove()">Remove</button>
      `;
      container.appendChild(row);
    }

    async function postJson(path, payload, okMsg) {
      try {
        const res = await fetch(`/api/guilds/${guildId}/${path}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json().catch(() => ({}));
        showToast(res.ok ? okMsg : `❌ ${data.error || 'Failed to save.'}`);
      } catch {
        showToast('❌ Failed to save.');
      }
    }

    // --- Honeypot ---
    function readHpEmbed() {
      return {
        title: document.getElementById('hpTitle').value.trim(),
        description: document.getElementById('hpDesc').value.trim(),
        color: document.getElementById('hpColor').value,
        footer: document.getElementById('hpFooter').value.trim(),
        imageUrl: document.getElementById('hpImage').value.trim(),
        thumbnailUrl: document.getElementById('hpThumb').value.trim(),
        showCounts: document.getElementById('hpShowCounts').checked
      };
    }

    function renderHpPreview() {
      const e = readHpEmbed();
      const el = document.getElementById('hpPreview');
      el.style.borderLeftColor = e.color || trapDefaults.color;
      let html = '';
      if (e.thumbnailUrl) html += `<img src="${esc(e.thumbnailUrl)}" style="float:right; max-width:80px; margin:0 0 0.5rem 0.5rem;">`;
      html += `<div class="title">${esc(e.title || trapDefaults.title)}</div>`;
      html += `<div class="desc">${esc(e.description || trapDefaults.description)}</div>`;
      if (e.showCounts) {
        html += `<div class="desc" style="margin-top:0.5rem;"><strong>Kicks</strong> ${trapCounts.kicks} · <strong>Soft Bans</strong> ${trapCounts.softbans} · <strong>Bans</strong> ${trapCounts.bans}</div>`;
      }
      if (e.imageUrl) html += `<img src="${esc(e.imageUrl)}">`;
      html += `<div class="muted" style="font-size:0.75rem; margin-top:0.5rem;">${esc(e.footer || trapDefaults.footer)}</div>`;
      el.innerHTML = html;
    }

    function saveHoneypot() {
      postJson(
        'honeypot',
        {
          channelId: document.getElementById('hpChannel').value,
          action: document.getElementById('hpAction').value,
          embed: readHpEmbed()
        },
        '✅ Honeypot settings saved.'
      );
    }

    // --- XP multipliers ---
    function targetOptionsHtml(type, selectedId) {
      const list = type === 'channel' ? channels.map((c) => ({ id: c.id, name: '#' + c.name })) : roles.map((r) => ({ id: r.id, name: '@' + r.name }));
      return list.map((t) => `<option value="${esc(t.id)}" ${t.id === selectedId ? 'selected' : ''}>${esc(t.name)}</option>`).join('');
    }

    function addMultiplierRow(m = { type: 'channel', targetId: null, multiplier: 2 }) {
      const row = document.createElement('div');
      row.className = 'field-row multiplier-row';
      row.innerHTML = `
        <select class="mul-type" style="flex:0 0 120px;">
          <option value="channel" ${m.type === 'channel' ? 'selected' : ''}>Channel</option>
          <option value="role" ${m.type === 'role' ? 'selected' : ''}>Role</option>
        </select>
        <select class="mul-target">${targetOptionsHtml(m.type, m.targetId)}</select>
        <input type="number" class="mul-value" min="0" max="10" step="0.1" value="${esc(m.multiplier)}" style="flex:0 0 110px;" placeholder="×">
        <button class="btn secondary" type="button" onclick="this.parentElement.remove()">Remove</button>
      `;
      row.querySelector('.mul-type').addEventListener('change', (ev) => {
        row.querySelector('.mul-target').innerHTML = targetOptionsHtml(ev.target.value, null);
      });
      document.getElementById('multiplierRows').appendChild(row);
    }
    initialMultipliers.forEach((m) => addMultiplierRow(m));

    // --- Gambling ---
    function renderOdds() {
      const edge = Math.min(Math.max(Number(document.getElementById('gEdge').value) || 0, 0), 50) / 100;
      const mines = (k, m) => {
        let x = 1;
        for (let i = 0; i < k; i++) x *= (25 - i) / (25 - m - i);
        return (x * (1 - edge)).toFixed(2);
      };
      document.getElementById('gOdds').innerHTML =
        `Coinflip pays <strong>${(2 * (1 - edge)).toFixed(2)}x</strong> · ` +
        `Mines (3 mines): 1 gem <strong>${mines(1, 3)}x</strong>, 5 gems <strong>${mines(5, 3)}x</strong> · ` +
        `Mines (10 mines): 3 gems <strong>${mines(3, 10)}x</strong> · ` +
        `High-Low: one correct call on a 7 pays <strong>${((1 - edge) / (7 / 13)).toFixed(2)}x</strong>`;
    }

    function saveGambling() {
      postJson(
        'gambling',
        {
          enabled: document.getElementById('gEnabled').checked,
          houseEdge: document.getElementById('gEdge').value,
          minBet: document.getElementById('gMin').value,
          maxBet: document.getElementById('gMax').value,
          channelId: document.getElementById('gChannel').value
        },
        '✅ Gambling settings saved.'
      );
    }

    // --- Logs ---
    function saveLogs() {
      const events = {};
      document.querySelectorAll('.log-event').forEach((el) => (events[el.dataset.key] = el.checked));
      postJson('logs', { channelId: document.getElementById('logChannel').value, events }, '✅ Log settings saved.');
    }

    // --- Join analytics chart ---
    const chartState = { days: 30, bucket: 'day' };
    const fmt = (n) => Number(n).toLocaleString();

    function formatLabel(iso) {
      const d = new Date(iso + 'T00:00:00Z');
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', timeZone: 'UTC' });
    }

    async function loadJoinChart() {
      try {
        const res = await fetch(`/api/guilds/${guildId}/joins?days=${chartState.days}&bucket=${chartState.bucket}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to load.');
        renderJoinChart(data);
      } catch (err) {
        document.getElementById('chartEmpty').textContent = `❌ ${err.message}`;
        document.getElementById('chartEmpty').classList.add('visible');
      }
    }

    function setTrend(id, value, { suffix = '%', invert = false } = {}) {
      const el = document.getElementById(id);
      el.classList.remove('trend-up', 'trend-down');
      if (value === null || value === undefined) {
        el.textContent = '—';
        return;
      }
      el.textContent = `${value > 0 ? '+' : ''}${fmt(value)}${suffix}`;
      if (value !== 0) el.classList.add((value > 0) !== invert ? 'trend-up' : 'trend-down');
    }

    const cssVar = (name) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

    // Theme-dependent chart styling (re-applied when Sun/Moon is toggled).
    function styleChart(chart) {
      const label = cssVar('--text-label');
      const grid = cssVar('--border-card');
      const tick = { color: label, font: { family: "Inter, -apple-system, 'Segoe UI', sans-serif", size: 11 } };
      chart.options.scales.x.ticks = { ...tick, maxRotation: 0, autoSkipPadding: 18 };
      chart.options.scales.x.grid = { color: grid, borderDash: [4, 4], drawTicks: false };
      chart.options.scales.y.ticks = { ...tick, precision: 0, padding: 8 };
      chart.options.scales.y.grid = { color: grid, borderDash: [4, 4], drawTicks: false };
      Object.assign(chart.options.plugins.tooltip, {
        backgroundColor: cssVar('--bg-card'),
        borderColor: cssVar('--border-strong'),
        titleColor: cssVar('--text-main'),
        bodyColor: cssVar('--text-main')
      });
      chart.data.datasets.forEach((ds) => (ds.pointHoverBackgroundColor = cssVar('--bg-card')));
      chart.update();
    }

    function renderJoinChart(data) {
      const { totals } = data;
      const t = totals.trends || {};
      setTrend('tJoinsWeek', t.joinsWeek);
      setTrend('tJoinsDay', t.joinsDay);
      setTrend('tLeavesWeek', totals.leaves7, { suffix: '', invert: true });
      setTrend('tNetWeek', t.netWeek, { suffix: '' });
      document.getElementById('fJoinedToday').textContent = fmt(totals.today);
      document.getElementById('fLeftToday').textContent = fmt(totals.leavesToday);
      document.getElementById('vJoinsRange').textContent = fmt(totals.inRange);
      document.getElementById('lJoinsRange').textContent =
        chartState.days === 365 ? 'New joins · 1 year' : `New joins · ${chartState.days} days`;
      document.getElementById('chartEmpty').classList.toggle('visible', totals.tracked === 0);
      document.getElementById('chartSubtitle').textContent = `${fmt(totals.tracked)} joins tracked · UTC`;

      if (typeof Chart === 'undefined') return; // CDN blocked — the stat cards above still work
      const labels = data.labels.map(formatLabel);
      const line = (label, values, color) => ({
        label, data: values, borderColor: color, backgroundColor: color, borderWidth: 3, tension: 0.42, fill: false,
        pointRadius: 0, pointHoverRadius: 6, pointHoverBorderWidth: 3, pointHoverBorderColor: color
      });
      const datasets = [
        line('Joins', data.joins, cssVar('--c-blue')),
        line('Leaves', data.leaves, cssVar('--c-red')),
        line('Net change', data.net, cssVar('--c-yellow'))
      ];

      if (joinChart) {
        joinChart.data.labels = labels;
        joinChart.data.datasets.forEach((ds, i) => (ds.data = datasets[i].data));
        joinChart.update();
        return;
      }
      const ctx = document.getElementById('joinChart').getContext('2d');
      joinChart = new Chart(ctx, {
        type: 'line',
        data: { labels, datasets },
        options: {
          responsive: true, maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          layout: { padding: { top: 6 } },
          plugins: {
            legend: { display: false },
            tooltip: {
              borderWidth: 1, padding: 12, cornerRadius: 8, boxPadding: 5, usePointStyle: true,
              titleFont: { weight: '600' },
              callbacks: { label: (c) => ` ${c.dataset.label}: ${fmt(c.parsed.y)}` }
            }
          },
          scales: {
            x: { border: { display: false } },
            y: { beginAtZero: true, border: { display: false } }
          }
        }
      });
      styleChart(joinChart);
    }

    function bindSegmented(id, key, attr) {
      document.querySelectorAll(`#${id} button`).forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll(`#${id} button`).forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          chartState[key] = key === 'days' ? Number(btn.dataset[attr]) : btn.dataset[attr];
          loadJoinChart();
        });
      });
    }
    bindSegmented('rangeControl', 'days', 'days');
    bindSegmented('bucketControl', 'bucket', 'bucket');

    async function syncJoinData() {
      const btn = document.getElementById('syncJoinsBtn');
      btn.disabled = true;
      btn.textContent = '⏳ Syncing…';
      try {
        const res = await fetch(`/api/guilds/${guildId}/joins/sync`, { method: 'POST' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Sync failed.');
        showToast(`✅ Scanned ${fmt(data.scanned)} members · ${fmt(data.added)} new join record(s).`);
        await loadJoinChart();
      } catch (err) {
        showToast(`❌ ${err.message}`);
      } finally {
        btn.disabled = false;
        btn.textContent = '🔄 Sync Join Data';
      }
    }

    // --- Welcome ---
    function fillPlaceholders(text, { html }) {
      const map = {
        '{user}': html ? `<span class="mention-pill">@${esc(viewer.username)}</span>` : '@' + viewer.username,
        '{username}': html ? esc(viewer.username) : viewer.username,
        '{server}': html ? esc(guildName) : guildName,
        '{membercount}': fmt(memberCount)
      };
      const source = html ? esc(text) : text;
      return source.replace(/\{(user|username|server|membercount)\}/gi, (t) => map[t.toLowerCase()]);
    }

    // Light Discord-flavoured markdown for the preview: **bold**, *italic*, __underline__, `code`.
    function miniMarkdown(htmlText) {
      return htmlText
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/__(.+?)__/g, '<u>$1</u>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/`([^`]+)`/g, '<code>$1</code>');
    }

    function readWelcomeForm() {
      return {
        enabled: document.getElementById('wEnabled').checked,
        channelId: document.getElementById('wChannel').value,
        messageContent: document.getElementById('wContent').value,
        embedEnabled: document.getElementById('wEmbedEnabled').checked,
        embedConfig: {
          title: document.getElementById('wTitle').value,
          description: document.getElementById('wDesc').value,
          color: document.getElementById('wColor').value,
          imageUrl: document.getElementById('wImage').value.trim(),
          thumbnailUrl: document.getElementById('wThumb').value.trim(),
          footer: document.getElementById('wFooter').value
        }
      };
    }

    const safeUrl = (u) => /^https?:\/\//i.test(u) ? u : '';

    // An empty src would make the browser request the page itself, so drop the attribute instead.
    function setPreviewImage(img, url) {
      if (url) img.src = url;
      else img.removeAttribute('src');
      img.style.display = url ? 'block' : 'none';
    }

    function renderWelcomePreview() {
      const w = readWelcomeForm();
      const channel = channels.find((c) => c.id === w.channelId);
      document.getElementById('wpChannel').textContent = `# ${channel ? channel.name : 'welcome'}`;
      document.getElementById('wpContent').innerHTML = miniMarkdown(fillPlaceholders(w.messageContent, { html: true }));

      const e = w.embedConfig;
      const embedEl = document.getElementById('wpEmbed');
      const hasEmbed = w.embedEnabled && (e.title || e.description || e.footer || e.imageUrl || e.thumbnailUrl);
      embedEl.style.display = hasEmbed ? 'block' : 'none';
      if (!hasEmbed) return;
      embedEl.style.borderLeftColor = e.color || '#5865F2';
      document.getElementById('wpTitle').innerHTML = fillPlaceholders(e.title, { html: true });
      document.getElementById('wpDesc').innerHTML = miniMarkdown(fillPlaceholders(e.description, { html: true }));
      document.getElementById('wpFooter').innerHTML = fillPlaceholders(e.footer, { html: true });

      setPreviewImage(document.getElementById('wpImage'), safeUrl(e.imageUrl));
      setPreviewImage(document.getElementById('wpThumb'), e.thumbnailUrl === '{avatar}' ? viewer.avatarUrl : safeUrl(e.thumbnailUrl));
    }

    function toggleWelcomeEmbed() {
      document.getElementById('wEmbedFields').classList.toggle('disabled', !document.getElementById('wEmbedEnabled').checked);
      renderWelcomePreview();
    }

    // Placeholder chips insert into whichever welcome text field was focused last.
    let lastWelcomeField = document.getElementById('wContent');
    ['wContent', 'wTitle', 'wDesc', 'wFooter'].forEach((id) =>
      document.getElementById(id).addEventListener('focus', (ev) => (lastWelcomeField = ev.target))
    );
    document.querySelectorAll('.chip[data-insert]').forEach((chip) => {
      chip.addEventListener('click', () => {
        const el = lastWelcomeField;
        const start = el.selectionStart ?? el.value.length;
        const end = el.selectionEnd ?? el.value.length;
        el.value = el.value.slice(0, start) + chip.dataset.insert + el.value.slice(end);
        el.focus();
        el.selectionStart = el.selectionEnd = start + chip.dataset.insert.length;
        renderWelcomePreview();
      });
    });

    function saveWelcome() {
      postJson('welcome', readWelcomeForm(), '✅ Welcome settings saved.');
    }

    async function testWelcome() {
      try {
        const res = await fetch(`/api/guilds/${guildId}/welcome/test`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(readWelcomeForm())
        });
        const data = await res.json().catch(() => ({}));
        showToast(res.ok ? '📨 Test welcome sent!' : `❌ ${data.error || 'Failed to send.'}`);
      } catch {
        showToast('❌ Failed to send.');
      }
    }

    renderHpPreview();
    renderOdds();
    renderWelcomePreview();
    loadJoinChart();

    // Deep link: /dashboard/:id#welcome opens that tab (used after saving from the Embed Builder).
    if (location.hash) showTab(location.hash.slice(1));

    async function saveLevels() {
      const enabled = document.getElementById('lvlEnabled').checked;
      const levelRoles = [...document.querySelectorAll('.level-role-row')].map((row) => ({
        level: row.querySelector('.lr-level').value,
        roleId: row.querySelector('.lr-role').value
      }));
      const payload = {
        enabled,
        levelRoles,
        xpMin: document.getElementById('xpMin').value,
        xpMax: document.getElementById('xpMax').value,
        xpCooldownSeconds: document.getElementById('xpCooldown').value,
        levelXpBase: document.getElementById('levelXpBase').value,
        levelUpChannelId: document.getElementById('levelUpChannel').value,
        rankCardBoosterOnly: document.getElementById('cardBoosterOnly').checked,
        xpMultipliers: [...document.querySelectorAll('.multiplier-row')].map((row) => ({
          type: row.querySelector('.mul-type').value,
          targetId: row.querySelector('.mul-target').value,
          multiplier: row.querySelector('.mul-value').value
        }))
      };
      const res = await fetch(`/api/guilds/${guildId}/levels`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      showToast(res.ok ? '✅ Leveling settings saved. Reload to see updated hierarchy warnings.' : '❌ Failed to save.');
    }

    // --- Auto-Role ---
    async function saveAutoRole() {
      const roleId = document.getElementById('arRole').value;
      const enabled = document.getElementById('arEnabled').checked;
      const res = await fetch(`/api/guilds/${guildId}/autorole`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ roleId, enabled })
      });
      showToast(res.ok ? '✅ Auto-role settings saved.' : '❌ Failed to save.');
    }

    async function syncAutoRole() {
      const resultEl = document.getElementById('arSyncResult');
      resultEl.textContent = 'Syncing… this can take a moment on larger servers.';
      try {
        const res = await fetch(`/api/guilds/${guildId}/autorole/sync`, { method: 'POST' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Sync failed.');
        resultEl.textContent = `✅ Granted the role to ${data.granted} member(s).${data.failed > 0 ? ` Failed for ${data.failed} (check hierarchy/permissions).` : ''}`;
      } catch (err) {
        resultEl.textContent = `❌ ${err.message}`;
      }
    }
  </script>
</body>
</html>
