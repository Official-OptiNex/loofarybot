            <div><div class="setting-title">Bet limits</div><div class="setting-help">Leave max blank for no limit.</div></div>
            <div class="setting-control">
              <input type="number" id="gMin" min="1" value="<%= gambling.minBet %>" placeholder="Min">
              <input type="number" id="gMax" min="1" value="<%= gambling.maxBet || '' %>" placeholder="Max">
            </div>
          </div>
          <div class="setting-row">
            <div><div class="setting-title">Allowed channel</div><div class="setting-help">Keep gambling out of general chat.</div></div>
            <div class="setting-control"><select id="gChannel"><%- channelOptions(gambling.channelId, 'Any channel') %></select></div>
          </div>
        </div>
        <div class="card">
          <h3 style="margin-top:0;">Payouts at this edge</h3>
          <table class="payout-table" id="gOdds"></table>
        </div>
      </div>
      <div class="savebar"><button class="btn" onclick="saveGambling()">Save changes</button></div>
    </div>

    <!-- LOGS -->
    <div class="tab-panel hidden" id="tab-logs">
      <div class="module-hero">
        <div class="hero-icon">📋</div>
        <div>
          <h1>Server Logs</h1>
          <p>Edits, deletes, joins, leaves, voice and role changes — kept for 30 days and searchable here.</p>
          <div class="hero-status"><%- channelName(config.logChannelId) ? chip('good', 'Also posting to ' + esc(channelName(config.logChannelId))) : chip('', 'Dashboard only (no Discord channel)') %></div>
        </div>
        <% if (can('logs')) { %><div class="hero-toggle"><span class="muted" style="font-size:0.85rem;">Enabled</span><%- moduleToggle('logs', config.logsEnabled !== false, null) %></div><% } %>
      </div>

      <div class="subtabs" data-subtabs>
        <button class="active" data-sub="lg-view">🔎 Log viewer</button>
        <% if (can('logs')) { %><button data-sub="lg-settings">⚙️ Settings</button><% } %>
      </div>

      <div class="subpage" data-page="lg-view">
        <div class="card">
          <div class="log-toolbar">
