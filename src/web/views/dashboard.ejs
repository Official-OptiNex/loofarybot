<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Select a Server | LoofaryBot</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>
  <nav>
    <div class="brand">🎁 LoofaryBot</div>
    <div class="nav-right">
      <span class="muted">Logged in as <strong><%= user.username %></strong></span>
      <a class="btn secondary" href="/auth/logout">Logout</a>
    </div>
  </nav>
  <div class="container">
    <div class="page-header">
      <h1>Your Servers</h1>
    </div>
    <p class="muted">Servers where LoofaryBot is present and you have Manage Server permission — or a dashboard moderator role — are shown.</p>

    <div class="stat-strip">
      <div class="stat-pill"><span class="value"><%= guilds.length %></span><span class="label">Manageable servers</span></div>
      <div class="stat-pill"><span class="value"><%= totalGuilds %></span><span class="label">Servers using LoofaryBot</span></div>
    </div>

    <% if (guilds.length === 0) { %>
      <div class="card">
        <p>No manageable servers found. Make sure LoofaryBot has been invited to your server and that you have
          Administrator or Manage Server permission there.</p>
      </div>
    <% } else { %>
      <div class="grid">
        <% guilds.forEach(g => { %>
          <a class="guild-card" href="/dashboard/<%= g.id %>">
            <div class="guild-card-top">
              <% if (g.icon) { %>
                <img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png">
              <% } else { %>
                <div class="guild-icon-fallback"><%= g.name.charAt(0).toUpperCase() %></div>
              <% } %>
              <div class="guild-card-name"><%= g.name %></div>
            </div>
            <div class="guild-card-stats">
              <span>👥 <%= g.memberCount %></span>
              <span>💬 <%= g.channelCount %></span>
              <% if (g.accessLevel === 'mod') { %><span class="badge boost">Moderator</span><% } %>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>
