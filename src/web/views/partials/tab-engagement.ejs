    <!-- ENGAGEMENT (same as /birthday · /counting · /starboard) -->
    <div class="tab-panel hidden" id="tab-engagement">
      <div class="module-hero">
        <div class="hero-icon">✨</div>
        <div>
          <h1>Engagement</h1>
          <p>Birthdays, a counting game, a starboard and the <code>/calculate</code> upgrade calculator. Once set up they run on their own. Same as <code>/birthday</code>, <code>/counting</code> and <code>/starboard</code>.</p>
          <div class="hero-status" id="enStatus"></div>
        </div>
      </div>

      <div class="subtabs" data-subtabs>
        <button class="active" data-sub="en-birthdays">🎂 Birthdays</button>
        <button data-sub="en-counting">🔢 Counting</button>
        <button data-sub="en-starboard">⭐ Starboard</button>
        <button data-sub="en-calculator">🧮 Calculator</button>
      </div>

      <!-- Birthdays -->
      <div class="subpage" data-page="en-birthdays">
        <div class="card warn-card" id="bdWarn" style="display:none;"></div>
        <div class="split">
          <div>
            <div class="card settings-card">
              <div class="setting-row">
                <div><div class="setting-title">Birthday posts</div><div class="setting-help">Once a day, LoofaryBot wishes everyone whose birthday it is. Members save theirs with <code>/birthday set</code>.</div></div>
                <div class="setting-control"><label class="switch"><input type="checkbox" id="bdEnabled"><span class="track"></span></label></div>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">Channel</div><div class="setting-help">Where the birthday wishes are posted.</div></div>
                <div class="setting-control"><select id="bdChannel"><%- channelOptions(null, '— Select a channel —') %></select></div>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">Post time</div><div class="setting-help">Hour of the day in UTC. <span id="bdLocalTime"></span></div></div>
                <div class="setting-control"><select id="bdHour"><% for (let h = 0; h < 24; h++) { %><option value="<%= h %>"><%= String(h).padStart(2, '0') %>:00 UTC</option><% } %></select></div>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">Birthday role</div><div class="setting-help">Optional. Given for the day and taken back 24 hours later.</div></div>
                <div class="setting-control">
                  <select id="bdRole">
                    <option value="">No role</option>
                    <% roles.filter(r => !r.managed).forEach(r => { %><option value="<%= r.id %>">@<%= r.name %><%= r.assignable ? '' : ' ⚠️ (bot cannot assign this)' %></option><% }) %>
                  </select>
                </div>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">XP gift</div><div class="setting-help">Extra XP on their birthday (0 = none). Needs leveling on.</div></div>
                <div class="setting-control"><input type="number" id="bdXp" min="0" max="100000" step="10"></div>
              </div>
              <div class="setting-row stack">
                <div><div class="setting-title">Message</div><div class="setting-help">Placeholders: <code>{users}</code> (everyone celebrating) <code>{count}</code> <code>{server}</code></div></div>
                <textarea id="bdMessage" rows="2" maxlength="1500"></textarea>
              </div>
            </div>
            <div class="savebar" style="position:static;"><button class="btn" id="bdSave" onclick="saveEngagement('birthdays')">Save birthdays</button></div>
          </div>

          <div class="sticky-preview">
            <div class="card" style="margin-bottom:0;">
              <h3 style="margin-top:0;">Preview</h3>
              <div class="discord-chat">
                <div class="discord-message-preview">
                  <img class="discord-avatar" src="<%= bot.avatarUrl %>" alt="">
                  <div class="discord-message-body">
                    <div class="discord-message-header"><span class="discord-bot-name"><%= bot.name %></span><span class="discord-bot-badge">BOT</span><span class="discord-message-time" id="bdpTime">Today at 14:00</span></div>
                    <div class="discord-embed-preview" style="border-left-color:#FF73FA; margin-top:0.4rem;"><div class="desc" id="bdpText"></div></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="card" style="margin-top:1rem;">
              <h3 style="margin-top:0;">Coming up <span class="muted" id="bdCount" style="font-size:0.8rem; font-weight:400;"></span></h3>
              <div id="bdUpcoming"><p class="muted">Loading…</p></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Counting -->
      <div class="subpage hidden" data-page="en-counting">
        <div class="split">
          <div>
            <div class="card settings-card">
              <div class="setting-row">
                <div><div class="setting-title">Counting game</div><div class="setting-help">Members count up one number at a time. Right numbers get ✅, a wrong one resets to 0.</div></div>
                <div class="setting-control"><label class="switch"><input type="checkbox" id="ctEnabled"><span class="track"></span></label></div>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">Channel</div><div class="setting-help">Use a channel just for counting. Normal chat in it is ignored.</div></div>
                <div class="setting-control"><select id="ctChannel"><%- channelOptions(null, '— Select a channel —') %></select></div>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">Take turns</div><div class="setting-help">Nobody can count twice in a row. A double count is just deleted — it doesn’t reset the run (griefers can’t abuse it).</div></div>
                <div class="setting-control"><label class="switch"><input type="checkbox" id="ctTurns"><span class="track"></span></label></div>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">Allow maths</div><div class="setting-help">Full maths counts: “3*4”→12, “3²”→9, “2(3)”→6, “5!”→120, “√144”→12, “∑(i,1,5,i)”→15. Whole-number results only — maths the bot can’t fully read (or a fraction) gets ❓ and never resets the run.</div></div>
                <div class="setting-control"><label class="switch"><input type="checkbox" id="ctMath"><span class="track"></span></label></div>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">Numbers only</div><div class="setting-help">Delete normal chat in the channel so it stays all numbers (staff are exempt). Wrong numbers still reset as usual.</div></div>
                <div class="setting-control"><label class="switch"><input type="checkbox" id="ctNumbersOnly"><span class="track"></span></label></div>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">Slowmode</div><div class="setting-help">Seconds each member must wait between messages — grief protection. <strong>Default 1200 (20 min)</strong>; 0 turns it off. Needs <em>Manage Channels</em>.</div></div>
                <div class="setting-control"><input type="number" id="ctSlowmode" min="0" max="21600"><span class="muted">sec</span></div>
              </div>
            </div>
            <div class="savebar" style="position:static;"><button class="btn" id="ctSave" onclick="saveEngagement('counting')">Save counting</button></div>

            <div class="card settings-card" style="margin-top:1rem;">
              <div class="setting-row">
                <div><div class="setting-title">🎯 Secret goals</div><div class="setting-help">Every few numbers, everyone who has counted in the current run gets XP. Members aren't told where the goals are — it's a surprise when one hits. A wrong number resets the run, who's in it, and the XP ladder. Same as <code>/counting goals</code>.</div></div>
                <div class="setting-control"><label class="switch"><input type="checkbox" id="cgEnabled"><span class="track"></span></label></div>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">A goal every</div><div class="setting-help">e.g. 15 → goals at 15, 30, 45…</div></div>
                <div class="setting-control"><input type="number" id="cgEvery" min="1" max="100000"><span class="muted">numbers</span></div>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">XP ladder</div><div class="setting-help">The first goal of a run pays the base; each later goal in the same run pays the step more (100, 150, 200…). Optional cap (0 = none) before bonuses.</div></div>
                <div class="setting-control">
                  <label class="muted" style="font-size:0.78rem;">Base <input type="number" id="cgBase" min="0" style="width:90px;"></label>
                  <label class="muted" style="font-size:0.78rem;">+ per goal <input type="number" id="cgStep" min="0" style="width:90px;"></label>
                  <label class="muted" style="font-size:0.78rem;">Cap <input type="number" id="cgMax" min="0" style="width:90px;"></label>
                </div>
              </div>
              <div class="setting-row stack">
                <div><div class="setting-title">Bonuses for big numbers</div><div class="setting-help">Big numbers are goals too, paying the ladder + a bonus — e.g. every 100 → +250, so 100, 200, 300… each pay the next ladder step plus 250 (on top of the regular goals every few numbers).</div></div>
                <div id="cgBonuses" style="display:flex; flex-direction:column; gap:0.4rem;"></div>
                <div><button type="button" class="btn secondary small" onclick="addGoalBonus()">+ Add bonus</button></div>
              </div>
              <div class="setting-row stack">
                <div><div class="setting-title">Announcement</div><div class="setting-help">Leave empty for the default. Placeholders: <code>{number}</code> <code>{xp}</code> <code>{base}</code> <code>{bonus}</code> <code>{bonusText}</code> <code>{people}</code> <code>{s}</code> <code>{goal}</code> (goal # this run) <code>{mentions}</code>.</div></div>
                <textarea id="cgMessage" rows="2" maxlength="1500" placeholder="🎯 **Secret goal reached at {number}!** {people} counter{s} this run just got **+{xp} XP** each{bonusText}. Keep going… the next one’s a surprise 🤫"></textarea>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">Ping the winners</div><div class="setting-help">@mention everyone rewarded (otherwise names show without a ping).</div></div>
                <div class="setting-control"><label class="switch"><input type="checkbox" id="cgPing"><span class="track"></span></label></div>
              </div>
              <div class="setting-row stack">
                <div class="setting-title">Ladder preview</div>
                <div class="muted" id="cgPreview" style="font-size:0.82rem;"></div>
              </div>
            </div>
            <div class="savebar" style="position:static;"><button class="btn" id="cgSave" onclick="saveCountingGoals()">Save goals</button></div>

            <div class="card settings-card" style="margin-top:1rem;">
              <div class="setting-row">
                <div><div class="setting-title">Set the count</div><div class="setting-help">Undo an unfair reset. Enter the last number counted; the channel is told the next one.</div></div>
                <div class="setting-control"><input type="number" id="ctSetTo" min="0" placeholder="e.g. 250"><button class="btn secondary" id="ctSetBtn" onclick="setCount()">Set</button></div>
              </div>
            </div>
          </div>
          <div class="sticky-preview">
            <div class="card" style="margin-bottom:0;">
              <h3 style="margin-top:0;">Right now</h3>
              <div class="mini-stats" id="ctStats" style="margin-bottom:0;"><p class="muted">Loading…</p></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Starboard -->
      <div class="subpage hidden" data-page="en-starboard">
        <div class="card warn-card" id="sbWarn" style="display:none;"></div>
        <div class="split">
          <div>
            <div class="card settings-card">
              <div class="setting-row">
                <div><div class="setting-title">Starboard</div><div class="setting-help">Messages that get enough reactions are reposted in the starboard channel, with a jump link. The count keeps updating.</div></div>
                <div class="setting-control"><label class="switch"><input type="checkbox" id="sbEnabled"><span class="track"></span></label></div>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">Starboard channel</div></div>
                <div class="setting-control"><select id="sbChannel"><%- channelOptions(null, '— Select a channel —') %></select></div>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">Stars needed</div><div class="setting-help">Posts drop off the board again if stars are removed below this.</div></div>
                <div class="setting-control"><input type="number" id="sbThreshold" min="1" max="100"></div>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">Emoji</div><div class="setting-help">The reaction that counts. Pick one, type any emoji, or paste one of this server's custom emoji.</div></div>
                <div class="setting-control">
                  <input id="sbEmoji" maxlength="64" placeholder="⭐" style="flex:0 0 90px; min-width:90px;">
                  <div class="chip-row" style="margin:0;">
                    <% ['⭐', '🌟', '🔥', '💀', '😂'].forEach(e => { %><button type="button" class="chip" data-sb-emoji="<%= e %>"><%= e %></button><% }) %>
                  </div>
                </div>
              </div>
              <div class="setting-row">
                <div><div class="setting-title">Self-stars count</div><div class="setting-help">Off: starring your own message doesn't count.</div></div>
                <div class="setting-control"><label class="switch"><input type="checkbox" id="sbSelf"><span class="track"></span></label></div>
              </div>
              <div class="setting-row stack">
                <div><div class="setting-title">Ignored channels</div><div class="setting-help">Messages here never go to the starboard (threads follow their channel).</div></div>
                <input type="search" id="sbIgnoreSearch" placeholder="Filter channels…" aria-label="Filter channels">
                <div class="check-grid" id="sbIgnored">
                  <% channels.forEach(c => { %><label class="check-pill" data-name="<%= c.name.toLowerCase() %>"><input type="checkbox" value="<%= c.id %>" class="sb-ignore"><span>#<%= c.name %></span></label><% }) %>
                </div>
              </div>
            </div>
            <div class="savebar" style="position:static;"><button class="btn" id="sbSave" onclick="saveEngagement('starboard')">Save starboard</button></div>
          </div>
          <div class="sticky-preview">
            <div class="card" style="margin-bottom:0;">
              <h3 style="margin-top:0;">Most starred</h3>
              <div id="sbTop"><p class="muted">Loading…</p></div>
            </div>
          </div>
        </div>
      </div>
      <!-- Calculator (/calculate) -->
      <div class="subpage hidden" data-page="en-calculator">
        <div class="card">
          <p class="muted" style="margin:0; font-size:0.86rem;">Everything <code>/calculate</code> uses: which calculators members see, their names and emoji, what one D costs, and the fish draw odds. Rarities go D → C → B → … → ZZZ, and 2 of a rarity merge into 1 of the next (a rarity is worth 2× the one below).</p>
        </div>
        <% [['pets', '🐾 Pets'], ['guns', '🔫 Guns']].forEach(([key, title]) => { %>
        <div class="card settings-card">
          <div class="setting-row">
            <div><div class="setting-title"><%= title %> calculator</div><div class="setting-help">Shown in the <code>/calculate</code> menu.</div></div>
            <div class="setting-control"><label class="switch"><input type="checkbox" id="calc-<%= key %>-enabled"><span class="track"></span></label></div>
          </div>
          <div class="setting-row">
            <div><div class="setting-title">Name</div><div class="setting-help">Emoji, singular and plural (e.g. 🐾 Pet / pets).</div></div>
            <div class="setting-control">
              <input id="calc-<%= key %>-emoji" maxlength="64" style="flex:0 0 64px; min-width:64px;">
              <input id="calc-<%= key %>-name" maxlength="32" placeholder="Singular">
              <input id="calc-<%= key %>-plural" maxlength="32" placeholder="Plural">
            </div>
          </div>
          <div class="setting-row">
            <div><div class="setting-title">Cost of one D</div><div class="setting-help">What one D (lowest rarity) summon costs.</div></div>
            <div class="setting-control"><input type="number" id="calc-<%= key %>-cost" min="0" step="any"></div>
          </div>
          <div class="setting-row">
            <div><div class="setting-title">Currencies</div><div class="setting-help">What it can be paid with, comma separated (shown as “X or Y”). Up to 5.</div></div>
            <div class="setting-control"><input id="calc-<%= key %>-currencies" maxlength="170" placeholder="Pet Gems, Diamonds"></div>
          </div>
        </div>
        <% }) %>
        <div class="card settings-card">
          <div class="setting-row">
            <div><div class="setting-title">🐟 Fish calculator</div><div class="setting-help">Fish come from random draws instead of summons, so results show best / average / worst luck.</div></div>
            <div class="setting-control"><label class="switch"><input type="checkbox" id="calc-fish-enabled"><span class="track"></span></label></div>
          </div>
          <div class="setting-row">
            <div><div class="setting-title">Name</div></div>
            <div class="setting-control">
              <input id="calc-fish-emoji" maxlength="64" style="flex:0 0 64px; min-width:64px;">
              <input id="calc-fish-name" maxlength="32" placeholder="Singular">
              <input id="calc-fish-plural" maxlength="32" placeholder="Plural">
            </div>
          </div>
          <div class="setting-row">
            <div><div class="setting-title">Free draws per day</div><div class="setting-help">0 hides the “free draws only” estimate.</div></div>
            <div class="setting-control"><input type="number" id="calc-fish-freePerDay" min="0" max="1000"></div>
          </div>
          <div class="setting-row">
            <div><div class="setting-title">Epic draw cost</div><div class="setting-help">Price of one epic draw, and its currency.</div></div>
            <div class="setting-control">
              <input type="number" id="calc-fish-epicCost" min="1" step="any">
              <input id="calc-fish-epicCurrency" maxlength="32" placeholder="Diamonds">
            </div>
          </div>
          <div class="setting-row stack">
            <div><div class="setting-title">Draw odds (%)</div><div class="setting-help">Chance of each rarity per draw. Each row must add up to 100%.</div></div>
            <div style="overflow-x:auto;">
              <table class="calc-odds-table" style="border-collapse:collapse; font-size:0.82rem;">
                <tr><th></th><% ['D','C','B','A','S','SS','SSS','X','XX','XXX','Z','ZZ','ZZZ'].forEach((t) => { %><th style="padding:0.2rem 0.3rem;"><%= t %></th><% }) %><th style="padding:0.2rem 0.5rem;">Total</th></tr>
                <% [['free', '🎣 Free'], ['epic', '💎 Epic']].forEach(([draw, label]) => { %>
                <tr>
                  <th style="text-align:left; padding-right:0.5rem; white-space:nowrap;"><%= label %></th>
                  <% for (let t = 0; t < 13; t++) { %><td style="padding:0.15rem;"><input type="number" class="calc-odds" data-draw="<%= draw %>" data-t="<%= t %>" min="0" max="100" step="any" style="width:58px; min-width:58px; padding:0.3rem;"></td><% } %>
                  <td style="padding:0.2rem 0.5rem; font-weight:600;" id="calc-<%= draw %>-total"></td>
                </tr>
                <% }) %>
              </table>
            </div>
            <div class="muted" style="font-size:0.8rem;" id="calc-fish-summary"></div>
          </div>
        </div>
        <div class="savebar" style="position:static;">
          <button class="btn secondary" type="button" onclick="resetCalculator()">↺ Defaults</button>
          <button class="btn" id="calcSave" type="button" onclick="saveCalculator()">Save calculator</button>
        </div>
      </div>
    </div>
