    <!-- GIVEAWAYS (same options as /loof start · drop · edit · requirements · end · reroll · delete) -->
    <style>
      .gwrp{position:relative;}
      .gwrp .tokens{display:flex;flex-wrap:wrap;gap:0.3rem;align-items:center;min-height:2.3rem;border:1px solid var(--border-color,#2a2d31);border-radius:8px;padding:0.3rem 0.4rem;background:var(--bg-elevated,#1a1d2b);cursor:text;}
      .gwrp .tok{display:inline-flex;align-items:center;gap:0.3rem;background:#4e5d94;color:#fff;border-radius:12px;padding:0.14rem 0.55rem;font-size:0.78rem;line-height:1.4;}
      .gwrp .tok button{background:none;border:0;color:#fff;cursor:pointer;font-size:0.95rem;line-height:1;padding:0;opacity:0.85;}
      .gwrp .tok button:hover{opacity:1;}
      .gwrp input.search{border:0;background:none;outline:none;flex:1;min-width:6rem;color:inherit;font:inherit;padding:0.2rem;}
      .gwrp .drop{position:absolute;z-index:40;left:0;right:0;top:100%;margin-top:2px;background:var(--bg-elevated,#1a1d2b);border:1px solid var(--border-strong,#353950);border-radius:8px;max-height:220px;overflow:auto;display:none;box-shadow:0 10px 30px rgba(0,0,0,.35);}
      .gwrp .drop.open{display:block;}
      .gwrp .opt{padding:0.45rem 0.6rem;cursor:pointer;font-size:0.85rem;}
      .gwrp .opt.active,.gwrp .opt:hover{background:var(--accent,#5865f2);color:#fff;}
      .gwrp .opt.none{opacity:0.6;cursor:default;}
      .gwrp.any .tok{background:#3ba55d;}
      .gwrp.all .tok{background:#4e5d94;}
      .gwrp.blocked .tok{background:#a3352f;}
    </style>
    <div class="tab-panel hidden" id="tab-giveaways">
      <div class="module-hero">
        <div class="hero-icon">🎁</div>
        <div>
          <h1>Giveaways</h1>
          <p>Start timed giveaways or first-to-click drops, then edit, end, reroll or delete them — the same as <code>/loof</code>.</p>
          <div class="hero-status" id="gwStatus"></div>
        </div>
        <div class="hero-toggle"><button class="btn" id="gwNewBtn" onclick="openGiveawayEditor()">+ New giveaway</button></div>
      </div>

      <div class="split">
        <div>
          <div class="list-toolbar">
            <div class="segmented" id="gwFilter" role="group" aria-label="Show">
              <button data-filter="running" class="active">Running</button>
              <button data-filter="ended">Ended</button>
            </div>
            <button class="btn secondary small" onclick="loadGiveaways()">↻ Refresh</button>
          </div>
          <div id="gwList"><div class="card empty-state">Loading…</div></div>

          <div class="card" id="gwEditor" style="display:none; margin-top:1.25rem;">
            <h3 style="margin-top:0;" id="gwEditorTitle">New giveaway</h3>
            <input type="hidden" id="gwId">
            <div class="radio-cards" id="gwTypeCards" style="margin-bottom:0.5rem;">
              <label class="radio-card"><input type="radio" name="gwType" value="timed" checked><span class="rc-body"><span class="rc-title">🎁 Timed giveaway</span><span class="rc-desc" style="display:block;">Members enter, winners are drawn at the end</span></span></label>
              <label class="radio-card"><input type="radio" name="gwType" value="drop"><span class="rc-body"><span class="rc-title">⚡ Drop</span><span class="rc-desc" style="display:block;">The first people to click win instantly</span></span></label>
            </div>
            <div class="setting-row" id="gwChannelRow">
              <div class="setting-title">Post in</div>
              <div class="setting-control"><select id="gwChannel"><%- channelOptions(null, '— Select a channel —') %></select></div>
            </div>
            <div class="setting-row">
              <div class="setting-title">Prize</div>
              <div class="setting-control"><input id="gwPrize" maxlength="256" placeholder="e.g. Discord Nitro (1 month)"></div>
            </div>
            <div class="setting-row">
              <div><div class="setting-title" id="gwDurationTitle">Duration</div><div class="setting-help" id="gwDurationHelp">e.g. 30m, 2h, 1d12h</div></div>
              <div class="setting-control">
                <input id="gwDuration" placeholder="1d" autocomplete="off">
                <div class="chip-row" style="margin:0; flex-basis:100%; justify-content:flex-end;">
                  <% ['10m', '1h', '12h', '1d', '3d', '7d'].forEach(d => { %><button type="button" class="chip" data-duration="<%= d %>"><%= d %></button><% }) %>
                </div>
              </div>
            </div>
            <div class="setting-row">
              <div><div class="setting-title" id="gwWinnersTitle">Winners</div><div class="setting-help" id="gwWinnersHelp">How many people win.</div></div>
              <div class="setting-control"><input type="number" id="gwWinners" min="1" max="100" value="1"></div>
            </div>
            <div class="setting-row" id="gwPingRow">
              <div><div class="setting-title">Ping</div><div class="setting-help">Sent above the giveaway when it's posted.</div></div>
              <div class="setting-control">
                <select id="gwPing">
                  <option value="">No ping</option>
                  <option value="everyone">@everyone</option>
                  <option value="here">@here</option>
                  <% roles.forEach(r => { %><option value="<%= r.id %>">@<%= r.name %></option><% }) %>
                </select>
              </div>
            </div>
            <div class="setting-row">
              <div><div class="setting-title">Look</div><div class="setting-help" id="gwLookHelp">Embed color and the entry button's emoji.</div></div>
              <div class="setting-control">
                <input type="color" id="gwColor" value="#5865F2" style="flex:0 0 64px; min-width:64px;" aria-label="Embed color">
                <input id="gwEmoji" maxlength="64" placeholder="🎉" style="flex:0 0 110px; min-width:110px;" aria-label="Button emoji">
              </div>
            </div>
            <div class="setting-row stack">
              <div><div class="setting-title">Description</div><div class="setting-help">Shown at the top of the giveaway embed.</div></div>
              <textarea id="gwDesc" rows="2" maxlength="1000" placeholder="Click the button below to enter!"></textarea>
            </div>
            <div class="setting-row">
              <div><div class="setting-title">Entry requirements</div><div class="setting-help">Optional. Entrants who stop qualifying are skipped at the draw.</div></div>
              <div class="setting-control" style="flex-direction:column; align-items:stretch; gap:0.6rem;">
                <div style="display:flex; gap:0.6rem; flex-wrap:wrap;">
                  <label style="flex:1; min-width:180px;"><div class="setting-help" style="margin-bottom:0.2rem;">Allowed — need <strong>any</strong></div>
                    <div id="gwReqAny" class="gwrp any" data-ph="Add a role…" aria-label="Allowed roles (any of)"></div></label>
                  <label style="flex:1; min-width:180px;"><div class="setting-help" style="margin-bottom:0.2rem;">Required — need <strong>all</strong></div>
                    <div id="gwReqAll" class="gwrp all" data-ph="Add a role…" aria-label="Required roles (all of)"></div></label>
                  <label style="flex:1; min-width:180px;"><div class="setting-help" style="margin-bottom:0.2rem;">Blocked — must <strong>not</strong> have</div>
                    <div id="gwReqBlocked" class="gwrp blocked" data-ph="Add a role…" aria-label="Blocked roles"></div></label>
                </div>
                <div style="display:flex; gap:0.6rem; align-items:center; flex-wrap:wrap;">
                  <input type="number" id="gwReqDays" min="0" placeholder="Min days" style="flex:0 0 110px; min-width:110px;" aria-label="Minimum days in server">
                  <input type="number" id="gwReqLevel" min="0" placeholder="Min level" style="flex:0 0 110px; min-width:110px;" aria-label="Minimum level">
                  <span class="setting-help">Click a role to add it, × to remove. Type to search.</span>
                </div>
              </div>
            </div>
            <div class="setting-row stack" id="gwBonusRow">
              <div><div class="setting-title">Bonus entries</div><div class="setting-help">Extra chances to win for members with these roles (their best bonus counts) — e.g. Boosters +2 means 3 tickets instead of 1. Timed giveaways only.</div></div>
              <div id="gwBonusRows"></div>
              <div><button class="btn secondary small" type="button" onclick="addBonusRow()">+ Add bonus role</button></div>
            </div>
            <div style="display:flex; gap:0.6rem; justify-content:flex-end; flex-wrap:wrap; margin-top:0.9rem;">
              <button class="btn secondary" onclick="closeGiveawayEditor()">Cancel</button>
              <button class="btn" id="gwSaveBtn" onclick="saveGiveaway()">Start giveaway</button>
            </div>
          </div>
        </div>

        <div class="sticky-preview">
          <div class="card" style="margin-bottom:0;">
            <h3 style="margin-top:0;">Preview</h3>
            <div class="discord-chat">
              <div class="channel-name" id="gwpChannel"># giveaways</div>
              <div class="discord-message-preview">
                <img class="discord-avatar" src="<%= bot.avatarUrl %>" alt="">
                <div class="discord-message-body">
                  <div class="discord-message-header"><span class="discord-bot-name"><%= bot.name %></span><span class="discord-bot-badge">BOT</span><span class="discord-message-time">Today at 12:00 PM</span></div>
                  <div class="desc" id="gwpPing"></div>
                  <div class="discord-embed-preview" id="gwpEmbed" style="margin-top:0.4rem;">
                    <div class="title" id="gwpTitle"></div>
                    <div class="desc" id="gwpDesc"></div>
                    <div class="embed-footer" id="gwpFooter"></div>
                  </div>
                  <div class="mock-buttons"><span class="mock-button" id="gwpButton"></span></div>
                </div>
              </div>
            </div>
            <p class="muted" style="font-size:0.78rem; margin:0.75rem 0 0;">When it ends, the embed switches to the winners and the bot congratulates them in the channel.</p>
          </div>
        </div>
      </div>
    <dialog id="gwEntrantsDialog" class="eb-dialog">
        <div class="eb-dialog-inner">
          <div class="list-toolbar" style="margin-bottom:0.6rem;">
            <h3 style="margin:0;" id="gwEntrantsTitle">Entrants</h3>
            <button class="btn secondary small" onclick="document.getElementById('gwEntrantsDialog').close()">Close</button>
          </div>
          <input type="search" id="gwEntrantsSearch" placeholder="Search entrants…" aria-label="Search entrants">
          <div class="muted" id="gwEntrantsSummary" style="font-size:0.82rem; margin:0.6rem 0;"></div>
          <div id="gwEntrantsList" class="entrant-list"></div>
        </div>
      </dialog>
    </div>
