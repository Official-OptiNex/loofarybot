# --- Preserved from original bot (do not rename) ---
TOKEN=your-discord-bot-token
CLIENT_ID=your-discord-application-id

# --- New: required for OAuth2 dashboard login ---
CLIENT_SECRET=your-discord-application-client-secret
REDIRECT_URI=https://your-app.onrender.com/auth/discord/callback

# --- New: session signing secret (any long random string) ---
SESSION_SECRET=change-this-to-a-long-random-string

# --- New: MongoDB Atlas free-tier connection string ---
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/loofarybot?retryWrites=true&w=majority
MONGODB_URI=your-mongodb-atlas-connection-string

# --- Optional: Render sets this automatically, defaults to 3000 locally ---
PORT=3000
